import("//testing/test.gni")

# Both test binaries are reached from //:gn_all (see patches/BUILD.gn.patch).

# Model and page-handler tests. Uses Chrome's unit test main so tests can use
# BrowserWithTestWindowTest and TestingProfile.
test("compass_unittests") {
  deps = [
    "//chrome/test:test_support_unit",
    "//compass/browser/arc_import:unit_tests",
    "//compass/browser/claude:unit_tests",
    "//compass/browser/native_messaging:unit_tests",
    "//compass/browser/prefs:unit_tests",
    "//compass/browser/shortcuts:unit_tests",
    "//compass/common:unit_tests",
    "//compass/browser/sidebar:unit_tests",
    "//compass/browser/sync:unit_tests",
    "//compass/browser/ui:unit_tests",
    "//compass/browser/window_sync:unit_tests",
    "//compass/components/sync:history_unit_tests",
    "//compass/components/sync:unit_tests",
  ]
  if (is_mac) {
    deps += [ "//compass/components/os_crypt:unit_tests" ]
  }
}

# Tests that run a real browser window (InProcessBrowserTest).
test("compass_browsertests") {
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  deps = [
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:browser_tests_runner",
    "//compass/browser/picture_in_picture:browser_tests",
    "//compass/browser/prefs:browser_tests",
    "//compass/browser/ui:browser_tests",
    "//compass/browser/web_store:browser_tests",
  ]
  if (is_mac) {
    # Headless runs don't take the user's focus.
    sources = [ "test/headless_no_activation_mac.mm" ]
    frameworks = [ "AppKit.framework" ]

    # Resources live in the framework bundle on mac, as for upstream
    # browser_tests.
    data_deps = [
      "//chrome",
      "//chrome:chrome_framework",
    ]
  } else {
    data_deps = [ "//chrome:packed_resources" ]
  }
}
