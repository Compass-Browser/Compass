declare_args() {
  # Apple Intelligence for the sidebar's small requests on the Mac
  # (docs/design/ai-sidebar.md, "On this device"): builds compass-on-device
  # into the app, which needs Xcode with the macOS 26 SDK or newer. Off, the
  # settings don't offer it.
  compass_on_device_model = is_mac
}
