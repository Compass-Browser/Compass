# Tests for Compass's changes to upstream extensions behaviour, made in
# chromium_src/extensions/.
source_set("unit_tests") {
  testonly = true
  sources = [ "manifest_v2_unittest.cc" ]
  deps = [
    "//base",
    "//chrome/browser/extensions:test_support",
    "//extensions/browser",
    "//extensions/common",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
