# Compass for Android, the native side (docs/design/android.md): the
# desktop's spaces model without its windows, and the JNI bridges the
# Kotlin shell (//compass/android) talks to. //chrome/browser links it on
# Android (patches/chrome-browser-BUILD.gn.patch).

assert(is_android)

group("android") {
  deps = [
    ":spaces",
    ":sync_bridge",
  ]
}

# The spaces model (SpacesAndroid) and its bridge. Compass sync
# (//compass/browser/sync) depends on it for COMPASS_SPACES.
source_set("spaces") {
  sources = [
    "spaces_android.cc",
    "spaces_android.h",
    "spaces_bridge.cc",
    "spaces_bridge.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/sidebar",
    "//url",
  ]
}

# The sync and pairing screen's bridge to CompassSyncService.
source_set("sync_bridge") {
  sources = [
    "sync_bridge.cc",
    "sync_bridge.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/sync",
  ]
}
