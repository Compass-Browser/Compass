# Compass for Android, the native side (docs/design/android.md): the
# desktop's spaces model without its windows, and the JNI bridges the
# Kotlin shell (//compass/android) talks to. //chrome/browser links it on
# Android (patches/chrome-browser-BUILD.gn.patch).

import("//components/on_device_translation/buildflags/features.gni")

assert(is_android)

group("android") {
  # Page translation (docs/design/translation.md, "Android"): the browser's
  # half, which chromium_src's binders and installer reach into, so public.
  public_deps = []
  if (enable_on_device_translation) {
    public_deps += [
      ":translate_messages",
      "//compass/browser/translate",
      "//compass/browser/translate:page_translator_host",
    ]
  }
  deps = [
    ":adblock_bridge",
    ":claude_bridge",
    ":claude_sidebar",
    ":copy_link_bridge",
    ":easel_bridge",
    ":extension_unlock_bridge",
    ":passwords_bridge",
    ":pip_bridge",
    ":reader",
    ":rooms_bridge",
    ":spaces",
    ":split_bridge",
    ":sync_bridge",
  ]
}

# The Claude chat's bridge, on the desktop's Claude client and tools, and
# the browser tools' view of Chrome's tab models (ClaudeTabsAndroid, which
# //chrome/browser's tab model headers come with: this links into it).
source_set("claude_bridge") {
  sources = [
    "claude_bridge.cc",
    "claude_bridge.h",
    "claude_tabs_android.cc",
    "claude_tabs_android.h",
  ]
  deps = [
    ":spaces",
    "//base",
    "//base:i18n",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/boosts",
    "//compass/browser/claude",
    "//compass/browser/claude:prefs",
    "//compass/browser/sidebar",
    "//compass/strings:compass_strings",
    "//components/download/public/common:public",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//components/prefs",
    "//components/send_tab_to_self",
    "//components/sync_device_info",
    "//content/public/browser",
    "//services/network/public/cpp",
    "//ui/base",
    "//url",
  ]
}

# Claude in the sidebar (docs/design/ai-sidebar.md; docs/design/android.md,
# P12): the desktop's services, over SpacesAndroid in place of SpaceService
# (//compass/browser/ui/claude/sidebar_spaces.h), and their bridge.
source_set("claude_sidebar") {
  sources = [
    "//compass/browser/ui/claude/link_folder_namer.cc",
    "//compass/browser/ui/claude/link_folder_namer.h",
    "//compass/browser/ui/claude/short_titler.cc",
    "//compass/browser/ui/claude/short_titler.h",
    "//compass/browser/ui/claude/sidebar_spaces.h",
    "//compass/browser/ui/claude/today_tidier.cc",
    "//compass/browser/ui/claude/today_tidier.h",
    "claude_sidebar_bridge.cc",
    "claude_sidebar_bridge.h",
  ]
  deps = [
    ":spaces",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/claude",
    "//compass/browser/claude:prefs",
    "//compass/browser/sidebar",
    "//components/keyed_service/core",
    "//components/prefs",

    # today_tidier.cc's messages.
    "//compass/strings:compass_strings",
    "//ui/base",
  ]
}

# The spaces model (SpacesAndroid) and its bridge. Compass sync
# (//compass/browser/sync) depends on it for COMPASS_SPACES.
source_set("spaces") {
  sources = [
    "profiles_bridge.cc",
    "spaces_android.cc",
    "spaces_android.h",
    "spaces_bridge.cc",
    "spaces_bridge.h",

    # The browser-wide list of every profile's spaces, the desktop's, here
    # over SpacesAndroid (docs/design/android.md, "Profiles").
    "//compass/browser/window_sync/space_directory.cc",
    "//compass/browser/window_sync/space_directory.h",
  ]

  # The archiver asks Chrome's tab models which tabs play sound (their
  # headers come with //chrome/browser, which this links into).
  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles/keep_alive",
    "//compass/android:jni_headers",
    "//compass/browser/easels:store",
    "//compass/browser/sidebar",
    "//compass/browser/ui/easels:titles",
    "//content/public/browser",
    "//url",
  ]
}

# The sync and pairing screen's bridge to CompassSyncService.
source_set("sync_bridge") {
  sources = [
    "sync_bridge.cc",
    "sync_bridge.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/sync",
    "//compass/browser/sync:settings",
    "//compass/components/sync:notifier",
    "//url",
  ]
}

# Sharing with other people: the share sheet and join screen's bridge to
# RoomService (docs/design/sync.md, "Rooms: clients").
source_set("rooms_bridge") {
  sources = [
    "rooms_bridge.cc",
    "rooms_bridge.h",
  ]
  deps = [
    ":spaces",
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/easels:store",
    "//compass/browser/rooms",
    "//compass/browser/sidebar",
    "//compass/components/sync/rooms:client",
    "//compass/strings:compass_strings",
    "//ui/base",
  ]
}

# The saved passwords for the autofill picker (other apps' forms).
source_set("passwords_bridge") {
  sources = [
    "passwords_bridge.cc",
    "passwords_bridge.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//components/keyed_service/core",
    "//components/password_manager/core/browser/password_store:password_store_interface",
  ]
}

# Unlocking an extension (1Password) with biometrics: its script in the
# extension's pages (docs/design/android.md, "Extensions").
source_set("extension_unlock_bridge") {
  sources = [ "extension_unlock_bridge.cc" ]
  deps = [
    "//base",
    "//chrome/common",
    "//compass/android:jni_headers",
    "//content/public/browser",
  ]
}

# A split's borrowed page back in its tab (docs/design/android.md, "Splits").
source_set("split_bridge") {
  sources = [ "split_bridge.cc" ]
  deps = [
    "//base",
    "//cc/slim",
    "//compass/android:jni_headers",
    "//content/public/browser",
    "//ui/android",
  ]
}

# The ad blocker's switch and lists for the settings' Ad Blocker page
# (docs/design/ad-blocker.md).
source_set("adblock_bridge") {
  sources = [ "adblock_bridge.cc" ]
  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//compass/android:jni_headers",
    "//compass/browser/adblock:prefs",
    "//compass/browser/adblock:service",
    "//compass/strings:compass_strings",
    "//components/prefs",
    "//ui/base",
  ]
}

# Copy URL without tracking parameters (docs/design/shortcuts.md, "Clean
# links").
source_set("copy_link_bridge") {
  sources = [ "copy_link_bridge.cc" ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/prefs",
    "//compass/common:url",
    "//components/prefs",
    "//url",
  ]
}

# Auto picture-in-picture when Compass is left for another app
# (docs/design/android.md, "Auto picture-in-picture").
source_set("pip_bridge") {
  sources = [ "pip_bridge.cc" ]
  deps = [
    "//base",
    "//chrome/browser/picture_in_picture",
    "//compass/android:jni_headers",
    "//content/public/browser",
  ]
}

# Reader mode (docs/design/android.md, "Reader mode"): the desktop's reader
# page (chrome-untrusted://compass-reader, registered on Android by the
# chrome_web_ui_configs.cc patch) and scripts, and their bridge. Also
# Compass's other WebUI on Android, chrome://easel (docs/design/easels.md),
# and its Mojo interface (the chromium_src override of
# chrome_browser_interface_binders_webui_parts_android.cc).
source_set("reader") {
  sources = [
    "//compass/browser/ui/webui/reader/reader_untrusted_ui.cc",
    "//compass/browser/ui/webui/reader/reader_untrusted_ui.h",
    "android_web_ui_configs.cc",
    "android_web_ui_configs.h",
    "reader_bridge.cc",
  ]
  deps = [
    "//base",
    "//chrome/common",
    "//compass/android:jni_headers",
    "//compass/browser/reader:assets",
    "//compass/browser/ui/webui/easel",
    "//compass/strings:compass_strings",
    "//content/public/browser",
    "//content/public/common",
    "//services/network/public/mojom",
    "//ui/base",
    "//ui/webui",
    "//url",
  ]
}

# New Easel and Capture to Easel (docs/design/android.md, "Easels"): the
# desktop's capture code over SpacesAndroid. Refresh is the desktop's only
# (//compass/browser/ui/easels:refresh says so here).
source_set("easel_bridge") {
  sources = [ "easel_bridge.cc" ]
  deps = [
    ":spaces",
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/easels:store",
    "//compass/browser/sidebar",
    "//compass/browser/ui/easels:core",
    "//compass/browser/ui/easels:refresh",
    "//compass/browser/ui/easels:titles",
    "//compass/strings:compass_strings",
    "//content/public/browser",
    "//ui/base",
    "//url",
  ]
}

if (enable_on_device_translation) {
  # Page translation's question and download progress, as Chrome's
  # messages (translate_messages.cc).
  source_set("translate_messages") {
    sources = [ "translate_messages.cc" ]
    deps = [
      "//base",
      "//base:i18n",
      "//chrome/browser/translate",
      "//compass/browser/translate:page_translator_host",
      "//compass/strings:compass_strings",
      "//components/messages/android",
      "//content/public/browser",
      "//ui/android",
      "//ui/base",
    ]
  }
}
