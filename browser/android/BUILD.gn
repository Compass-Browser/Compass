# Compass for Android, the native side (docs/design/android.md): the
# desktop's spaces model without its windows, and the JNI bridges the
# Kotlin shell (//compass/android) talks to. //chrome/browser links it on
# Android (patches/chrome-browser-BUILD.gn.patch).

assert(is_android)

group("android") {
  deps = [
    ":claude_bridge",
    ":passwords_bridge",
    ":spaces",
    ":sync_bridge",
  ]
}

# The Claude chat's bridge, on the desktop's Claude client and tools, and
# the browser tools' view of Chrome's tab models (ClaudeTabsAndroid, which
# //chrome/browser's tab model headers come with: this links into it).
source_set("claude_bridge") {
  sources = [
    "claude_bridge.cc",
    "claude_bridge.h",
    "claude_tabs_android.cc",
    "claude_tabs_android.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/prefs",
    "//compass/android:jni_headers",
    "//compass/browser/claude",
    "//compass/browser/claude:prefs",
    "//content/public/browser",
    "//services/network/public/cpp",
    "//url",
  ]
}

# The spaces model (SpacesAndroid) and its bridge. Compass sync
# (//compass/browser/sync) depends on it for COMPASS_SPACES.
source_set("spaces") {
  sources = [
    "spaces_android.cc",
    "spaces_android.h",
    "spaces_bridge.cc",
    "spaces_bridge.h",
  ]
  # The archiver asks Chrome's tab models which tabs play sound (their
  # headers come with //chrome/browser, which this links into).
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/sidebar",
    "//content/public/browser",
    "//url",
  ]
}

# The sync and pairing screen's bridge to CompassSyncService.
source_set("sync_bridge") {
  sources = [
    "sync_bridge.cc",
    "sync_bridge.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/android:jni_headers",
    "//compass/browser/sync",
  ]
}

# The saved passwords for the autofill picker (other apps' forms).
source_set("passwords_bridge") {
  sources = [
    "passwords_bridge.cc",
    "passwords_bridge.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//components/password_manager/core/browser/password_store:password_store_interface",
    "//compass/android:jni_headers",
  ]
}
