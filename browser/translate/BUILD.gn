  deps = [
    ":models_json",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/common:constants",
    "//components/on_device_translation:public",
    "//components/prefs",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/zstd:decompress",
    "//url",
  ]
}

# Finds libcompass_translatekit and points upstream's service at it.
source_set("translatekit_library") {
  sources = [
    "translatekit_library.cc",
    "translatekit_library.h",
  ]
  deps = [
    "//base",
    "//components/on_device_translation:features",
  ]
}

