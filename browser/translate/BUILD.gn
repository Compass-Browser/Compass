import("//components/on_device_translation/buildflags/features.gni")

# On-device page translation (docs/design/translation.md).

assert(enable_on_device_translation)

# browser/translate/models.json, the models Compass downloads, as
# kModelsJson in models_json.h (tools/translation/update_models.py writes it).
action("models_json") {
  script = "//compass/build/embed_text.py"
  inputs = [ "models.json" ]
  outputs = [ "$target_gen_dir/models_json.h" ]
  args = [
    "--out",
    rebase_path(outputs[0], root_build_dir),
    "--namespace",
    "compass::translate",
    "kModelsJson=" + rebase_path(inputs[0], root_build_dir),
  ]
}

# common/translate/'s scripts as kPageTranslatorJs and kDesktopServiceJs
# in page_translate_scripts.h.
action("page_translate_scripts") {
  script = "//compass/build/embed_text.py"
  inputs = [
    "//compass/common/translate/page_translator.js",
    "//compass/common/translate/desktop_service.js",
  ]
  outputs = [ "$target_gen_dir/page_translate_scripts.h" ]
  args = [
    "--out",
    rebase_path(outputs[0], root_build_dir),
    "--namespace",
    "compass::translate",
    "kPageTranslatorJs=" + rebase_path(inputs[0], root_build_dir),
    "kDesktopServiceJs=" + rebase_path(inputs[1], root_build_dir),
  ]
}

# What upstream's page translation calls into: its script, its languages,
# turning it on (page_translation.h).
source_set("page_translation") {
  sources = [
    "page_translation.cc",
    "page_translation.h",
  ]
  deps = [
    ":page_translate_scripts",
    "//base",
    "//components/on_device_translation:public",
    "//components/translate/core/browser",
  ]
}

# Where a tab's translation is, for the pill (translation_tab_state.h).
source_set("tab_state") {
  sources = [
    "translation_tab_state.cc",
    "translation_tab_state.h",
  ]
  public_deps = [
    "//components/translate/content/browser",
    "//components/translate/core/browser",
    "//content/public/browser",
  ]
  deps = [
    "//base",
    "//chrome/browser/translate",
  ]
}

# The browser's end of compassTranslate (page_translator_host.h).
source_set("page_translator_host") {
  sources = [
    "page_translator_host.cc",
    "page_translator_host.h",
  ]
  public_deps = [
    "//compass/common/translate:mojom",
    "//components/on_device_translation/public/mojom",
    "//content/public/browser",
  ]
  deps = [
    ":page_translation",
    ":tab_state",
    ":translate",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/on_device_translation",
    "//compass/components/translatekit:html_marker",
    "//components/on_device_translation",
    "//components/on_device_translation:public",
    "//components/prefs",
    "//mojo/public/cpp/bindings",
    "//url",
  ]
}

# Language packs, installed for upstream's service.
source_set("translate") {
  sources = [
    "language_pack_installer_shim.cc",
    "language_pack_installer_shim.h",
    "translation_manifest.cc",
    "translation_manifest.h",
