# The user's shortcuts (docs/design/shortcuts.md "Customizing"). Its own
# target, depending on little of Chrome's, because upstream's prefs
# registration and macOS shortcut tables reach it (see patches/).
source_set("shortcuts") {
  sources = [
    "shortcut_settings.cc",
    "shortcut_settings.h",
  ]
  public_deps = [
    "//base",
    "//components/prefs",
    "//ui/base",
  ]
  deps = [
    "//chrome/browser:browser_process",
    "//ui/events:events_base",
  ]
  if (is_win) {
    # Compass's shortcuts and the user's in upstream's accelerator table,
    # which calls in (see patches/).
    sources += [
      "shortcuts_win.cc",
      "shortcuts_win.h",
    ]
    deps += [
      "//chrome/app:command_ids",
      "//compass/browser/ui:app_menu_hooks",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "shortcut_settings_unittest.cc" ]
  deps = [
    ":shortcuts",
    "//base",
    "//components/prefs:test_support",
    "//testing/gtest",
    "//ui/base",
    "//ui/events:events_base",
  ]
}
