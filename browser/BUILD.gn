# Everything Compass adds to the browser process. //chrome/browser depends on
# this target (see patches/chrome-browser-BUILD.gn.patch).
group("browser") {
  public_deps = [
    "//compass/browser/shortcuts",
    "//compass/browser/sidebar",
  ]
  if (is_mac) {
    public_deps += [ "//compass/browser/updates" ]
  }
}

# Compass's feature defaults. //chrome/browser:core, which sets up the
# feature list, depends on this target (see
# patches/chrome-browser-BUILD.gn.patch).
source_set("feature_overrides") {
  sources = [
    "feature_overrides.cc",
    "feature_overrides.h",
  ]
  deps = [
    "//build:buildflag_header_h",
    "//chrome/browser/ui:ui_features",
    "//chrome/common:chrome_features",
    "//components/autofill/core/common:features",
    "//components/network_time",
    "//components/omnibox/browser:aim_eligibility_service_features",
    "//components/signin/public/base:signin_switches",
    "//components/variations",
    "//third_party/blink/public/common",
  ]
}

# compass:// loads chrome:// pages. //chrome/browser:core, which sets up the
# browser's URL handlers, depends on this target (see
# patches/chrome-browser-BUILD.gn.patch).
source_set("url_handler") {
  sources = [
    "compass_url_handler.cc",
    "compass_url_handler.h",
  ]
  deps = [
    "//compass/common:url",
    "//content/public/browser",
    "//url",
  ]
}
