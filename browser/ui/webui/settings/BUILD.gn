# The hook chrome://settings includes (settings_sections.h); the
# implementation is part of //compass/browser/ui, which can't be a dependency
# of //chrome/browser/ui/webui/settings (it depends on //chrome/browser/ui).
source_set("sections") {
  sources = [ "settings_sections.h" ]
  public_deps = [
    "//compass/browser/ui/webui/sidebar:mojo_bindings",
    "//compass/browser/ui/webui/sync:mojo_bindings",
    "//mojo/public/cpp/bindings",
  ]
}
