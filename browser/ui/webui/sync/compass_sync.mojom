module compass.sync.mojom;

// See compass::sync::SyncState.
enum State {
  kOff,
  kNeedsRestart,
  kStarting,
  kOn,
  kError,
};

struct Status {
  State state;
  string server_url;
  string message;
};

// See compass::sync::PairingStep.
enum PairingStep {
  kNone,
  kWorking,
  kShowingCode,
  kConfirm,
  kWaitingForApproval,
  kDone,
  kFailed,
};

struct Pairing {
  PairingStep step;
  string code;
  string device_name;
  string message;
};

// Slice 5: joining on a device that has other profiles maps them to the
// chain's (docs/design/sync.md, "Slice 5 notes"). See
// compass::sync::ProfileMappingStatus.
struct ChainProfile {
  string uuid;
  string name;
  // The joining profile takes the home one.
  bool home;
};

struct LocalProfile {
  // Its directory's name.
  string id;
  string name;
};

struct ProfileMappingEntry {
  string local_id;
  // A ChainProfile's uuid, or empty: a new profile of the chain.
  string chain_uuid;
};

struct ProfileMapping {
  // Whether the join waits for SetProfileMapping().
  bool needed;
  array<ChainProfile> chain;
  array<LocalProfile> local;
  // Same name, else new.
  array<ProfileMappingEntry> proposed;
};

// Bootstraps the connection; called once by the page.
interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Browser-side handler for chrome://compass-sync (docs/design/sync.md, "UI",
// slice 2: the minimal page).
interface PageHandler {
  GetState() => (Status status, Pairing pairing);

  // Off.
  // Makes a chain; |words| is the recovery code, shown once.
  StartSync(string server_url) => (bool ok, string error, array<string> words);
  JoinWithRecoveryCode(string server_url, string words)
      => (bool ok, string error);
  // Progress comes through Page.OnStateChanged().
  JoinWithPairingCode(string server_url, string code);

  // On.
  AddDevice();
  AnswerPairing(bool allow);
  CancelPairing();
  Leave();

  Restart();

  // Slice 5. Changes come through Page.OnStateChanged().
  GetProfileMapping() => (ProfileMapping mapping);
  // One entry per LocalProfile of GetProfileMapping().
  SetProfileMapping(array<ProfileMappingEntry> mapping)
      => (bool ok, string error);
};

// Implemented by the page.
interface Page {
  OnStateChanged(Status status, Pairing pairing);
};
