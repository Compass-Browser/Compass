module compass.sync.mojom;

// See compass::sync::SyncState.
enum State {
  kOff,
  kNeedsRestart,
  kStarting,
  kOn,
  kError,
  kLoginRequired,
};

// The server's optional company sign-in; see compass::sync::SyncLogin.
struct Login {
  // The server asks chains to sign in, with this provider ("Acme SSO";
  // may be empty).
  bool server_requires;
  string provider_name;
  // Signed in as (empty if not, or not known).
  string user_name;
  string user_email;
  // A sign-in runs: the server's page shows |user_code|.
  bool in_progress;
  string user_code;
};

struct Status {
  State state;
  string server_url;
  string message;
  // The app menu's sync row for this state ("Synced"...): the page shows it
  // in <html data-menu-label>, so the end-to-end steps can check the row's
  // text without opening a native menu.
  string menu_label;
  // The server removed this device from the chain on another device: the
  // page offers only leaving (docs/design/sync.md, "Removing a device").
  bool device_removed;
  // Starting has taken long on one step: the page offers a restart next to
  // the message.
  bool offer_restart;
  Login login;
  // Off: while a server is being set up on Cloudflare, what's happening
  // ("Uploading the sync server…"). Empty otherwise.
  string server_setup;
};

// See compass::sync::PairingStep.
enum PairingStep {
  kNone,
  kWorking,
  kShowingCode,
  kConfirm,
  kWaitingForApproval,
  kDone,
  kFailed,
};

struct Pairing {
  PairingStep step;
  string code;
  string device_name;
  string message;
  // While A shows the code (kShowingCode): the invite a phone scans,
  // "compass-pair:?server=<server URL>&code=<code>" (docs/design/ios.md),
  // and its QR code, |qr_size| x |qr_size| modules, row by row, 1 = dark.
  // Empty otherwise.
  string invite_url;
  array<uint8> qr;
  int32 qr_size;
  // While A shows the code: when it expires, in ms since the Unix epoch
  // (the page counts down to it). 0 otherwise.
  double expires_at_ms;
};

// The page's switches; see compass::sync::SyncDataType.
enum DataType {
  kPasswords,
  kHistory,
  kBookmarks,
  kAutofill,
  kExtensions,
  kSettings,
  kReadingList,
  kOpenTabs,
  kSpaces,
};

struct DataTypeState {
  DataType type;
  bool enabled;
};

// A device of the chain, from DEVICE_INFO.
struct Device {
  // Its cache GUID, for RemoveDevice().
  string guid;
  string name;
  // "Mac", "Windows PC", "iPhone"...
  string kind;
  // When it last said it's alive, in ms since the Unix epoch (JS time);
  // 0 if unknown.
  double last_seen_ms;
  bool this_device;
};

// What the page shows beside the status.
struct Details {
  // Empty unless sync runs.
  array<Device> devices;
  // In the page's order.
  array<DataTypeState> types;
};

// Joining on a device that has other profiles maps them to the chain's
// (docs/design/sync.md, "Profiles"). See
// compass::sync::ProfileMappingStatus.
struct ChainProfile {
  string uuid;
  string name;
  // The joining profile takes the home one.
  bool home;
};

struct LocalProfile {
  // Its directory's name.
  string id;
  string name;
};

struct ProfileMappingEntry {
  string local_id;
  // A ChainProfile's uuid, or empty: a new profile of the chain.
  string chain_uuid;
};

struct ProfileMapping {
  // Whether the join waits for SetProfileMapping().
  bool needed;
  array<ChainProfile> chain;
  array<LocalProfile> local;
  // Same name, else new.
  array<ProfileMappingEntry> proposed;
};

// The server's access list (docs/design/sync.md, "Inviting friends").
struct ServerMember {
  // Their chain ID, for RemoveFromServer().
  string chain;
  string name;
  // ms since the Unix epoch.
  double added_ms;
  // Their profiles linked to it.
  int32 linked;
};

struct ServerInvite {
  // For RemoveFromServer() (revokes it).
  string code;
  string name;
  double expires_ms;
};

struct ServerPeople {
  // False unless the server has an access list this chain owns.
  bool available;
  array<ServerMember> members;
  array<ServerInvite> invites;
  // Phone notifications through the Compass push relay (docs/design/
  // sync.md, "Push on a Cloudflare server"): whether the server has the
  // setting (version 3 on), whether it's on, and the relay's host (empty:
  // push is off on the server for good).
  bool push_relay_available;
  bool push_relay;
  string push_relay_host;
};

// A newer server Compass can install (docs/design/sync.md, "Updating a
// server").
struct ServerUpdate {
  bool available;
  int32 current;
  int32 latest;
};

// Bootstraps the connection; called once by the page.
interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Browser-side handler for chrome://compass-sync (docs/design/sync.md, "UI").
interface PageHandler {
  GetState() => (Status status, Pairing pairing, Details details);

  // Off.
  // Makes a chain; |words| is the recovery code, shown once.
  StartSync(string server_url) => (bool ok, string error, array<string> words);
  // Sets up the user's own server in their Cloudflare account with
  // |token| (an API token that can edit Workers) and starts a chain on it,
  // as StartSync(). Progress shows in Status.server_setup. |push_relay|:
  // phone notifications through the Compass push relay, which the owner
  // can change later (ServerPeople.push_relay).
  StartOnCloudflare(string token, bool push_relay)
      => (bool ok, string error, array<string> words);
  // As StartOnCloudflare(), signing in to Cloudflare in a new tab.
  StartOnCloudflareSignIn(bool push_relay)
      => (bool ok, string error, array<string> words);
  // Joins the server of an invite link with a new chain, then starts it
  // as StartSync().
  JoinWithInvite(string link)
      => (bool ok, string error, array<string> words);
  JoinWithRecoveryCode(string server_url, string words)
      => (bool ok, string error);
  // Progress comes through Page.OnStateChanged().
  JoinWithPairingCode(string server_url, string code);

  // On.
  AddDevice();
  AnswerPairing(bool allow);
  CancelPairing();
  Leave();
  // Removes another device of the chain (Device.guid); not this one.
  RemoveDevice(string guid) => (bool ok, string error);
  // kLoginRequired: signs the chain in, in a tab (again while one runs:
  // opens its page again). Progress comes through Page.OnStateChanged().
  StartLogin();
  // Ends a sign-in that runs; a StartSync() or JoinWithRecoveryCode()
  // waiting for it then fails.
  CancelLogin();
  SetDataTypeEnabled(DataType type, bool enabled);
  // Asks the user to authenticate (Touch ID or the Mac's password) first;
  // |ok| false and empty |words| if they don't.
  RevealRecoveryCode() => (bool ok, string error, array<string> words);
  // A new chain: new seed, this device's data uploaded again after a
  // restart, the other devices join again. |words| is the new recovery code.
  ResetSync() => (bool ok, string error, array<string> words);

  Restart();

  // On: who may use the server, if this chain owns it.
  GetServerPeople() => (ServerPeople people);
  // On, owner: a single-use invite; |link| is what to send.
  InviteFriend(string name) => (bool ok, string error, string link);
  // On: whether the server can be updated.
  GetServerUpdate() => (ServerUpdate update);
  // On: updates it with |token| (a Cloudflare API token), or after
  // "Sign in with Cloudflare" when it's empty. Progress shows in
  // Status.server_setup.
  UpdateServer(string token) => (bool ok, string error);
  // On, owner: a friend's chain ID or an invite's code.
  RemoveFromServer(string target) => (bool ok, string error);
  // On, owner: phone notifications through the push relay on or off.
  SetServerPushRelay(bool on) => (bool ok, string error);

  // Slice 5. Changes come through Page.OnStateChanged().
  GetProfileMapping() => (ProfileMapping mapping);
  // One entry per LocalProfile of GetProfileMapping().
  SetProfileMapping(array<ProfileMappingEntry> mapping)
      => (bool ok, string error);
};

// Implemented by the page.
interface Page {
  OnStateChanged(Status status, Pairing pairing, Details details);
};
