# Compass's localized strings for its WebUI pages, by area
# (localized_strings/localized_strings.h). Only tables of message IDs, so
# Android's chrome://easel can use it too.
source_set("localized_strings") {
  sources = [
    "localized_strings/common_strings.cc",
    "localized_strings/easel_strings.cc",
    "localized_strings/localized_strings.h",
    "localized_strings/settings_sections_strings.cc",
    "localized_strings/settings_window_strings.cc",
    "localized_strings/sidebar_strings.cc",
  ]
  deps = [
    "//compass/strings:compass_strings",
    "//content/public/browser",
    "//ui/base",
  ]
}
