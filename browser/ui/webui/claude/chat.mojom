module compass.claude.chat.mojom;

// What the panel needs to know of the settings.
struct Setup {
  // The chat can send: the provider is set up (a key, or an
  // OpenAI-compatible server's URL), or the chat runs on Claude Code.
  bool has_key;
  // Claude Code mode (docs/design/claude.md, D8; Anthropic only): Claude
  // Code runs the tools and the loop, and the page only shows them
  // (OnToolResult()).
  bool claude_code;
  // Who answers (ProviderId(): "anthropic", "openai", "gemini",
  // "compatible"), for the model menu's known models.
  string provider;
  string model;
  bool browser_scope;
};

// The tab the chat is about, or the one Claude is acting on.
struct ActivePage {
  string url;
  string title;
  // Claude may read it (a web page, not one of the browser's own).
  bool readable;
};

struct PageText {
  string url;
  string title;
  string text;
  bool truncated;
};

// Bootstraps the connection; called once by the page.
// The user's answer to a tool that asks first (docs/design/claude.md,
// "Files").
enum ApprovalDecision {
  kDeny,
  kAllow,
  // This tool, without asking again, until New chat.
  kAllowForChat,
};

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Browser side of chrome://compass-claude, the chat panel
// (compass::ClaudePanel). See docs/design/claude.md, "Chat panel".
interface PageHandler {
  // The page is ready to be shown.
  ShowUI();
  GetSetup() => (Setup setup);
  GetActivePage() => (ActivePage page);
  // The active tab's text, or why it can't be read.
  ReadActivePage() => (PageText? page, string error);
  // Streams the next reply to |messages_json|, the Messages API's
  // "messages" array, as Page.OnStreamEvent() calls and one
  // Page.OnStreamDone(). The browser sets the model, the system prompt and
  // the rest of the request. A Send while a reply streams replaces it.
  // In Claude Code mode only the last (user) message goes, to Claude Code,
  // which keeps the conversation; a single message starts a new one. The
  // reply's events then span all its steps: each step's message_start, its
  // tools' results (Page.OnToolResult()), up to one OnStreamDone.
  Send(string messages_json);
  // What the browser says about itself at the start of a user message
  // (date, permission, the window's tabs), as a <context> element. The page
  // keeps it in the message: earlier messages must never change.
  GetContext() => (string text);
  // The user sent a message: Claude's tools act on the active tab from now
  // on, until the next message, even if the user switches tabs.
  StartTask();
  // Runs one of Claude's tools (common/claude/tools.json) on the task's
  // tab. |input_json| is the tool_use's input; |result_json| is
  // {"content": [blocks], "is_error": bool}, the tool_result's, and for a
  // memory tool that changed something "memory": {"kind", "text", "undo"}
  // (UndoMemory()), and for a Boost tool that did "boost": {"kind" (saved,
  // updated, deleted), "text" (its match), "undo"} (UndoBoost()), which
  // aren't part of the tool_result.
  RunTool(string name, string input_json) => (string result_json);
  // Stops the reply and any tool; no OnStreamDone follows.
  Stop();
  OpenSettings();
  // The header's model menu: sets the model, as Claude settings do (empty
  // for the default). The conversation goes on with it.
  SetModel(string model);
  // A link in a reply: opens in a new tab (http and https only).
  OpenLink(string url);
  ClosePanel();
  // A question asked from the command bar before the page connected, once;
  // empty if none. Later ones come as Page.OnAsk(). With an |answer| it's
  // the command bar's "Continue in Chat" instead: a new chat that starts
  // with |text| (|context|, the page line sent with it, before it in the
  // message) and |answer|, as Page.OnContinue() would.
  TakeQuestion() => (string text, string context, string answer);
  // Undoes what a memory tool did: |undo_id| is its result's "memory.undo".
  // False if it can't (already undone, or the memory changed since).
  UndoMemory(int32 undo_id) => (bool undone);
  // Undoes what a Boost tool did: |undo_id| is its result's "boost.undo".
  // False if it can't (already undone, the list full).
  UndoBoost(int32 undo_id) => (bool undone);

  // Answers OnApproval(|id|).
  AnswerApproval(int32 id, ApprovalDecision decision);
};

// Implemented by the page.
interface Page {
  // An event of the streamed reply: |name| ("content_block_delta", ...)
  // and its JSON |data|.
  OnStreamEvent(string name, string data);
  // The reply ended; |error| is empty when it completed.
  OnStreamDone(string error);
  // Claude Code mode: Claude Code ran a tool of the reply. |result_json| is
  // as RunTool()'s.
  OnToolResult(string tool_use_id, string result_json);
  OnSetupChanged(Setup setup);
  OnActivePageChanged(ActivePage page);
  // The command bar's "Ask Claude": send |text|, with the page attached.
  OnAsk(string text);
  // The command bar's "Continue in Chat": a new chat whose first exchange
  // is |question| (sent with |context| before it, if any) and |answer|.
  // Nothing is sent until the user writes.
  OnContinue(string question, string context, string answer);

  // A tool asks before it acts: the panel shows |title| and |detail| with
  // Allow, Allow for this chat and Deny, and answers with AnswerApproval().
  OnApproval(int32 id, string title, string detail);
  // Approval |id| no longer waits (Stop, New chat, Claude Code ended).
  OnApprovalCancelled(int32 id);
};
