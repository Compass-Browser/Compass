module compass.claude.mojom;

// How the key is sent (compass::claude::AuthStyle).
enum AuthStyle {
  // x-api-key: the Claude API.
  kApiKey,
  // Authorization: Bearer, for gateways that take a token.
  kBearer,
};

// What the chat runs on (compass::claude::Backend).
enum Backend {
  // The Claude API, or the gateway, with the saved key.
  kApiKey,
  // The user's Claude Code, signed in with their Claude subscription
  // (docs/design/claude.md, D8).
  kClaudeCode,
};

// The profile's Claude settings. The key itself never leaves the browser.
// Files (docs/design/claude.md, "Files"): prefs::FilesAccess.
enum FilesAccess {
  kOff,
  kSave,
  kFolder,
};

struct SettingsState {
  Backend backend;
  // Claude Code's path as set; empty to look in the usual places.
  string claude_code_path;
  // Claude Code gets Compass's tools here (the MCP bridge); elsewhere it
  // only chats (Windows).
  bool claude_code_tools;
  bool has_key;
  // "sk-ant-…a1b2" while a key is saved.
  string key_hint;
  // Empty for the Claude API.
  string base_url;
  AuthStyle auth_style;
  string model;
  // "Let Claude use the whole browser".
  bool browser_scope;
  // "Accept the risks of subscription tokens": a token from `claude
  // setup-token` may be the key.
  bool accept_token_risks;
  // "Allow MCP clients"; false where Compass has no MCP bridge.
  bool mcp_supported;
  bool mcp_enabled;
  // The command that adds Compass to Claude Code.
  string mcp_command;
  // The clients the user always allows, by name.
  array<string> mcp_allowed_clients;
  // "Use memory" and "Let Claude save memories" (docs/design/claude.md,
  // "Memory"); false where the profile has no memory (Guest).
  bool memory_supported;
  bool memory_enabled;
  bool memory_save;
  FilesAccess files_access;
  // The chosen folder; empty for none.
  string files_folder;
  // Where "Save files" goes without one: Downloads.
  string default_save_folder;
  // Claude Code mode's own tools (files, shell, web) in the folder.
  bool claude_code_own_tools;
};

// A fact Claude saved about the user.
struct Memory {
  string id;
  string text;
};

struct Model {
  string id;
  string display_name;
};

struct ConnectionResult {
  bool ok;
  // What went wrong, for the user, when not ok.
  string error;
  // What it connected to, when ok: Claude Code's version and account.
  string detail;
  // The models the key can use, newest first, when ok.
  array<Model> models;
};

// compass://settings/claude (claude_page.ts). See docs/design/claude.md,
// "Settings".
interface SettingsHandler {
  GetState() => (SettingsState state);
  // Saves |key|, encrypted; an empty one removes the saved key. |saved| is
  // false when the OS's storage refused it.
  SetApiKey(string key) => (bool saved);
  // |ok| is false, and nothing changes, if |base_url| isn't https (or http to
  // this computer).
  SetEndpoint(string base_url, AuthStyle auth_style) => (bool ok);
  SetModel(string model);
  SetBackend(Backend backend);
  // Empty looks in the usual places.
  SetClaudeCodePath(string path);
  SetBrowserScope(bool enabled);
  SetAcceptTokenRisks(bool accepted);
  SetMcpEnabled(bool enabled);
  // Asks again next time |client| connects.
  ForgetMcpClient(string client);
  SetMemoryEnabled(bool enabled);
  SetMemorySave(bool enabled);
  // Oldest first.
  GetMemories() => (array<Memory> memories);
  // A fact the user adds or edits themselves; |error| says why not.
  AddMemory(string text) => (string error);
  UpdateMemory(string id, string text) => (string error);
  RemoveMemory(string id);
  RemoveAllMemories();
  // Lists the models with the saved key and endpoint; in Claude Code mode,
  // finds Claude Code and says whether it's signed in.
  TestConnection() => (ConnectionResult result);
  SetFilesAccess(FilesAccess access);
  // Shows the system's folder picker; |folder| is the one chosen and saved,
  // empty if the user cancelled.
  ChooseFilesFolder() => (string folder);
  // No folder: "Save files" goes to Downloads again.
  ClearFilesFolder();
  SetClaudeCodeOwnTools(bool enabled);
};
