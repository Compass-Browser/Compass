module compass.claude.mojom;

// How the key is sent (compass::claude::AuthStyle).
enum AuthStyle {
  // x-api-key: the Claude API.
  kApiKey,
  // Authorization: Bearer, for gateways that take a token.
  kBearer,
};

// What the chat runs on (compass::claude::Backend).
enum Backend {
  // The Claude API, or the gateway, with the saved key.
  kApiKey,
  // The user's Claude Code, signed in with their Claude subscription
  // (docs/design/claude.md, D8).
  kClaudeCode,
};

// The profile's Claude settings. The key itself never leaves the browser.
// Files (docs/design/claude.md, "Files"): prefs::FilesAccess.
enum FilesAccess {
  kOff,
  kSave,
  kFolder,
};

// A provider the picker offers (compass::claude::AIProvider).
struct Provider {
  // "anthropic", "openai", "gemini", "compatible" (ProviderId()).
  string id;
  // "Google Gemini" (ProviderDisplayName()).
  string display_name;
};

struct SettingsState {
  // Who answers (docs/design/ai-providers.md): the key, the base URL and
  // the models below are this provider's; each keeps its own.
  string provider;
  // The picker's choices, Anthropic first.
  array<Provider> providers;
  // Where what's sent goes, for under the picker (PrivacyNote()).
  string privacy_note;
  // What the provider's key looks like ("sk-…"), for the key field.
  string key_placeholder;
  // The provider's own base URL, used when base_url is empty; empty for an
  // OpenAI-compatible server, which needs one.
  string default_base_url;
  // kApiKey whenever the provider isn't Anthropic: Claude Code is Claude's.
  Backend backend;
  // Claude Code's path as set; empty to look in the usual places.
  string claude_code_path;
  // Claude Code gets Compass's tools here (the MCP bridge); elsewhere it
  // only chats (Windows).
  bool claude_code_tools;
  bool has_key;
  // "sk-ant-…a1b2" while a key is saved.
  string key_hint;
  // Requests can go: a key is saved, or an OpenAI-compatible server's URL
  // is (which may need no key). The sidebar's switches need it.
  bool set_up;
  // Sign in with ChatGPT (docs/design/ai-providers.md): OpenAI only. While
  // signed in, OpenAI's requests use the ChatGPT plan, not the key.
  bool chatgpt_signed_in;
  // The signed-in account's email; may be empty while signed in.
  string chatgpt_email;
  // Why the last sign-in ended by itself, or the last token request failed;
  // empty if neither.
  string chatgpt_note;
  // Empty for the provider's own API (default_base_url).
  string base_url;
  AuthStyle auth_style;
  string model;
  // "Let Claude use the whole browser".
  bool browser_scope;
  // "Accept the risks of subscription tokens": a token from `claude
  // setup-token` may be the key.
  bool accept_token_risks;
  // "Allow MCP clients"; false where Compass has no MCP bridge.
  bool mcp_supported;
  bool mcp_enabled;
  // The command that adds Compass to Claude Code.
  string mcp_command;
  // The clients the user always allows, by name.
  array<string> mcp_allowed_clients;
  // "Use memory" and "Let Claude save memories" (docs/design/claude.md,
  // "Memory"); false where the profile has no memory (Guest).
  bool memory_supported;
  bool memory_enabled;
  bool memory_save;
  FilesAccess files_access;
  // The chosen folder; empty for none.
  string files_folder;
  // Where "Save files" goes without one: Downloads.
  string default_save_folder;
  // Claude Code mode's own tools (files, shell, web) in the folder.
  bool claude_code_own_tools;
  // "Let Claude use developer tools" (docs/design/claude.md, "Developer
  // tools").
  bool devtools;
  // "Let Claude make Boosts" (docs/design/boosts.md).
  bool boosts;
  // "Let Claude make plugins" (docs/design/claude.md, "Plugins").
  bool plugins;
  // Claude in the sidebar (docs/design/ai-sidebar.md): false where the
  // profile can't use it (Guest). Each feature has its own switch, which
  // needs the provider set up (set_up). "Name Link Folders":
  bool sidebar_supported;
  bool name_link_folders;
  // The model it asks (each feature has its own); empty, with an
  // OpenAI-compatible server, is the chat's.
  string name_link_folders_model;
  // "Tidy Today", and its model.
  bool tidy_today;
  string tidy_today_model;
  // "Shorter Tab Titles", and its model.
  bool short_tab_titles;
  string short_tab_titles_model;
  // "Answer Questions in the Command Bar", and its model.
  bool command_bar_ask;
  string command_bar_ask_model;
  // "Answer with" (docs/design/ai-sidebar.md, "On this device"): false
  // where there's no Apple Intelligence helper (not a Mac, or a build
  // without it). |sidebar_on_device|: Apple Intelligence answers Name Link
  // Folders, Tidy Today and Shorter Tab Titles, which then need no key;
  // CheckOnDevice() says whether it can.
  bool on_device_supported;
  bool sidebar_on_device;
};

// A fact Claude saved about the user.
struct Memory {
  string id;
  string text;
};

struct Model {
  string id;
  string display_name;
};

struct ConnectionResult {
  bool ok;
  // What went wrong, for the user, when not ok.
  string error;
  // What it connected to, when ok: Claude Code's version and account.
  string detail;
  // The models the key can use, newest first, when ok.
  array<Model> models;
};

// compass://settings/claude (claude_page.ts). See docs/design/claude.md,
// "Settings".
interface SettingsHandler {
  GetState() => (SettingsState state);
  // Picks who answers (a Provider's id; another is ignored). The state read
  // next is the new provider's.
  SetProvider(string provider);
  // Sign in with ChatGPT: opens OpenAI's sign-in in a new tab and answers
  // once it's done; |error| is empty when signed in, else why not. Another
  // sign-in underway is cancelled.
  SignInWithChatGPT() => (string error);
  // Signs out of ChatGPT; |revoked| tells whether OpenAI confirmed revoking
  // the tokens (they're forgotten here either way).
  SignOutOfChatGPT() => (bool revoked);
  // Saves |key|, encrypted; an empty one removes the saved key. |saved| is
  // false when the OS's storage refused it.
  SetApiKey(string key) => (bool saved);
  // |ok| is false, and nothing changes, if |base_url| isn't https (or http to
  // this computer). Empty is the provider's own API, or, for an
  // OpenAI-compatible server, no server yet. |auth_style| is Anthropic's
  // only; another provider's is left as it was.
  SetEndpoint(string base_url, AuthStyle auth_style) => (bool ok);
  SetModel(string model);
  SetBackend(Backend backend);
  // Empty looks in the usual places.
  SetClaudeCodePath(string path);
  SetBrowserScope(bool enabled);
  SetAcceptTokenRisks(bool accepted);
  SetMcpEnabled(bool enabled);
  // Asks again next time |client| connects.
  ForgetMcpClient(string client);
  SetMemoryEnabled(bool enabled);
  SetMemorySave(bool enabled);
  // Oldest first.
  GetMemories() => (array<Memory> memories);
  // A fact the user adds or edits themselves; |error| says why not.
  AddMemory(string text) => (string error);
  UpdateMemory(string id, string text) => (string error);
  RemoveMemory(string id);
  RemoveAllMemories();
  // Lists the models with the saved key and endpoint; in Claude Code mode
  // (Anthropic only), finds Claude Code and says whether it's signed in.
  TestConnection() => (ConnectionResult result);
  SetFilesAccess(FilesAccess access);
  // Shows the system's folder picker; |folder| is the one chosen and saved,
  // empty if the user cancelled.
  ChooseFilesFolder() => (string folder);
  // No folder: "Save files" goes to Downloads again.
  ClearFilesFolder();
  SetClaudeCodeOwnTools(bool enabled);
  SetDevTools(bool enabled);
  SetBoosts(bool enabled);
  SetPlugins(bool enabled);
  SetNameLinkFolders(bool enabled);
  // Empty goes back to the provider's default (Claude Haiku; the chat's
  // model for an OpenAI-compatible server). The same for the others.
  SetNameLinkFoldersModel(string model);
  SetTidyToday(bool enabled);
  // Empty goes back to the default (Claude Haiku).
  SetTidyTodayModel(string model);
  SetShortTabTitles(bool enabled);
  // Empty goes back to the default (Claude Haiku).
  SetShortTabTitlesModel(string model);
  SetCommandBarAsk(bool enabled);
  // Empty goes back to the default (Claude Sonnet).
  SetCommandBarAskModel(string model);
  // "Answer with": Apple Intelligence (true) or the chat's provider.
  SetSidebarOnDevice(bool on_device);
  // Whether Apple Intelligence can answer now: |unavailable| is empty if it
  // can, else why not, for the user.
  CheckOnDevice() => (string unavailable);
};
