module compass.sidebar.mojom;

import "url/mojom/url.mojom";

// Mirrors compass::SidebarNode::Type.
enum NodeType {
  kRoot,
  kFolder,
  kTab,
  kSplit,
};

// What a tab node's tab sounds like (compass::LiveTabRegistry::AudioState):
// the sidebar shows a speaker on a tab that plays sound, crossed out on a
// muted one.
// Of Page.Swipe().
enum SwipePhase {
  kBegin,
  kUpdate,
  kEnd,
};

enum AudioState {
  kNone,
  kAudible,
  kMuted,
};

// A live folder: a pinned folder a plugin fills (docs/design/live-folders.md).
struct LiveFolder {
  string plugin_id;
  // Empty when the plugin isn't installed on this device.
  string plugin_name;
  // The plugin's icon, as a URL the sidebar can load (a path on
  // chrome://compass-sidebar/, or a data: URL), or empty.
  string icon_url;
};

// What a live folder is doing, besides its entries.
struct LiveFolderState {
  bool refreshing;
  // The last refresh's error, for the user; empty if it worked.
  string error;
};

// One entry of the window's SpaceModel, with its subtree.
struct Node {
  // The node's UUID. Stable for its lifetime.
  string id;
  NodeType type;
  string title;
  // The name the user gave a tab, shown instead of its title. Empty if none.
  string custom_title;
  // Claude's short title for a tab's title ("Shorter Tab Titles",
  // docs/design/ai-sidebar.md), shown when there's no custom title; the
  // row's tooltip and the hover card keep the title. Empty if none.
  string short_title;
  url.mojom.Url url;
  // Whether a tab node has a tab in this window. Pinned tab nodes can be
  // unloaded; Today's are always live.
  bool live;
  // A live tab's sound; kNone for other nodes.
  AudioState audio;
  // Claude is acting in the tab now (docs/design/claude.md): its row is
  // tinted.
  bool claude;
  // A plugin's notification count for the tab's page
  // (docs/design/live-folders.md, "Badges"): 0 for none, -1 for some
  // without a number.
  int32 badge_count;
  // Whether a folder shows only its own row. The same in every window.
  bool collapsed;
  // Set for a live folder.
  LiveFolder? live_folder;
  // A live folder's entry, and whether it came with a refresh and hasn't
  // been opened.
  bool live_item;
  bool unseen;
  // Shared with other people (docs/design/sync.md, "Rooms: clients"): set
  // on the shared folder or easel tab itself, which shows a people badge
  // with |shared_tooltip| (the members); |view_only| on everything of a
  // viewer's shared item, which the page doesn't let change.
  bool shared;
  string shared_tooltip;
  bool view_only;
  array<Node> children;
};

// A shared item this profile was removed from, or that was deleted: the
// sidebar shows a banner until dismissed; the item stays, unshared.
struct RoomNotice {
  string room_id;
  string text;
};

// A field of a plugin's settings form (its manifest's "config").
struct LiveConfigField {
  string key;
  // "string", "url", "number", "bool" or "select".
  string type;
  string label;
  string placeholder;
  bool optional;
  // The default as JSON, or empty.
  string default_json;
  double? min;
  double? max;
  array<LiveSelectOption> options;
};

struct LiveSelectOption {
  string value;
  string label;
};

// A secret a plugin asks for: entered once per device, never synced.
struct LiveSecretField {
  string key;
  string label;
  string help;
  bool optional;
  // Whether one is stored: the form can leave it blank to keep it.
  bool has_value;
};

// A plugin New Live Folder offers.
struct LivePlugin {
  string id;
  string name;
  string description;
  // As LiveFolder.icon_url.
  string icon_url;
  array<LiveConfigField> config;
  array<LiveSecretField> secrets;
  // The hosts it may send the profile's cookies to, once allowed; empty if
  // it never does.
  array<string> cookie_hosts;
  // Ships with Compass; else installed, and removable.
  bool builtin;
  // Read from a folder in Compass Plugins; removed by removing that folder.
  bool local;
};

// A plugin about to be installed, for the user to review: what it reaches
// and what it asks for.
struct LivePluginPreview {
  string id;
  string name;
  string description;
  string version;
  // Host patterns ("{config:url}" stands for the address the user enters).
  array<string> hosts;
  array<string> cookie_hosts;
  // The secrets' labels.
  array<string> secrets;
  // Its address, and the hash InstallLivePlugin() checks.
  string source;
  string sha256;
  // Its tab preview (docs/design/live-folders.md, "Tab previews"): the sites
  // whose pages it reads ("calendar.google.com"), and with the session, the
  // site it may make requests to as the user and the other hosts it reaches.
  array<string> preview_sites;
  string session_site;
  array<string> related_hosts;
};

// Settings › Plugins (compass://settings/plugins): a plugin, what it does,
// and the user's settings for its tab preview.
struct PluginSettings {
  string id;
  string name;
  string version;
  string description;
  // A data: URL, or empty.
  string icon_url;
  // "builtin", "installed", "local" or "claude" (a local plugin Claude made).
  string source;
  // An installed plugin's address.
  string source_url;

  // Live folders: whether it fills them, how many use it, and what they
  // reach.
  bool folder;
  int32 folder_count;
  array<string> hosts;
  array<string> cookie_hosts;

  // Tab previews.
  bool preview;
  array<string> preview_sites;
  bool preview_enabled;
  // Its count shows on the tab's row (a badge).
  bool badge;
  string session_site;
  array<string> related_hosts;
  bool session_granted;
  array<LiveConfigField> preview_config;
  // The user's values, as JSON.
  string preview_config_json;
  // What it logged on its last preview.
  array<string> log;
};
struct LiveFolderSource {
  string plugin_id;
  string title;
  string config_json;
  bool cookies_granted;
  // For an installed plugin: where it comes from and its hash, so a device
  // without it can install it.
  string plugin_url;
  string plugin_sha256;
};

// The live folder editor's answer: a new folder (|folder_id| null, in
// |parent_id|, at the end) or changes to one.
struct LiveFolderEdit {
  string? folder_id;
  string? parent_id;
  string plugin_id;
  // For a new folder; empty takes the plugin's (then the feed's) name.
  string title;
  string config_json;
  // Secrets by key; empty values keep what's stored.
  map<string, string> secrets;
  bool grant_cookies;
};

struct Tree {
  // The profile's favorites, the same in every space: a root of tabs.
  Node favorites;
  Node pinned;
  Node today;
  // False for an incognito space, which has no Pinned section: the page
  // leaves it out, and |pinned| stays empty.
  bool has_pinned = true;
  // The node of the window's active tab, if it has one.
  string? active_id;
};

// A tab playing media (or paused) that the window doesn't show: the sidebar
// shows a "now playing" widget for it above the spaces, as Arc does
// (docs/design/sidebar.md, "Now playing").
struct NowPlaying {
  // Stable while it shows.
  string id;
  // The media's title: the page's, unless the site gives one.
  string title;
  // The tab's page, for its favicon.
  url.mojom.Url url;
  bool playing;
  bool muted;
  // False while muted: Chromium takes a muted tab's players out of its media
  // session, so only the speaker (unmute) works.
  bool can_play_pause;
  bool can_previous;
  bool can_next;
  bool can_picture_in_picture;
};

// What a now playing widget's buttons do.
enum NowPlayingAction {
  kPlay,
  kPause,
  kPreviousTrack,
  kNextTrack,
  kPictureInPicture,
  kMute,
  kUnmute,
  // Pauses it and hides the widget until it plays again.
  kDismiss,
  // Shows its tab, switching space if it's another space's.
  kShowTab,
};

// Bootstraps the connection; called once by the page.
interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// A space's color (compass::SpaceColor): a palette color or any other. Null
// stands for grey, which leaves the sidebar untinted.
struct SpaceColor {
  uint8 red;
  uint8 green;
  uint8 blue;
};

// A space's icon (compass::SpaceIcon). A space without one is shown by its
// name's first letter.
union SpaceIcon {
  string emoji;
  // A name from the page's SPACE_SYMBOLS (space_icons.ts).
  string symbol;
};

// Mirrors compass::SpaceAppearance.
enum SpaceAppearance { kAuto, kLight, kDark };

// A space, as the switcher shows it.
struct Space {
  string id;
  string name;
  SpaceColor? color;
  // The colors the sidebar's gradient goes on to after |color|; empty for a
  // plain color (compass::SpaceModel::gradient()).
  array<SpaceColor> gradient;
  // How strong the tint is and how much grain it has, 0 to 1.
  double intensity;
  double grain;
  SpaceAppearance appearance;
  SpaceIcon? icon;
  // How long a Today entry may go unseen before it's archived; 0 for never.
  uint32 archive_after_hours;
  // Whether it syncs to the chain's other devices (compass::SpaceModel::
  // synced()), and whether its profile's spaces sync at all: the menu offers
  // the switch when they do, or when the space is already kept here.
  bool synced;
  bool sync_on;
  // The profile it belongs to: its ID (as ProfileOption's) and name.
  string profile_id;
  string profile_name;
  // Whether it belongs to the window's profile. Entries can't move to the
  // others, and switching to one swaps the window (docs/design/spaces.md,
  // slice 3).
  bool own_profile;
  // Sharing (docs/design/sync.md, "Rooms: clients"): whether the menu offers
  // Share, whether the space is shared, and whether it's a viewer's.
  bool can_share;
  bool shared;
  bool view_only;
};

// A profile a space can be assigned to.
struct ProfileOption {
  // Its directory's name.
  string id;
  string name;
};

struct ArchivedTab {
  string title;
  url.mojom.Url url;
};

// An archived Today entry: a tab, or a split's panes.
struct ArchivedEntry {
  // Stable for the session only.
  string id;
  array<ArchivedTab> tabs;
  // Milliseconds since the Unix epoch, as JS Date takes them.
  double archived_at;
};

// Browser-side handler for requests from chrome://compass-sidebar.
interface PageHandler {
  // Answered with Page.SetSpaces(), Page.SetTree() and Page.SetArchive(), on
  // the same pipe as the diffs, so the page sees them in order.
  RequestTree();
  // The page has taken the tree of Page.SetTree(); sent after each one.
  TreeShown();
  // Activates a tab node's tab, opening one if the node is unloaded. Ignored
  // for other nodes.
  ActivateNode(string id);
  // Closes a tab node's tab, or every pane's of a split. Tabs close through
  // the tab strip, so beforeunload can cancel. When the tab is gone, a Today
  // node goes with it and a pinned node stays, unloaded. An unloaded node is
  // removed.
  CloseNode(string id);
  // Closes every Today tab, in folders and splits too, as CloseNode() does
  // each (beforeunload can keep one), and removes the folders left without
  // a tab. The Today header's Clear button.
  ClearToday();
  // Tidy Today (docs/design/ai-sidebar.md): asks Claude to group Today's
  // loose entries into named folders. The Today header's Tidy button, shown
  // while TidyChanged() says it's available. Ignored with fewer than 5 loose
  // entries, or while one is on its way.
  TidyToday();
  // The Undo of the toast ShowToast() sent with |undo_tidy_id|.
  UndoTidy(int32 undo_tidy_id);
  // Opens the command bar for a new entry (docs/design/command-bar.md).
  NewTab();
  // Mutes or unmutes a tab node's live tab: its speaker was clicked.
  // Ignored for other nodes.
  SetNodeMuted(string id, bool muted);

  // Drag and drop. |index| is the slot among |new_parent_id|'s current
  // children, counted with the node still in place. Invalid moves are
  // ignored. Moving a tab entry into the favorites root makes it a favorite,
  // and moving a favorite into the window's space makes it an entry there.
  MoveNode(string id, string new_parent_id, uint32 index);
  // A tab dropped on another tab: they show side by side, |id| on the left
  // if |first|, else on the right. On a split's pane, it joins the split
  // next to that pane, on that side. Ignored where SpaceModel::CanSplit()
  // says no (a split holds up to four tabs).
  SplitNode(string id, string target_id, bool first);
  // Entry |id|, dragged, was dropped where nothing took it. If the pointer
  // is outside every Compass window, a tab entry's page opens there in a
  // little window (docs/design/little-window.md): a live tab moves, as it
  // is. A Today entry leaves the sidebar; a pinned entry or a favorite stays,
  // unloaded. Ignored for folders and splits, and inside a window.
  DropNodeOutside(string id);
  // A link dropped on the sidebar: a new entry for |url| at the slot |index|
  // among |parent_id|'s children, opened in the foreground. Only http(s) and
  // file URLs, and only where a tab can go.
  OpenLink(url.mojom.Url url, string parent_id, uint32 index);
  // In Pinned or Today, at the top or in a folder; other parents are ignored.
  AddFolder(string parent_id, uint32 index, string title);
  // New Easel (docs/design/easels.md): a board, with its tab pinned at the
  // end of Pinned, shown. Ignored where there are no Easels (incognito).
  NewEasel();
  RenameFolder(string id, string title);
  // Names a tab (a pane too); an empty or blank name goes back to the page's
  // title.
  RenameTab(string id, string title);
  // Collapses or expands a folder, in every window. Saved.
  SetFolderCollapsed(string id, bool collapsed);
  // Removes a folder (Pinned or Today), a pinned entry or a favorite and its
  // subtree, closing live tabs.
  DeleteNode(string id);

  // Shows another space in this window; the page then gets its tree. A space
  // of another profile swaps the window instead: this page closes with it.
  SwitchSpace(string id);
  // Adds a space at the end and switches to it.
  AddSpace();
  // Empty names are ignored.
  RenameSpace(string id, string name);
  // Null makes it grey.
  SetSpaceColor(string id, SpaceColor? color);
  // At most 2; ignored for a grey space.
  SetSpaceGradient(string id, array<SpaceColor> gradient);
  // 0 to 1, clamped.
  SetSpaceIntensity(string id, double intensity);
  SetSpaceGrain(string id, double grain);
  SetSpaceAppearance(string id, SpaceAppearance appearance);
  // Null removes it. Invalid ones (compass::SpaceIcon) are ignored.
  SetSpaceIcon(string id, SpaceIcon? icon);
  // Assigns a space to profile |profile_id|, or to a new profile if null: its
  // entries go along, its open tabs reload there (docs/design/spaces.md,
  // "Assigning a profile").
  SetSpaceProfile(string id, string? profile_id);
  // Deletes a space with its entries and tabs, unless it's the last one.
  // Windows showing it switch to its neighbor first.
  DeleteSpace(string id);
  // Moves a space in the switcher's list, in every window. |index| is the
  // slot among the spaces SetSpaces() sent, counted with it still in place.
  MoveSpace(string id, uint32 index);
  // Moves an entry and its subtree, with its live tabs, to another space: to
  // the end of the same section there.
  MoveNodeToSpace(string id, string space_id);
  // Space |id|'s pinned and Today entries, for a swipe to show before it
  // switches (docs/design/spaces.md, "Swiping"), with the entry the switch
  // would show as its active one. Null for an unknown space.
  GetSpaceTree(string id) => (Tree? tree);
  // A swipe is pulling in space |id|, |progress| (0 to 1) of the way: the
  // sidebar's tint blends toward its color. Null ends the swipe without
  // switching, and the tint fades back. SwitchSpace() ends it too.
  PreviewSpace(string? id, double progress);
  // 0 turns auto-archive off for the space. At most a year.
  SetArchiveAfter(string space_id, uint32 hours);
  // Makes the space sync to the other devices, or stay on this one (turning
  // it off removes it from them). See docs/design/sync.md, "Spaces that
  // don't sync".
  SetSpaceSynced(string space_id, bool synced);
  // Opens the space's editor in a bubble (ShowSpaceEditorBubble()),
  // pointing at the given rectangle of the page: the switcher's button or
  // the space's name.
  EditSpace(string space_id, int32 x, int32 y, int32 width, int32 height);
  // The banners of shared items this profile lost; the page asks again
  // with each SetSpaces(), which a change of rooms also sends.
  GetRoomNotices() => (array<RoomNotice> notices);
  // Drops a room notice's banner.
  DismissRoomNotice(string room_id);

  // The window's space's archive. Restoring puts the entry back at the end of
  // Today and opens it in the foreground.
  RestoreArchived(string id);
  RemoveArchived(string id);
  ClearArchive();

  // The pointer rests on tab node |id|'s row, which spans |row_top| to
  // |row_top| + |row_height| in the page: shows its hover card next to it, or
  // moves the card there. Other nodes hide the card.
  ShowHoverCard(string id, int32 row_top, int32 row_height);
  HideHoverCard();
  // The pointer left the rows. A card whose plugin preview rows take clicks
  // stays while the pointer heads to it or is on it; others hide.
  ReleaseHoverCard();
  // The pointer came to rest on tab node |id|'s row and its card will open:
  // starts a plugin's preview of the tab, if one previews its page, so the
  // card opens with it (docs/design/live-folders.md, "Tab previews").
  PrefetchHoverPreview(string id);

  // The page was right-clicked on node |id|'s row or tile, at |x|, |y| in the
  // page: shows the node's context menu there (docs/design/sidebar.md,
  // "Context menus").
  ShowContextMenu(string id, int32 x, int32 y);

  // A now playing widget's button. Ignored for a widget that's gone.
  ActOnNowPlaying(string id, NowPlayingAction action);

  // Live folders (docs/design/live-folders.md). The plugins New Live Folder
  // offers.
  GetLivePlugins() => (array<LivePlugin> plugins);
  // Live folder |id|'s source, for the editor; null if it isn't one.
  GetLiveFolderSource(string id) => (LiveFolderSource? source);
  // Makes or changes a live folder; answers an error for the user, or empty.
  SaveLiveFolder(LiveFolderEdit edit) => (string error);
  RefreshLiveFolder(string id);
  // Fetches the plugin whose manifest is at |url| for review: null and an
  // error for the user if it can't.
  PreviewLivePlugin(string url) => (LivePluginPreview? preview, string error);
  // Installs it if it's still the reviewed one (|sha256|); answers an
  // error, or empty.
  InstallLivePlugin(string url, string sha256) => (string error);
  RemoveLivePlugin(string id) => ();
  // Shows <user data>/Compass Plugins (made if need be) in the file manager:
  // a folder put there with a manifest.json is a local plugin.
  OpenLivePluginsFolder();
};

// Implemented by the page; the browser pushes the model's changes through it,
// in the order the model made them.
interface Page {
  // The switcher's spaces, of every profile (only the profile's own in an
  // off-the-record window), the one this window shows, and the profiles a
  // space can be assigned to (none off the record). Sent before the tree,
  // and whenever they change.
  SetSpaces(array<Space> spaces, string active_id,
            array<ProfileOption> profiles);
  // The whole tree. Replaces whatever the page had.
  SetTree(Tree tree);
  NodeAdded(string parent_id, uint32 index, Node node);
  // |index| is counted after the node left its old parent.
  NodeMoved(string id, string new_parent_id, uint32 index);
  NodeChanged(string id, string title, string custom_title, url.mojom.Url url,
              bool collapsed);
  NodeRemoved(string id);
  NodeLiveChanged(string id, bool live);
  NodeAudioChanged(string id, AudioState audio);
  NodeClaudeChanged(string id, bool claude);
  // As Node.badge_count.
  NodeBadgeChanged(string id, int32 count);
  // A tab's short title came or went (Node.short_title). A new title drops
  // it before NodeChanged() brings the title.
  NodeShortTitleChanged(string id, string short_title);
  // A tab's live folder entry state changed (it was opened, or left its
  // folder).
  NodeLiveItemChanged(string id, bool live_item, bool unseen);
  // A folder became live, changed plugin, or became plain (null).
  LiveFolderChanged(string id, LiveFolder? live_folder);
  // A live folder started or finished refreshing. Sent for every live folder
  // after the tree.
  LiveFolderStateChanged(string id, LiveFolderState state);
  // "New Live Folder…" or "Edit Source…" was chosen: shows the live folder
  // editor for a new folder in |parent_id|, or for folder |folder_id|.
  ShowLiveFolderEditor(string? parent_id, string? folder_id);
  ActiveNodeChanged(string? id);
  // The window's space's archived entries, most recent first. Sent after the
  // tree, and whenever they change.
  SetArchive(array<ArchivedEntry> entries);
  // Rename was chosen in folder |id|'s context menu: shows its name for
  // editing, as a double-click does.
  StartRename(string id);
  // Claude just named folder |id| (docs/design/ai-sidebar.md): its new name
  // fades in with a sparkle on its icon.
  FolderNamed(string id);
  // Tidy Today (docs/design/ai-sidebar.md): whether Today's header offers
  // Tidy (its switch on, Claude set up, not incognito), and whether a tidy
  // of the window's space waits for Claude. Sent after the tree, and
  // whenever either changes. The page disables it with fewer than 5 loose
  // entries.
  TidyChanged(bool available, bool busy);
  // A message at the bottom of the sidebar for a few seconds: |text|, with
  // Undo calling UndoTidy(|undo_tidy_id|) unless that's 0.
  ShowToast(string text, int32 undo_tidy_id);
  // The window's now playing widgets, top to bottom. Sent after the tree, and
  // whenever they change.
  SetNowPlaying(array<NowPlaying> items);
  // A two-finger swipe across the sidebar (docs/design/spaces.md,
  // "Swiping"), told by the browser so vertical scrolls never wait on the
  // page: kBegin, then kUpdate with how far the fingers moved right since
  // the last one (CSS pixels, momentum included), then kEnd.
  Swipe(SwipePhase phase, float delta_x);
};

// Browser-side handler for chrome://compass-placeholder, the tab a window shows
// for a tab that moved to another window.
interface PlaceholderHandler {
  // The tab the placeholder stands for.
  GetInfo() => (string title, url.mojom.Url url);
  // A data: URL of a screenshot of the tab, taken as it left. Answers once
  // it's encoded; empty if there's none.
  GetSnapshot() => (string data_url);
  // Moves that tab back into the placeholder's window, replacing it.
  BringHere();
};

// Browser-side handler for chrome://compass-empty, what a window with nothing
// else to show shows.
interface EmptyPageHandler {
  // Opens the window's command bar, unless it's open. A window without one
  // loads the new tab page instead.
  ShowCommandBar();

  // Sends the page its window's space's tint now and whenever it changes.
  SetPage(pending_remote<EmptyPage> page);
};

// chrome://compass-empty, as its handler sees it.
interface EmptyPage {
  // What the pane paints over the frame color, as Arc paints an empty pane:
  // three evenly spaced stops from the top left corner to the bottom right
  // one, ARGB (all transparent for a grey space), and the grain's opacity.
  SetTint(array<uint32> stops, float grain_opacity);
};

// An Arc space chrome://compass-import offers.
struct ArcImportSpace {
  // Arc's space ID.
  string id;
  string name;
  // Tabs in its Pinned and Today.
  int32 tab_count;
  // Entries of its archive that come along (the newest, at most 100).
  int32 archived_count;
  // Brought in already.
  bool imported;
};

// An Arc profile chrome://compass-import offers (docs/design/arc-import.md).
struct ArcImportProfile {
  // Its folder in Arc ("Default", "Profile 1", ...).
  string dir;
  string name;
  // Its spaces, in Arc's order.
  array<ArcImportSpace> spaces;
  // Tabs in its spaces and favorites.
  int32 tab_count;
  // Imported already: a Compass profile came from it. Its newer spaces can
  // still be brought in.
  bool imported;
};

struct ArcImportState {
  // Arc's sidebar was found and read.
  bool found;
  // Arc is open (its databases are in use; it must be quit first).
  bool arc_running;
  array<ArcImportProfile> profiles;
  // Arc's own app icon, as a PNG data: URL; empty if there's none.
  string icon_data_url;
};

// A profile of another browser chrome://compass-import offers
// (docs/design/browser-import.md).
struct BrowserImportProfile {
  // Stable: "<browser>:<profile folder>".
  string id;
  // "Chrome", "Firefox", ...
  string browser;
  // The profile's own name (empty for Safari).
  string name;
  // The spaces it brings, in order.
  array<string> spaces;
  // Tabs its bookmarks (and favorites) give, and its open tabs.
  int32 bookmark_count;
  int32 tab_count;
  // Its browser is open: it must be quit first.
  bool running;
  // Its spaces are here already.
  bool imported;
  // History and passwords can come along on this platform.
  bool history;
  bool passwords;
  // Why some of it can't be read, if so; empty otherwise.
  string note;
  // It can become a Compass profile of its own (Chromium-based browsers).
  bool as_profile;
  // What becoming one brings, when not all a Chromium profile has (Crest,
  // Yab); empty otherwise.
  string as_profile_brings;
  // The Compass profile it became before; empty if none.
  string imported_as_profile;
  // The Chromium version that last opened it, when newer than Compass's
  // (a copy may lose data); 0 otherwise.
  int32 newer_version;
  // Its browser's own app icon, read from the installed app, as a PNG
  // data: URL; empty if there's none (the page shows a letter).
  string icon_data_url;
};

// What to bring from one profile.
struct BrowserImportChoice {
  string id;
  bool bookmarks;
  bool tabs;
  bool history;
  bool passwords;
  // As a new Compass profile: copied with its cookies, history, passwords,
  // extensions and settings (|history| and |passwords| don't apply).
  bool new_profile;
};

// What one profile's import did.
struct BrowserImportSummary {
  // As its space is named ("Chrome", "Firefox, Work" with an en dash).
  string name;
  array<string> spaces;
  int32 pinned;
  int32 today;
  int32 favorites;
  // History pages and passwords imported; -1: through Chromium's importer,
  // which doesn't count them.
  int32 history;
  int32 passwords;
  // Passwords that couldn't be decrypted.
  int32 passwords_skipped;
  // The new Compass profile it became; empty if it went into this one.
  string profile;
  // What came along into it, when not all a Chromium profile has (Crest,
  // Yab); empty otherwise.
  string brought;
  // Cookies that couldn't come along into the new profile.
  int32 cookies_dropped;
  array<string> problems;
};

// Browser-side handler for chrome://compass-import: importing from Arc and
// from other browsers.
interface ArcImportHandler {
  GetState() => (ArcImportState state);
  // Asks Arc to quit; answers once it has, or false after a few seconds.
  QuitArc() => (bool quit);
  // Imports the Arc profiles |profiles| (folders) as new Compass profiles:
  // cookies, history, passwords, settings, extensions, favorites, and those
  // of |spaces| (Arc space IDs) that are theirs. Spaces of profiles imported
  // before go into the Compass profile each became. macOS asks whether
  // Compass may use Arc's Keychain key. Answers with the names of the
  // profiles made and of those that got spaces, the Arc profiles (folders)
  // that failed, how many cookies and passwords couldn't be decrypted (left
  // behind), and how many of the spaces' Easels came over, and came over
  // empty because Arc never downloaded them to this Mac.
  Import(array<string> profiles, array<string> spaces)
      => (array<string> imported, array<string> updated,
          array<string> failed, int32 undecryptable, int32 easels,
          int32 easels_missing);
  // Fills the Easels that came over empty, from what Arc has now (after the
  // user opened them in Arc). Doesn't run while Arc does (|arc_running|).
  ImportEasels() => (bool arc_running, int32 easels, int32 easels_missing);
  // Shows the first imported space in this window.
  OpenImported();

  // Other browsers' profiles on this computer.
  GetBrowsers() => (array<BrowserImportProfile> profiles);
  // Imports |choices| into this page's profile, or as new profiles, one
  // after another, and answers with what each did.
  ImportBrowsers(array<BrowserImportChoice> choices)
      => (array<BrowserImportSummary> summaries);
};

// One shortcut on chrome://compass-settings (docs/design/shortcuts.md
// "Customizing").
struct Shortcut {
  // Its key in the "compass.shortcuts" pref ("copy-url", "space-1").
  string id;
  string section;
  string label;
  // Its keys in force, as menus show them (with the modifier symbols on
  // macOS); empty: none.
  array<string> keys;
  // Its keys as Compass ships them.
  array<string> default_keys;
  // The user changed it (keys or none).
  bool customized;
};

// Keys pressed on the settings page, from a keydown event.
struct ShortcutKeys {
  // KeyboardEvent.keyCode: a ui::KeyboardCode.
  int32 key_code;
  bool shift;
  bool ctrl;
  bool alt;
  bool meta;
};

// What giving a shortcut some keys would do.
struct ShortcutCheck {
  // The keys, as menus show them.
  string text;
  // Why they can't be used; empty if they can.
  string error;
  // A listed shortcut that has them now, which taking them leaves with none.
  // Empty if none.
  string conflict_id;
  string conflict_label;
};

// A space a link rule can name (docs/design/link-routing.md), as the
// switcher shows it.
struct LinkRuleSpace {
  string id;
  // "Space <n>" for one without a name.
  string name;
  SpaceColor? color;
  SpaceIcon? icon;
};

// Links from other apps on |domain| (and its subdomains) open in the space
// |space_id|. |broken|: the profile has no such space any more (it was
// deleted), so the rule routes nothing.
struct LinkRule {
  string domain;
  string space_id;
  bool broken;
};

// A Boost (docs/design/boosts.md): CSS and JavaScript for the pages |match|
// covers. |js_world| is "isolated" or "main"; |author| "user", "claude" or
// "shared" (added from someone's link or file).
struct Boost {
  string id;
  string name;
  string match;
  string css;
  string js;
  string js_world;
  bool enabled;
  string author;
};

// Browser-side handler for chrome://compass-settings, and for
// compass://settings' Keyboard shortcuts, Links from Other Apps and Boosts
// sections.
interface SettingsHandler {
  // Boosts (compass://settings/boosts): the profile's, oldest first.
  GetBoosts() => (array<Boost> boosts);
  // Adds |boost| (an empty id: a new one, the user's) or updates the one
  // with its id. The Boost as saved, or null and why not (no such site
  // pattern, too big, nothing to run).
  SaveBoost(Boost boost) => (Boost? saved, string error);
  SetBoostEnabled(string id, bool enabled) => ();
  DeleteBoost(string id) => ();

  // Sharing (docs/design/boosts.md, "Sharing"). The link that shares |id|
  // (https://compassbrowser.org/boost#…), or empty when there's no such
  // Boost or the link would be over 64 KB (share a file then).
  GetBoostShareLink(string id) => (string link);
  // Copies that link. False if there's none.
  CopyBoostShareLink(string id) => (bool copied);
  // Asks where to save |id| as <name>.compassboost and saves it there.
  // False if the user canceled or it couldn't be written.
  SaveBoostFile(string id) => (bool saved);
  // Asks for a .compassboost file: its Boost as a link's |payload| (the
  // part after "#"), for PreviewSharedBoost(); empty if canceled, with
  // |error| when the file isn't a Boost.
  ChooseBoostFile() => (string payload, string error);
  // What a link's |payload| would add, checked as a save is: the Boost
  // (no id, the author "shared"), or null and why not.
  PreviewSharedBoost(string payload) => (Boost? boost, string error);
  // Adds |payload|'s Boost as a new one, on, the author "shared". Never
  // replaces a Boost. The saved Boost, or null and why not.
  AddSharedBoost(string payload) => (Boost? saved, string error);

  // Link routing (compass://settings/links): the profile's rules, by domain,
  // and its spaces in the switcher's order.
  GetLinkRules() => (array<LinkRule> rules, array<LinkRuleSpace> spaces);
  // Gives |domain| (as typed: a domain or a URL, normalized here) the rule
  // for |space_id|, and removes |replacing|'s rule if it's another domain
  // (an edited rule). Returns the normalized domain, or null (and changes
  // nothing) if |domain| isn't one or there's no space |space_id|.
  SetLinkRule(string domain, string space_id, string replacing)
      => (string? domain);
  RemoveLinkRule(string domain) => ();

  // Development mode (compass://settings/devMode, docs/design/dev-mode.md):
  // the sites, as host patterns, in the order they were added.
  GetDevModeHosts() => (array<string> hosts);
  // Adds |host| as typed (a host, "*.domain", or a URL; a port and a path
  // are dropped). The pattern kept, or null if it isn't a web host.
  AddDevModeHost(string host) => (string? host);
  RemoveDevModeHost(string host) => ();

  // Plugins (compass://settings/plugins): live folders' and tab previews'.
  // Whether hover cards show previews, and every plugin, by name.
  // |claude_can_make| when "Let Claude make plugins" is on.
  GetPlugins() => (bool previews_enabled, array<PluginSettings> plugins,
                   bool claude_can_make);
  SetTabPreviewsEnabled(bool enabled) => ();
  SetPluginPreviewEnabled(string id, bool enabled) => ();
  // The tab's session for |id|'s requests, for the related hosts it lists
  // now.
  SetPluginSessionGranted(string id, bool granted) => ();
  // Checked against the preview's fields: empty, or why not.
  SetPluginPreviewConfig(string id, string config_json) => (string error);
  // Its files, read-only.
  GetPluginSource(string id) => (string manifest, string entry);
  // As the sidebar's PreviewLivePlugin() and InstallLivePlugin().
  PreviewPlugin(string url) => (LivePluginPreview? preview, string error);
  InstallPlugin(string url, string sha256) => (string error);
  // An installed or local plugin; built-ins stay.
  RemovePlugin(string id) => ();
  OpenPluginsFolder();
  // Opens Claude in this window, asking it to help make a plugin (with "Let
  // Claude make plugins" on).
  MakePluginWithClaude();

  GetShortcuts() => (array<Shortcut> shortcuts);
  // Whether Ctrl+Tab goes in recently used order, with cards
  // (compass.tabs.ctrl_tab_recent; docs/design/sidebar.md "Recent tabs").
  GetCtrlTabRecent() => (bool enabled);
  SetCtrlTabRecent(bool enabled) => ();
  // While the page records keys, the browser's shortcuts don't run, so the
  // keys reach it.
  SetRecording(bool recording);
  CheckShortcut(string id, ShortcutKeys keys) => (ShortcutCheck check);
  // Gives |id| the keys, taking them from the shortcut that had them (see
  // ShortcutCheck). Does nothing if they can't be used.
  SetShortcut(string id, ShortcutKeys keys) => ();
  // Leaves |id| without a shortcut.
  RemoveShortcut(string id) => ();
  // Back to the keys Compass ships.
  ResetShortcut(string id) => ();
  ResetAllShortcuts() => ();
};

// A pref the settings window shows (SettingsWindowHandler's allowlist), its
// value as JSON.
struct SettingsPref {
  string name;
  string value_json;
  // Set by policy or an extension: the page shows it and can't change it.
  bool enforced;
};

// Whether Compass is the default browser (shell_integration).
struct DefaultBrowserState {
  bool is_default;
  bool can_be_default;
  // The check failed: the page can't say.
  bool unknown;
  bool disabled_by_policy;
};

// A search engine that can be the default (TemplateURLService).
struct SearchEngine {
  // Its TemplateURLID, as text.
  string id;
  string name;
  bool is_default;
};

struct SearchEngines {
  array<SearchEngine> engines;
  // Set by policy or an extension: the page can't change it.
  bool managed;
};

// A search engine or site search, as General › Manage search engines lists
// them (KeywordEditorController's rules).
struct SearchEngineDetails {
  string id;
  string name;
  // The command bar shortcut.
  string keyword;
  // The search URL, with %s for the query.
  string url;
  bool is_default;
  // Site search: one the user or a site added (not prepopulated).
  bool is_site_search;
  // A site search that's on (offered by the command bar).
  bool is_active;
  bool can_edit;
  bool can_remove;
  bool can_make_default;
  bool can_activate;
  bool can_deactivate;
  // Set by policy or an extension.
  bool managed;
};

// A language Compass knows (TranslatePrefs::GetLanguageInfoList()).
struct LanguageInfo {
  string code;
  // In the browser's language, and in its own.
  string name;
  string native_name;
  bool supports_translate;
};

// One of the user's preferred languages, in their order.
struct PreferredLanguage {
  string code;
  // Whether Compass offers to translate pages in it (not blocked).
  bool translate_offered;
};

// A profile, as the settings window's Profiles pane lists it
// (ProfileAttributesStorage).
struct ProfileDetails {
  // Its directory's name (as ProfileOption's).
  string id;
  string name;
  // Whether it's the settings window's own profile.
  bool current;
  // How many spaces it has in the switcher.
  uint32 space_count;
};

// A site permission's setting (ContentSetting): kDefault for a site that
// follows the default.
enum PermissionValue {
  kDefault,
  kAllow,
  kBlock,
  kAsk,
};

// A permission's default (Privacy › Site settings).
struct PermissionDefault {
  // Upstream's group name ("location", "media-stream-camera").
  string type;
  PermissionValue value;
  // The values it can take.
  array<PermissionValue> choices;
  // Set by policy or an extension.
  bool managed;
};

// A site with permissions of its own.
struct SiteSummary {
  string origin;
  string display_name;
  int32 permission_count;
};

// A permission for one site.
struct SitePermission {
  string type;
  // The site's own setting, or kDefault.
  PermissionValue value;
  // What the site gets: its own or the default.
  PermissionValue effective;
  array<PermissionValue> choices;
  bool managed;
};

// A filter list of the ad blocker (Privacy › Ad blocker,
// docs/design/ad-blocker.md).
struct FilterList {
  string id;
  string title;
  string url;
  // EasyList, EasyPrivacy and the cookie list: they can be turned off, not
  // removed.
  bool builtin;
  bool enabled;
  // From the last build of the rules: network rules, element hiding rules,
  // and rules Compass can't apply (scriptlets, regular expressions, ...).
  int32 url_rules;
  int32 css_rules;
  int32 skipped;
  // When the text last changed, and when its server was last asked
  // (milliseconds since the epoch; 0: never).
  double updated_ms;
  double checked_ms;
  // The last download's error; empty if it worked.
  string error;
  // Being downloaded now.
  bool updating;
};

// What Privacy › Clear browsing data clears, over the time range (upstream's
// browsing_data::TimePeriod).
struct ClearBrowsingDataOptions {
  int32 time_period;
  bool history;
  bool downloads;
  bool cookies;
  bool cache;
  bool passwords;
  bool form_data;
  bool site_settings;
};

// A saved password or passkey (Passwords pane): never its secret.
struct SavedPassword {
  // The password manager's id for it (PasswordsPrivateDelegate).
  int32 id;
  // The site, as the password manager names it.
  string site;
  string username;
  bool is_passkey;
};

// A saved payment card: its name and last digits, never its number.
struct SavedCard {
  string guid;
  string name;
  string last_four;
  string expiration;
  // Saved in Compass (not one from the account), so it can be removed here.
  bool removable;
};

// A card being added (no guid) or edited (Passwords › Payment methods). Its
// number is only ever sent to the browser, for a new card; editing keeps
// the saved one.
struct CardDraft {
  string guid;
  string name_on_card;
  string number;
  int32 expiration_month;
  int32 expiration_year;
  string nickname;
  // For an edit: the saved card's last digits, as shown.
  string last_four;
};

// An address being added (no guid) or edited.
struct AddressDraft {
  string guid;
  string full_name;
  string organization;
  // Street lines, separated by newlines.
  string street;
  string city;
  string state;
  string postal_code;
  // ISO 3166-1 alpha-2 ("US").
  string country_code;
  string phone;
  string email;
};

struct SavedAddress {
  string guid;
  string name;
  // The street and city.
  string summary;
};

// Privacy › Safety check (phase 5e): what the password manager knows about
// the saved passwords, and the extensions.
struct SafetyCheckResult {
  // Not muted: leaked or phished, weak, reused.
  int32 compromised_passwords;
  int32 weak_passwords;
  int32 reused_passwords;
  int32 saved_passwords;
  // Turned off by Compass as harmful (Safe Browsing's blocklist).
  int32 blocklisted_extensions;
  int32 enabled_extensions;
};

// Advanced › About Compass.
struct AboutInfo {
  // Compass's own ("20261121.1830"), and the Chromium it's built on.
  string compass_version;
  string chromium_version;
  // Whether this build updates itself (release builds).
  bool can_update;
  // An update downloaded and waiting for a relaunch.
  string? pending_version;
};

// Where an update check is (compass::updates::CheckStatus).
enum UpdateState {
  kChecking,
  kUpdating,
  kReady,
  kUpToDate,
  kFailed,
};

// The settings window (chrome://compass-settings in a window of its own,
// docs/design/settings-window.md): the page's side.
interface SettingsWindowPage {
  // An update check moved on: |progress| 0-100 (or -1) while updating,
  // |message| why it failed.
  UpdateStatusChanged(UpdateState state, int32 progress, string message);
  // Passwords were saved, changed or removed.
  PasswordsChanged();
  // Payment cards or addresses changed.
  AutofillChanged();
  // A permission's default or a site's permission changed.
  ContentSettingsChanged();
  DefaultBrowserChanged(DefaultBrowserState state);
  SearchEnginesChanged(SearchEngines engines);
  // The preferred languages or their translation changed.
  LanguagesChanged();
  // A profile was added, removed or renamed, or its spaces changed.
  ProfilesChanged(array<ProfileDetails> profiles);
  // A space of any profile was added, removed, moved or changed.
  SpacesChanged(array<Space> spaces, array<ProfileOption> profiles);
  // One of the prefs the page asked for changed (by the page or elsewhere).
  PrefChanged(SettingsPref pref);
  // Shows |path| ("boosts?add=example.com", "sync"), as opening the window
  // at it does; the window was open already.
  ShowPath(string path);
  // The profile's active space changed color; null for grey.
  SetAccent(SpaceColor? color);
  // The ad blocker's lists, their downloads or its switch changed.
  FilterListsChanged();
};

// The settings window's browser side.
interface SettingsWindowHandler {
  // The profile's active space's color, which the page uses as its accent;
  // null for grey.
  GetAccent() => (SpaceColor? color);
  // The height the page needs (its toolbar and the shown pane, in CSS
  // pixels): the window takes it, within the screen.
  SetContentHeight(int32 height);
  // Opens |url| (a chrome:// page such as the password manager) in a tab of
  // the last active window.
  OpenUrl(url.mojom.Url url);
  // Closes the window.
  Close();

  // The allowlisted prefs among |names|, which PrefChanged() then follows.
  GetPrefs(array<string> names) => (array<SettingsPref> prefs);
  // Sets an allowlisted pref to |value_json| (of its type); false if it isn't
  // one, isn't of the type, or is enforced.
  SetPref(string name, string value_json) => (bool ok);
  // The default page zoom, as a factor (1.0 = 100%).
  GetDefaultZoom() => (double factor);
  SetDefaultZoom(double factor);
  // Restarts the browser, for prefs that take effect then (hardware
  // acceleration).
  Relaunch();

  // General (phase 2): what upstream's settings handlers do, over Mojo.
  GetDefaultBrowser() => (DefaultBrowserState state);
  // Asks the system to make Compass the default; DefaultBrowserChanged()
  // follows.
  SetAsDefaultBrowser();
  GetSearchEngines() => (SearchEngines engines);
  SetDefaultSearchEngine(string id);
  // Manage search engines (phase 5b): every engine and site search.
  GetSearchEngineDetails() => (array<SearchEngineDetails> engines);
  // Adds one (an empty |id|) or edits one; |url| has %s for the query. Why
  // not, if it wasn't saved: empty when saved.
  SaveSearchEngine(string id, string name, string keyword, string url) =>
      (string error);
  RemoveSearchEngine(string id);
  SetSearchEngineActive(string id, bool active);
  // General › Languages (phase 5c), as TranslatePrefs keeps them.
  GetLanguages() =>
      (array<LanguageInfo> catalog, array<PreferredLanguage> preferred);
  AddLanguage(string code);
  RemoveLanguage(string code);
  // One place up or down the list.
  MoveLanguage(string code, bool up);
  SetTranslateOffered(string code, bool offered);
  // The download folder as shown ("~/Downloads").
  GetDownloadLocation() => (string location);
  // A folder picker for the download folder; the pref changes if one is
  // picked.
  ChooseDownloadLocation();
  // The system's font families: each [name, display name].
  GetFonts() => (array<array<string>> fonts);
  // The system's proxy settings.
  ShowProxySettings();

  // Profiles: every profile, the window's own or not. Profiles are named by
  // their directory's name (ProfileDetails::id).
  GetProfiles() => (array<ProfileDetails> profiles);
  SetProfileName(string profile_id, string name);
  // A new profile, with a space of its own in the switcher.
  CreateProfile();
  // Deletes a profile, its spaces and data. Not the last one.
  DeleteProfile(string profile_id);

  // Spaces: every profile's, in the switcher's order. The edits are those of
  // the sidebar's space menu (PageHandler's), on any profile's space.
  GetSpaces() => (array<Space> spaces, array<ProfileOption> profiles);
  // A new space at the end of the profile's.
  AddSpace(string profile_id);
  RenameSpace(string id, string name);
  SetSpaceColor(string id, SpaceColor? color);
  SetSpaceGradient(string id, array<SpaceColor> gradient);
  SetSpaceIntensity(string id, double intensity);
  SetSpaceGrain(string id, double grain);
  SetSpaceAppearance(string id, SpaceAppearance appearance);
  SetSpaceIcon(string id, SpaceIcon? icon);
  // To another profile, or a new one (null).
  SetSpaceProfile(string id, string? profile_id);
  SetArchiveAfter(string space_id, uint32 hours);
  SetSpaceSynced(string space_id, bool synced);
  // Not the last space of all.
  DeleteSpace(string id);
  // To |index| in the switcher's order (SpaceDirectory::MoveSpace()).
  MoveSpace(string id, uint32 index);
  // Saves the space with |space_id|, or every space with the favorites
  // when it's null, as a bookmarks file the user picks
  // (docs/design/spaces.md, "Export").
  ExportSpaces(string? space_id);

  // Privacy (phase 3). Site settings: the defaults, the sites with
  // permissions of their own, and one site's.
  GetPermissionDefaults() => (array<PermissionDefault> defaults);
  SetPermissionDefault(string type, PermissionValue value);
  GetSites() => (array<SiteSummary> sites);
  GetSitePermissions(string origin) =>
      (string display_name, array<SitePermission> permissions);
  SetSitePermission(string origin, string type, PermissionValue value);
  // Every permission of the site back to the default.
  ResetSitePermissions(string origin);
  // The site's cookies, storage and cache.
  ClearSiteData(string origin) => ();
  ClearBrowsingData(ClearBrowsingDataOptions options) => ();
  // Safe Browsing: 0 off, 1 standard, 2 enhanced (SafeBrowsingState).
  SetSafeBrowsingLevel(int32 level);
  GetSafetyCheck() => (SafetyCheckResult result);
  // The ad blocker's lists (its switch is the Local State pref
  // compass.adblock.enabled). FilterListsChanged() follows changes.
  GetFilterLists() => (array<FilterList> lists);
  SetFilterListEnabled(string id, bool enabled);
  // Adds the list at |url| (https): why not, empty when added.
  AddFilterList(string url) => (string error);
  // Removes a list the user added.
  RemoveFilterList(string id);
  // Asks every enabled list's server for a newer copy now.
  UpdateFilterListsNow();

  // Passwords (phase 4), through upstream's PasswordsPrivateDelegate.
  GetPasswords() => (array<SavedPassword> passwords);
  // The password, once the user has authenticated to the system (Touch ID,
  // the account password); null if they didn't.
  RevealPassword(int32 id) => (string? password);
  // Copies the password, once authenticated; it's cleared from the
  // clipboard after a while. Whether it was copied.
  CopyPassword(int32 id) => (bool copied);
  RemovePassword(int32 id);
  GetCards() => (array<SavedCard> cards);
  RemoveCard(string guid);
  GetAddresses() => (array<SavedAddress> addresses);
  RemoveAddress(string guid);
  // The card and address editors (phase 5d). A saved card or address as a
  // draft to edit; null if there's none (or it's an account card).
  GetCard(string guid) => (CardDraft? card);
  // Saves a draft: why not, empty when saved.
  SaveCard(CardDraft card) => (string error);
  GetAddress(string guid) => (AddressDraft? address);
  SaveAddress(AddressDraft address) => (string error);

  // Advanced (phase 5).
  GetAbout() => (AboutInfo about);
  // Checks for an update now; UpdateStatusChanged() follows.
  CheckForUpdates();
  // Installs a downloaded update and relaunches.
  InstallUpdate();
  // Puts upstream's settings back to their defaults (ProfileResetter, as
  // chrome://settings/reset does).
  ResetSettings() => ();
};

interface SettingsWindowHandlerFactory {
  CreateHandler(pending_remote<SettingsWindowPage> page,
                pending_receiver<SettingsWindowHandler> handler);
};
