module strata.sidebar.mojom;

import "url/mojom/url.mojom";

// Mirrors strata::SidebarNode::Type.
enum NodeType {
  kRoot,
  kFolder,
  kTab,
  kSplit,
};

// One entry of the window's SpaceModel, with its subtree.
struct Node {
  // The node's UUID. Stable for its lifetime.
  string id;
  NodeType type;
  string title;
  // The name the user gave a tab, shown instead of its title. Empty if none.
  string custom_title;
  url.mojom.Url url;
  // Whether a tab node has a tab in this window. Pinned tab nodes can be
  // unloaded; Today's are always live.
  bool live;
  // Whether a folder shows only its own row. The same in every window.
  bool collapsed;
  array<Node> children;
};

struct Tree {
  // The profile's favorites, the same in every space: a root of tabs.
  Node favorites;
  Node pinned;
  Node today;
  // The node of the window's active tab, if it has one.
  string? active_id;
};

// Bootstraps the connection; called once by the page.
interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Mirrors strata::SpaceColor.
enum SpaceColor {
  kGrey,
  kBlue,
  kPurple,
  kPink,
  kRed,
  kOrange,
  kYellow,
  kGreen,
};

// A space, as the switcher shows it.
struct Space {
  string id;
  string name;
  SpaceColor color;
  // How long a Today entry may go unseen before it's archived; 0 for never.
  uint32 archive_after_hours;
  // The profile it belongs to: its ID (as ProfileOption's) and name.
  string profile_id;
  string profile_name;
  // Whether it belongs to the window's profile. Entries can't move to the
  // others, and switching to one swaps the window (docs/design/spaces.md,
  // slice 3).
  bool own_profile;
};

// A profile a space can be assigned to.
struct ProfileOption {
  // Its directory's name.
  string id;
  string name;
};

struct ArchivedTab {
  string title;
  url.mojom.Url url;
};

// An archived Today entry: a tab, or a split's panes.
struct ArchivedEntry {
  // Stable for the session only.
  string id;
  array<ArchivedTab> tabs;
  // Milliseconds since the Unix epoch, as JS Date takes them.
  double archived_at;
};

// Browser-side handler for requests from chrome://strata-sidebar.
interface PageHandler {
  // Answered with Page.SetSpaces(), Page.SetTree() and Page.SetArchive(), on
  // the same pipe as the diffs, so the page sees them in order.
  RequestTree();
  // The page has taken the tree of Page.SetTree(); sent after each one.
  TreeShown();
  // Activates a tab node's tab, opening one if the node is unloaded. Ignored
  // for other nodes.
  ActivateNode(string id);
  // Closes a tab node's tab, or every pane's of a split. Tabs close through
  // the tab strip, so beforeunload can cancel. When the tab is gone, a Today
  // node goes with it and a pinned node stays, unloaded. An unloaded node is
  // removed.
  CloseNode(string id);
  // Opens the command bar for a new entry (docs/design/command-bar.md).
  NewTab();

  // Drag and drop. |index| is the slot among |new_parent_id|'s current
  // children, counted with the node still in place. Invalid moves are
  // ignored. Moving a tab entry into the favorites root makes it a favorite,
  // and moving a favorite into the window's space makes it an entry there.
  MoveNode(string id, string new_parent_id, uint32 index);
  // A link dropped on the sidebar: a new entry for |url| at the slot |index|
  // among |parent_id|'s children, opened in the foreground. Only http(s) and
  // file URLs, and only where a tab can go.
  OpenLink(url.mojom.Url url, string parent_id, uint32 index);
  // Folders live in the pinned section; other parents are ignored.
  AddFolder(string parent_id, uint32 index, string title);
  RenameFolder(string id, string title);
  // Names a tab (a pane too); an empty or blank name goes back to the page's
  // title.
  RenameTab(string id, string title);
  // Collapses or expands a folder, in every window. Saved.
  SetFolderCollapsed(string id, bool collapsed);
  // Removes a folder, a pinned entry or a favorite and its subtree, closing
  // live tabs.
  DeleteNode(string id);

  // Shows another space in this window; the page then gets its tree. A space
  // of another profile swaps the window instead: this page closes with it.
  SwitchSpace(string id);
  // Adds a space at the end and switches to it.
  AddSpace();
  // Empty names are ignored.
  RenameSpace(string id, string name);
  SetSpaceColor(string id, SpaceColor color);
  // Assigns a space to profile |profile_id|, or to a new profile if null: its
  // entries go along, its open tabs reload there (docs/design/spaces.md,
  // "Assigning a profile").
  SetSpaceProfile(string id, string? profile_id);
  // Deletes a space with its entries and tabs, unless it's the last one.
  // Windows showing it switch to its neighbor first.
  DeleteSpace(string id);
  // Moves a space in the switcher's list, in every window. |index| is the
  // slot among the spaces SetSpaces() sent, counted with it still in place.
  MoveSpace(string id, uint32 index);
  // Moves an entry and its subtree, with its live tabs, to another space: to
  // the end of the same section there.
  MoveNodeToSpace(string id, string space_id);
  // Space |id|'s pinned and Today entries, for a swipe to show before it
  // switches (docs/design/spaces.md, "Swiping"), with the entry the switch
  // would show as its active one. Null for an unknown space.
  GetSpaceTree(string id) => (Tree? tree);
  // A swipe is pulling in space |id|, |progress| (0 to 1) of the way: the
  // sidebar's tint blends toward its color. Null ends the swipe without
  // switching, and the tint fades back. SwitchSpace() ends it too.
  PreviewSpace(string? id, double progress);
  // 0 turns auto-archive off for the space. At most a year.
  SetArchiveAfter(string space_id, uint32 hours);

  // The window's space's archive. Restoring puts the entry back at the end of
  // Today and opens it in the foreground.
  RestoreArchived(string id);
  RemoveArchived(string id);
  ClearArchive();

  // The pointer rests on tab node |id|'s row, which spans |row_top| to
  // |row_top| + |row_height| in the page: shows its hover card next to it, or
  // moves the card there. Other nodes hide the card.
  ShowHoverCard(string id, int32 row_top, int32 row_height);
  HideHoverCard();

  // The page was right-clicked on node |id|'s row or tile, at |x|, |y| in the
  // page: shows the node's context menu there (docs/design/sidebar.md,
  // "Context menus").
  ShowContextMenu(string id, int32 x, int32 y);
};

// Implemented by the page; the browser pushes the model's changes through it,
// in the order the model made them.
interface Page {
  // The switcher's spaces, of every profile (only the profile's own in an
  // off-the-record window), the one this window shows, and the profiles a
  // space can be assigned to (none off the record). Sent before the tree,
  // and whenever they change.
  SetSpaces(array<Space> spaces, string active_id,
            array<ProfileOption> profiles);
  // The whole tree. Replaces whatever the page had.
  SetTree(Tree tree);
  NodeAdded(string parent_id, uint32 index, Node node);
  // |index| is counted after the node left its old parent.
  NodeMoved(string id, string new_parent_id, uint32 index);
  NodeChanged(string id, string title, string custom_title, url.mojom.Url url,
              bool collapsed);
  NodeRemoved(string id);
  NodeLiveChanged(string id, bool live);
  ActiveNodeChanged(string? id);
  // The window's space's archived entries, most recent first. Sent after the
  // tree, and whenever they change.
  SetArchive(array<ArchivedEntry> entries);
  // Rename was chosen in folder |id|'s context menu: shows its name for
  // editing, as a double-click does.
  StartRename(string id);
};

// Browser-side handler for chrome://strata-placeholder, the tab a window shows
// for a tab that moved to another window.
interface PlaceholderHandler {
  // The tab the placeholder stands for.
  GetInfo() => (string title, url.mojom.Url url);
  // A data: URL of a screenshot of the tab, taken as it left. Answers once
  // it's encoded; empty if there's none.
  GetSnapshot() => (string data_url);
  // Moves that tab back into the placeholder's window, replacing it.
  BringHere();
};
