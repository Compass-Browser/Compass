module compass.sidebar.mojom;

import "url/mojom/url.mojom";

// Mirrors compass::SidebarNode::Type.
enum NodeType {
  kRoot,
  kFolder,
  kTab,
  kSplit,
};

// What a tab node's tab sounds like (compass::LiveTabRegistry::AudioState):
// the sidebar shows a speaker on a tab that plays sound, crossed out on a
// muted one.
// Of Page.Swipe().
enum SwipePhase {
  kBegin,
  kUpdate,
  kEnd,
};

enum AudioState {
  kNone,
  kAudible,
  kMuted,
};

// One entry of the window's SpaceModel, with its subtree.
struct Node {
  // The node's UUID. Stable for its lifetime.
  string id;
  NodeType type;
  string title;
  // The name the user gave a tab, shown instead of its title. Empty if none.
  string custom_title;
  url.mojom.Url url;
  // Whether a tab node has a tab in this window. Pinned tab nodes can be
  // unloaded; Today's are always live.
  bool live;
  // A live tab's sound; kNone for other nodes.
  AudioState audio;
  // Whether a folder shows only its own row. The same in every window.
  bool collapsed;
  array<Node> children;
};

struct Tree {
  // The profile's favorites, the same in every space: a root of tabs.
  Node favorites;
  Node pinned;
  Node today;
  // The node of the window's active tab, if it has one.
  string? active_id;
};

// A tab playing media (or paused) that the window doesn't show: the sidebar
// shows a "now playing" widget for it above the spaces, as Arc does
// (docs/design/sidebar.md, "Now playing").
struct NowPlaying {
  // Stable while it shows.
  string id;
  // The media's title: the page's, unless the site gives one.
  string title;
  // The tab's page, for its favicon.
  url.mojom.Url url;
  bool playing;
  bool muted;
  // False while muted: Chromium takes a muted tab's players out of its media
  // session, so only the speaker (unmute) works.
  bool can_play_pause;
  bool can_previous;
  bool can_next;
  bool can_picture_in_picture;
};

// What a now playing widget's buttons do.
enum NowPlayingAction {
  kPlay,
  kPause,
  kPreviousTrack,
  kNextTrack,
  kPictureInPicture,
  kMute,
  kUnmute,
  // Pauses it and hides the widget until it plays again.
  kDismiss,
  // Shows its tab, switching space if it's another space's.
  kShowTab,
};

// Bootstraps the connection; called once by the page.
interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// A space's color (compass::SpaceColor): a palette color or any other. Null
// stands for grey, which leaves the sidebar untinted.
struct SpaceColor {
  uint8 red;
  uint8 green;
  uint8 blue;
};

// A space's icon (compass::SpaceIcon). A space without one is shown by its
// name's first letter.
union SpaceIcon {
  string emoji;
  // A name from the page's SPACE_SYMBOLS (space_icons.ts).
  string symbol;
};

// Mirrors compass::SpaceAppearance.
enum SpaceAppearance { kAuto, kLight, kDark };

// A space, as the switcher shows it.
struct Space {
  string id;
  string name;
  SpaceColor? color;
  // The colors the sidebar's gradient goes on to after |color|; empty for a
  // plain color (compass::SpaceModel::gradient()).
  array<SpaceColor> gradient;
  // How strong the tint is and how much grain it has, 0 to 1.
  double intensity;
  double grain;
  SpaceAppearance appearance;
  SpaceIcon? icon;
  // How long a Today entry may go unseen before it's archived; 0 for never.
  uint32 archive_after_hours;
  // The profile it belongs to: its ID (as ProfileOption's) and name.
  string profile_id;
  string profile_name;
  // Whether it belongs to the window's profile. Entries can't move to the
  // others, and switching to one swaps the window (docs/design/spaces.md,
  // slice 3).
  bool own_profile;
};

// A profile a space can be assigned to.
struct ProfileOption {
  // Its directory's name.
  string id;
  string name;
};

struct ArchivedTab {
  string title;
  url.mojom.Url url;
};

// An archived Today entry: a tab, or a split's panes.
struct ArchivedEntry {
  // Stable for the session only.
  string id;
  array<ArchivedTab> tabs;
  // Milliseconds since the Unix epoch, as JS Date takes them.
  double archived_at;
};

// Browser-side handler for requests from chrome://compass-sidebar.
interface PageHandler {
  // Answered with Page.SetSpaces(), Page.SetTree() and Page.SetArchive(), on
  // the same pipe as the diffs, so the page sees them in order.
  RequestTree();
  // The page has taken the tree of Page.SetTree(); sent after each one.
  TreeShown();
  // Activates a tab node's tab, opening one if the node is unloaded. Ignored
  // for other nodes.
  ActivateNode(string id);
  // Closes a tab node's tab, or every pane's of a split. Tabs close through
  // the tab strip, so beforeunload can cancel. When the tab is gone, a Today
  // node goes with it and a pinned node stays, unloaded. An unloaded node is
  // removed.
  CloseNode(string id);
  // Closes every Today tab, in folders and splits too, as CloseNode() does
  // each (beforeunload can keep one), and removes the folders left without
  // a tab. The Today header's Clear button.
  ClearToday();
  // Opens the command bar for a new entry (docs/design/command-bar.md).
  NewTab();
  // Mutes or unmutes a tab node's live tab: its speaker was clicked.
  // Ignored for other nodes.
  SetNodeMuted(string id, bool muted);

  // Drag and drop. |index| is the slot among |new_parent_id|'s current
  // children, counted with the node still in place. Invalid moves are
  // ignored. Moving a tab entry into the favorites root makes it a favorite,
  // and moving a favorite into the window's space makes it an entry there.
  MoveNode(string id, string new_parent_id, uint32 index);
  // A tab dropped on another tab: they show side by side, |id| on the left
  // if |first|, else on the right. Ignored where SpaceModel::CanSplit() says
  // no.
  SplitNode(string id, string target_id, bool first);
  // A link dropped on the sidebar: a new entry for |url| at the slot |index|
  // among |parent_id|'s children, opened in the foreground. Only http(s) and
  // file URLs, and only where a tab can go.
  OpenLink(url.mojom.Url url, string parent_id, uint32 index);
  // In Pinned or Today, at the top or in a folder; other parents are ignored.
  AddFolder(string parent_id, uint32 index, string title);
  RenameFolder(string id, string title);
  // Names a tab (a pane too); an empty or blank name goes back to the page's
  // title.
  RenameTab(string id, string title);
  // Collapses or expands a folder, in every window. Saved.
  SetFolderCollapsed(string id, bool collapsed);
  // Removes a folder (Pinned or Today), a pinned entry or a favorite and its
  // subtree, closing live tabs.
  DeleteNode(string id);

  // Shows another space in this window; the page then gets its tree. A space
  // of another profile swaps the window instead: this page closes with it.
  SwitchSpace(string id);
  // Adds a space at the end and switches to it.
  AddSpace();
  // Empty names are ignored.
  RenameSpace(string id, string name);
  // Null makes it grey.
  SetSpaceColor(string id, SpaceColor? color);
  // At most 2; ignored for a grey space.
  SetSpaceGradient(string id, array<SpaceColor> gradient);
  // 0 to 1, clamped.
  SetSpaceIntensity(string id, double intensity);
  SetSpaceGrain(string id, double grain);
  SetSpaceAppearance(string id, SpaceAppearance appearance);
  // Null removes it. Invalid ones (compass::SpaceIcon) are ignored.
  SetSpaceIcon(string id, SpaceIcon? icon);
  // Assigns a space to profile |profile_id|, or to a new profile if null: its
  // entries go along, its open tabs reload there (docs/design/spaces.md,
  // "Assigning a profile").
  SetSpaceProfile(string id, string? profile_id);
  // Deletes a space with its entries and tabs, unless it's the last one.
  // Windows showing it switch to its neighbor first.
  DeleteSpace(string id);
  // Moves a space in the switcher's list, in every window. |index| is the
  // slot among the spaces SetSpaces() sent, counted with it still in place.
  MoveSpace(string id, uint32 index);
  // Moves an entry and its subtree, with its live tabs, to another space: to
  // the end of the same section there.
  MoveNodeToSpace(string id, string space_id);
  // Space |id|'s pinned and Today entries, for a swipe to show before it
  // switches (docs/design/spaces.md, "Swiping"), with the entry the switch
  // would show as its active one. Null for an unknown space.
  GetSpaceTree(string id) => (Tree? tree);
  // A swipe is pulling in space |id|, |progress| (0 to 1) of the way: the
  // sidebar's tint blends toward its color. Null ends the swipe without
  // switching, and the tint fades back. SwitchSpace() ends it too.
  PreviewSpace(string? id, double progress);
  // 0 turns auto-archive off for the space. At most a year.
  SetArchiveAfter(string space_id, uint32 hours);

  // The window's space's archive. Restoring puts the entry back at the end of
  // Today and opens it in the foreground.
  RestoreArchived(string id);
  RemoveArchived(string id);
  ClearArchive();

  // The pointer rests on tab node |id|'s row, which spans |row_top| to
  // |row_top| + |row_height| in the page: shows its hover card next to it, or
  // moves the card there. Other nodes hide the card.
  ShowHoverCard(string id, int32 row_top, int32 row_height);
  HideHoverCard();

  // The page was right-clicked on node |id|'s row or tile, at |x|, |y| in the
  // page: shows the node's context menu there (docs/design/sidebar.md,
  // "Context menus").
  ShowContextMenu(string id, int32 x, int32 y);

  // A now playing widget's button. Ignored for a widget that's gone.
  ActOnNowPlaying(string id, NowPlayingAction action);
};

// Implemented by the page; the browser pushes the model's changes through it,
// in the order the model made them.
interface Page {
  // The switcher's spaces, of every profile (only the profile's own in an
  // off-the-record window), the one this window shows, and the profiles a
  // space can be assigned to (none off the record). Sent before the tree,
  // and whenever they change.
  SetSpaces(array<Space> spaces, string active_id,
            array<ProfileOption> profiles);
  // The whole tree. Replaces whatever the page had.
  SetTree(Tree tree);
  NodeAdded(string parent_id, uint32 index, Node node);
  // |index| is counted after the node left its old parent.
  NodeMoved(string id, string new_parent_id, uint32 index);
  NodeChanged(string id, string title, string custom_title, url.mojom.Url url,
              bool collapsed);
  NodeRemoved(string id);
  NodeLiveChanged(string id, bool live);
  NodeAudioChanged(string id, AudioState audio);
  ActiveNodeChanged(string? id);
  // The window's space's archived entries, most recent first. Sent after the
  // tree, and whenever they change.
  SetArchive(array<ArchivedEntry> entries);
  // Rename was chosen in folder |id|'s context menu: shows its name for
  // editing, as a double-click does.
  StartRename(string id);
  // The window's now playing widgets, top to bottom. Sent after the tree, and
  // whenever they change.
  SetNowPlaying(array<NowPlaying> items);
  // A two-finger swipe across the sidebar (docs/design/spaces.md,
  // "Swiping"), told by the browser so vertical scrolls never wait on the
  // page: kBegin, then kUpdate with how far the fingers moved right since
  // the last one (CSS pixels, momentum included), then kEnd.
  Swipe(SwipePhase phase, float delta_x);
};

// Browser-side handler for chrome://compass-placeholder, the tab a window shows
// for a tab that moved to another window.
interface PlaceholderHandler {
  // The tab the placeholder stands for.
  GetInfo() => (string title, url.mojom.Url url);
  // A data: URL of a screenshot of the tab, taken as it left. Answers once
  // it's encoded; empty if there's none.
  GetSnapshot() => (string data_url);
  // Moves that tab back into the placeholder's window, replacing it.
  BringHere();
};

// Browser-side handler for chrome://compass-empty, what a window with nothing
// else to show shows.
interface EmptyPageHandler {
  // Opens the window's command bar, unless it's open. A window without one
  // loads the new tab page instead.
  ShowCommandBar();

  // Sends the page its window's space's tint now and whenever it changes.
  SetPage(pending_remote<EmptyPage> page);
};

// chrome://compass-empty, as its handler sees it.
interface EmptyPage {
  // What the pane paints over the frame color, as Arc paints an empty pane:
  // three evenly spaced stops from the top left corner to the bottom right
  // one, ARGB (all transparent for a grey space), and the grain's opacity.
  SetTint(array<uint32> stops, float grain_opacity);
};

// An Arc space chrome://compass-import offers.
struct ArcImportSpace {
  // Arc's space ID.
  string id;
  string name;
  // Tabs in its Pinned and Today.
  int32 tab_count;
  // Entries of its archive that come along (the newest, at most 100).
  int32 archived_count;
  // Brought in already.
  bool imported;
};

// An Arc profile chrome://compass-import offers (docs/design/arc-import.md).
struct ArcImportProfile {
  // Its folder in Arc ("Default", "Profile 1", ...).
  string dir;
  string name;
  // Its spaces, in Arc's order.
  array<ArcImportSpace> spaces;
  // Tabs in its spaces and favorites.
  int32 tab_count;
  // Imported already: a Compass profile came from it. Its newer spaces can
  // still be brought in.
  bool imported;
};

struct ArcImportState {
  // Arc's sidebar was found and read.
  bool found;
  // Arc is open (its databases are in use; it must be quit first).
  bool arc_running;
  array<ArcImportProfile> profiles;
};

// Browser-side handler for chrome://compass-import: importing from Arc.
interface ArcImportHandler {
  GetState() => (ArcImportState state);
  // Asks Arc to quit; answers once it has, or false after a few seconds.
  QuitArc() => (bool quit);
  // Imports the Arc profiles |profiles| (folders) as new Compass profiles:
  // cookies, history, passwords, settings, extensions, favorites, and those
  // of |spaces| (Arc space IDs) that are theirs. Spaces of profiles imported
  // before go into the Compass profile each became. macOS asks whether
  // Compass may use Arc's Keychain key. Answers with the names of the
  // profiles made and of those that got spaces, and the Arc profiles
  // (folders) that failed.
  Import(array<string> profiles, array<string> spaces)
      => (array<string> imported, array<string> updated,
          array<string> failed);
  // Shows the first imported space in this window.
  OpenImported();
};

// One shortcut on chrome://compass-settings (docs/design/shortcuts.md
// "Customizing").
struct Shortcut {
  // Its key in the "compass.shortcuts" pref ("copy-url", "space-1").
  string id;
  string section;
  string label;
  // Its keys in force, as menus show them (with the modifier symbols on
  // macOS); empty: none.
  array<string> keys;
  // Its keys as Compass ships them.
  array<string> default_keys;
  // The user changed it (keys or none).
  bool customized;
};

// Keys pressed on the settings page, from a keydown event.
struct ShortcutKeys {
  // KeyboardEvent.keyCode: a ui::KeyboardCode.
  int32 key_code;
  bool shift;
  bool ctrl;
  bool alt;
  bool meta;
};

// What giving a shortcut some keys would do.
struct ShortcutCheck {
  // The keys, as menus show them.
  string text;
  // Why they can't be used; empty if they can.
  string error;
  // A listed shortcut that has them now, which taking them leaves with none.
  // Empty if none.
  string conflict_id;
  string conflict_label;
};

// Browser-side handler for chrome://compass-settings.
interface SettingsHandler {
  GetShortcuts() => (array<Shortcut> shortcuts);
  // While the page records keys, the browser's shortcuts don't run, so the
  // keys reach it.
  SetRecording(bool recording);
  CheckShortcut(string id, ShortcutKeys keys) => (ShortcutCheck check);
  // Gives |id| the keys, taking them from the shortcut that had them (see
  // ShortcutCheck). Does nothing if they can't be used.
  SetShortcut(string id, ShortcutKeys keys) => ();
  // Leaves |id| without a shortcut.
  RemoveShortcut(string id) => ();
  // Back to the keys Compass ships.
  ResetShortcut(string id) => ();
  ResetAllShortcuts() => ();
};
