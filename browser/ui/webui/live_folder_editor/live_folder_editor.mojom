// chrome://compass-live-folder-editor/?parent=<id> or ?folder=<id>: New Live
// Folder… (pick a plugin, then fill in its form) and Edit Source…, with
// installing and removing plugins, in a bubble beside the sidebar
// (docs/design/live-folders.md, "UI").
module compass.live_folder_editor.mojom;

import "compass/browser/ui/webui/bubble/bubble.mojom";
import "compass/browser/ui/webui/sidebar/sidebar.mojom";

interface PageHandlerFactory {
  CreatePageHandler(pending_receiver<PageHandler> handler);
};

interface PageHandler {
  // What the bubble was opened for: a new folder in |parent_id|, or folder
  // |folder_id|.
  GetTarget() => (string? parent_id, string? folder_id);
  // The plugins New Live Folder offers.
  GetLivePlugins() => (array<compass.sidebar.mojom.LivePlugin> plugins);
  // Live folder |id|'s source; null if it isn't one.
  GetLiveFolderSource(string id)
      => (compass.sidebar.mojom.LiveFolderSource? source);
  // Makes or changes a live folder; answers an error for the user, or empty.
  SaveLiveFolder(compass.sidebar.mojom.LiveFolderEdit edit) => (string error);
  // Fetches the plugin whose manifest is at |url| for review: null and an
  // error for the user if it can't.
  PreviewLivePlugin(string url)
      => (compass.sidebar.mojom.LivePluginPreview? preview, string error);
  // Installs it if it's still the reviewed one (|sha256|); answers an
  // error, or empty.
  InstallLivePlugin(string url, string sha256) => (string error);
  RemoveLivePlugin(string id) => ();
  // Shows <user data>/Compass Plugins (made if need be) in the file manager:
  // a folder put there with a manifest.json is a local plugin.
  OpenLivePluginsFolder();

  GetLook() => (compass.bubble.mojom.Look look);
  // The editor is drawn: the bubble shows (it's hidden until then).
  ShowUI();
  // Closes the bubble.
  Close();
};
