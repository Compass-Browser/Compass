# Strata's browser UI. Linked into //chrome/browser/ui, which also allows our
# includes of its headers (see patches/chrome-browser-ui-BUILD.gn.patch), the
# same way upstream does for //chrome/browser/ui/webui/tab_search.
source_set("ui") {
  sources = [
    "views/command_bar/command_bar.cc",
    "views/command_bar/command_bar.h",
    "views/frame/browser_view_exchange.cc",
    "views/frame/browser_view_exchange.h",
    "views/frame/window_frame.cc",
    "views/frame/window_frame.h",
    "views/sidebar/sidebar_context_menu.cc",
    "views/sidebar/sidebar_context_menu.h",
    "views/sidebar/sidebar_header.cc",
    "views/sidebar/sidebar_header.h",
    "views/sidebar/sidebar_hover_card.cc",
    "views/sidebar/sidebar_hover_card.h",
    "views/sidebar/sidebar_swap.cc",
    "views/sidebar/sidebar_swap.h",
    "views/sidebar/sidebar_tint.cc",
    "views/sidebar/sidebar_tint.h",
    "views/sidebar/strata_sidebar_view.cc",
    "views/sidebar/strata_sidebar_view.h",
    "webui/command_bar/command_bar_page_handler.cc",
    "webui/command_bar/command_bar_page_handler.h",
    "webui/command_bar/command_bar_ui.cc",
    "webui/command_bar/command_bar_ui.h",
    "webui/placeholder/strata_placeholder_ui.cc",
    "webui/placeholder/strata_placeholder_ui.h",
    "webui/sidebar/sidebar_page_handler.cc",
    "webui/sidebar/sidebar_page_handler.h",
    "webui/sidebar/strata_favicon_source.cc",
    "webui/sidebar/strata_favicon_source.h",
    "webui/sidebar/strata_sidebar_ui.cc",
    "webui/sidebar/strata_sidebar_ui.h",
    "webui/strata_web_ui_registry.cc",
    "webui/strata_web_ui_registry.h",
  ]
  public_deps = [
    "//chrome/browser:browser_public_dependencies",
    "//strata/browser/ui/webui/command_bar:mojo_bindings",
    "//strata/browser/ui/webui/sidebar:mojo_bindings",

    # BrowserView's close hook calls into it (see patches/).
    "//strata/browser/window_sync",

    # The vertical tab strip region's header reads it (see patches/).
    "//strata/browser/ui/views/frame:content_frame",
  ]
  deps = [
    "//base",
    "//base:i18n",
    "//chrome/app:command_ids",
    "//chrome/app:generated_resources",
    "//chrome/browser:browser_process",
    "//chrome/browser/autocomplete",
    "//chrome/browser/predictors",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui:browser_content_setting_bubble_model_delegate",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui:view_ids",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/thumbnails",
    "//chrome/browser/ui/views/bubble",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/browser/ui/views/frame:themed_background",
    "//chrome/browser/ui/views/location_bar",
    "//chrome/browser/ui/views/location_bar:icon_label_bubble",
    "//chrome/browser/ui/views/page_info",
    "//chrome/browser/ui/views/tabs/hovercard",
    "//chrome/browser/ui/views/tabs/shared",
    "//chrome/browser/ui/views/tabs/vertical",
    "//chrome/browser/ui/views/toolbar",
    "//chrome/browser/ui/views/web_apps/frame_toolbar:web_app_content_settings_container",
    "//chrome/browser/ui/webui:favicon_source",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/browser/ui/webui/top_chrome",
    "//chrome/common",
    "//components/favicon_base",
    "//components/omnibox/browser",
    "//components/prefs",
    "//components/security_state/core",
    "//components/sessions",
    "//components/tabs:public",
    "//components/url_formatter",
    "//content/public/browser",
    "//strata/resources/sidebar:resources",
    "//skia",
    "//ui/base",
    "//ui/base/clipboard",
    "//ui/base/mojom:ui_base_types",
    "//ui/events",
    "//ui/events:events_base",
    "//ui/gfx/geometry",
    "//ui/menus",
    "//ui/views",
    "//ui/views/controls/webview",
    "//ui/webui",
    "//url",
  ]
  if (is_mac) {
    sources += [
      "views/frame/browser_view_exchange_mac.mm",
      "views/frame/window_frame_mac.mm",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "views/sidebar/sidebar_header_unittest.cc",
    "webui/command_bar/command_bar_page_handler_unittest.cc",
    "webui/sidebar/sidebar_page_handler_unittest.cc",
  ]
  deps = [
    ":ui",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/autocomplete",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//chrome/test/base:browser_with_test_window_test",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//strata/browser/sidebar",
    "//strata/browser/window_sync",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base/clipboard",
    "//ui/base/clipboard:clipboard_test_support",
    "//ui/menus",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "views/command_bar/command_bar_browsertest.cc",
    "views/frame/profile_switch_browsertest.cc",
    "views/sidebar/sidebar_header_browsertest.cc",
    "views/sidebar/strata_sidebar_browsertest.cc",
  ]
  deps = [
    ":ui",
    "//base",
    "//base/test:test_support",
    "//chrome/app:command_ids",
    "//chrome/browser/extensions:test_support",
    "//chrome/browser/profiles:profile_test_util",
    "//components/constrained_window",
    "//extensions:test_support",
    "//extensions/common",
    "//chrome/browser/ui",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/browser/ui/views/frame:multi_contents_view",
    "//chrome/browser/ui/views/frame:top_container_view",
    "//chrome/browser/ui/views/animations",
    "//chrome/browser/ui/views/page_info",
    "//chrome/browser/ui/views/tabs/hovercard",
    "//chrome/browser/ui/views/tabs/shared",
    "//chrome/browser/ui/views/location_bar",
    "//chrome/browser/ui/views/toolbar",
    "//chrome/browser/ui/views/web_apps/frame_toolbar:web_app_content_settings_container",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:profile_lifecycle_test_utils",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//strata/browser/sidebar",
    "//strata/browser/window_sync",
    "//testing/gtest",
    "//ui/events",
    "//ui/gfx/geometry",
    "//ui/menus",
    "//ui/views",
    "//ui/views:test_support",
    "//url",
  ]
  if (is_mac) {
    sources += [ "cocoa/shortcuts_mac_browsertest.mm" ]
    deps += [
      "//ui/base/clipboard:clipboard_test_support",
      "//ui/events:events_base",
    ]
    frameworks = [ "Carbon.framework" ]
  }
}
