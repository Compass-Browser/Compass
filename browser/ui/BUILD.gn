# Strata's browser UI. Linked into //chrome/browser/ui, which also allows our
# includes of its headers (see patches/chrome-browser-ui-BUILD.gn.patch), the
# same way upstream does for //chrome/browser/ui/webui/tab_search.
source_set("ui") {
  sources = [
    "views/sidebar/strata_sidebar_view.cc",
    "views/sidebar/strata_sidebar_view.h",
    "webui/placeholder/strata_placeholder_ui.cc",
    "webui/placeholder/strata_placeholder_ui.h",
    "webui/sidebar/sidebar_page_handler.cc",
    "webui/sidebar/sidebar_page_handler.h",
    "webui/sidebar/strata_sidebar_ui.cc",
    "webui/sidebar/strata_sidebar_ui.h",
    "webui/strata_web_ui_registry.cc",
    "webui/strata_web_ui_registry.h",
  ]
  public_deps = [
    "//chrome/browser:browser_public_dependencies",
    "//strata/browser/ui/webui/sidebar:mojo_bindings",

    # BrowserView's close hook calls into it (see patches/).
    "//strata/browser/window_sync",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/webui:favicon_source",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/browser/ui/webui:webui_util",
    "//components/favicon_base",
    "//components/tabs:public",
    "//content/public/browser",
    "//strata/resources/sidebar:resources",
    "//skia",
    "//ui/base",
    "//ui/views",
    "//ui/views/controls/webview",
    "//ui/webui",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "webui/sidebar/sidebar_page_handler_unittest.cc" ]
  deps = [
    ":ui",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//chrome/test/base:browser_with_test_window_test",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//strata/browser/sidebar",
    "//strata/browser/window_sync",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "views/sidebar/strata_sidebar_browsertest.cc" ]
  deps = [
    ":ui",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//strata/browser/sidebar",
    "//strata/browser/window_sync",
    "//testing/gtest",
    "//ui/views",
    "//url",
  ]
}
