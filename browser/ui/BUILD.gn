# The space symbols' paths (resources/sidebar/space_icons.ts, the page's) as
# a string constant, compass/browser/ui/space_icons_ts.h, for native menus
# (views/sidebar/space_icon_image.h).
action("space_icons_ts") {
  script = "//compass/build/embed_text.py"
  inputs = [ "//compass/resources/sidebar/space_icons.ts" ]
  outputs = [ "$target_gen_dir/space_icons_ts.h" ]
  args = [
    "--out",
    rebase_path(outputs[0], root_build_dir),
    "--namespace",
    "compass::space_icons_ts",
    "kSpaceIcons=" + rebase_path(inputs[0], root_build_dir),
  ]
}

