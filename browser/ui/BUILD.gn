# Declarations upstream's code calls into (its app menu, its command
# controller), with no dependencies, so upstream targets can include them
# without a cycle; the definitions are in :ui.
source_set("app_menu_hooks") {
  public = [
    "app_menu_sync.h",
    "compass_command_ids.h",
  ]
  public_deps = [ "//chrome/app:command_ids" ]
}

