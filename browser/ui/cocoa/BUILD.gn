# Compass's shortcuts on macOS, and the user's changes to them
# (docs/design/shortcuts.md). Upstream's main menu accelerators and its
# shortcuts outside the menu call into it (see patches/), so this depends on
# little of Chrome's.
source_set("shortcuts") {
  sources = [
    "shortcuts_mac.h",
    "shortcuts_mac.mm",
  ]
  # Header only, no target of its own.
  sources += [ "../compass_command_ids.h" ]
  public_deps = [
    "//base",
    "//ui/base",
  ]
  deps = [
    "//chrome/app:command_ids",
    "//compass/browser/shortcuts",
    "//ui/events:events_base",
  ]
  frameworks = [
    "AppKit.framework",
    "Carbon.framework",
  ]
}
