# The window frame's measurements. Upstream's browser view layout and the
# vertical tab strip region read them (see patches/), so this depends on
# nothing of Chrome's.
source_set("content_frame") {
  sources = [ "content_frame.h" ]
  public_deps = [ "//ui/gfx/geometry" ]
}
