# Claude in Compass: the settings' prefs, the key's storage, and the client
# for the Claude API. See docs/design/claude.md.

# Few deps: upstream's prefs registration reaches it (through
# //compass/browser/prefs).
source_set("prefs") {
  sources = [
    "claude_prefs.cc",
    "claude_prefs.h",
  ]
  deps = [
    "//base",
    "//components/prefs",
  ]
}

# common/claude/ (shared with iOS) as string constants:
# compass/browser/claude/claude_assets.h.
action("assets") {
  script = "//compass/build/embed_text.py"
  inputs = [
    "//compass/common/claude/system_prompt.md",
    "//compass/common/claude/tools.json",
    "//compass/common/claude/page_agent.js",
  ]
  outputs = [ "$target_gen_dir/claude_assets.h" ]
  args = [
    "--out",
    rebase_path(outputs[0], root_build_dir),
    "--namespace",
    "compass::claude::assets",
    "kSystemPrompt=" + rebase_path(inputs[0], root_build_dir),
    "kTools=" + rebase_path(inputs[1], root_build_dir),
    "kPageAgent=" + rebase_path(inputs[2], root_build_dir),
  ]
}

# The Claude client, page tools and credentials; Android builds it too, without
# Claude Code (docs/design/android.md, C8).
source_set("claude") {
  sources = [
    "claude_activity.cc",
    "claude_activity.h",
    "claude_api.cc",
    "claude_api.h",
    "claude_client.cc",
    "claude_client.h",
    "claude_credentials.cc",
    "claude_credentials.h",
    "claude_request.cc",
    "claude_request.h",
    "claude_tools.cc",
    "claude_tools.h",
    "devtools_session.cc",
    "devtools_session.h",
    "key_events.cc",
    "key_events.h",
    "page_reader.cc",
    "page_reader.h",
    "sse_parser.cc",
    "sse_parser.h",
  ]
  public_deps = [
    ":assets",
    ":prefs",
    "//base",
    "//services/network/public/cpp",
    "//url",
  ]
  deps = [
    "//base:i18n",
    "//chrome/browser:browser_process",
    "//chrome/common",
    "//content/public/browser",
    "//chrome/browser/profiles:profile",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/prefs",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/mojom",
    "//third_party/re2",
    "//ui/base",
    "//ui/gfx/geometry",
  ]
  # Claude Code runs as a local process on the desktop (docs/design/claude.md).
  if (!is_android) {
    sources += [
      "claude_code.cc",
      "claude_code.h",
      "claude_code_process.cc",
      "claude_code_process.h",
    ]
  }
}

if (!is_android) {
  source_set("unit_tests") {
    testonly = true
    sources = [
      "claude_api_unittest.cc",
      "claude_code_unittest.cc",
      "claude_request_unittest.cc",
      "key_events_unittest.cc",
      "sse_parser_unittest.cc",
    ]
    deps = [
      ":claude",
      ":prefs",
      "//base",
      "//components/prefs:test_support",
      "//net",
      "//testing/gtest",
      "//url",
    ]
  }

  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "claude_tools_browsertest.cc" ]
    deps = [
      ":claude",
      ":prefs",
      "//compass/browser/sidebar",
      "//compass/browser/ui",
      "//compass/browser/window_sync",
      "//components/prefs",
      "//base",
      "//base/test:test_support",
      "//chrome/browser/ui",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//content/public/browser",
      "//content/test:test_support",
      "//net:test_support",
      "//testing/gmock",
      "//testing/gtest",
      "//ui/base",
    ]
  }
}
