# Claude in Compass: the settings' prefs, the key's storage, and the client
# for the Claude API. See docs/design/claude.md.

import("//build/buildflag_header.gni")
import("//compass/tools/on_device/on_device.gni")

# COMPASS_ON_DEVICE_MODEL: the app has compass-on-device
# (tools/on_device/on_device.gni).
buildflag_header("on_device_buildflags") {
  header = "on_device_buildflags.h"
  flags = [ "COMPASS_ON_DEVICE_MODEL=$compass_on_device_model" ]
}

# Few deps: upstream's prefs registration reaches it (through
# //compass/browser/prefs).
source_set("prefs") {
  sources = [
    "ai_provider.cc",
    "ai_provider.h",
    "claude_prefs.cc",
    "claude_prefs.h",
  ]
  deps = [
    "//base",
    "//components/prefs",
  ]
}

# Claude's memory of the user, per profile (docs/design/claude.md, "Memory").
# Apart from :claude so sync can depend on it.
source_set("memory") {
  sources = [
    "claude_memory.cc",
    "claude_memory.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
  ]
}

# common/claude/ (shared with iOS) as string constants:
# compass/browser/claude/claude_assets.h.
action("assets") {
  script = "//compass/build/embed_text.py"
  inputs = [
    "//compass/common/claude/system_prompt.md",
    "//compass/common/claude/tools.json",
    "//compass/common/claude/page_agent.js",
    "//compass/common/claude/sidebar_prompts.md",
  ]
  outputs = [ "$target_gen_dir/claude_assets.h" ]
  args = [
    "--out",
    rebase_path(outputs[0], root_build_dir),
    "--namespace",
    "compass::claude::assets",
    "kSystemPrompt=" + rebase_path(inputs[0], root_build_dir),
    "kTools=" + rebase_path(inputs[1], root_build_dir),
    "kPageAgent=" + rebase_path(inputs[2], root_build_dir),
    "kSidebarPrompts=" + rebase_path(inputs[3], root_build_dir),
  ]
}

# The internal DevTools client. Its own target with few deps: development
# mode's network log uses it too, from upstream's DevTools bindings
# (docs/design/dev-mode.md).
source_set("devtools_session") {
  sources = [
    "devtools_session.cc",
    "devtools_session.h",
  ]
  public_deps = [
    "//base",
    "//content/public/browser",
  ]
  deps = [ "//url" ]
}

# The Claude client, page tools and credentials; Android builds it too, without
# Claude Code (docs/design/android.md, C8).
source_set("claude") {
  sources = [
    "chatgpt_account.cc",
    "chatgpt_account.h",
    "chatgpt_oauth.cc",
    "chatgpt_oauth.h",
    "claude_activity.cc",
    "claude_activity.h",
    "claude_api.cc",
    "claude_api.h",
    "claude_boost_tools.cc",
    "claude_plugin_tools.cc",
    "claude_client.cc",
    "claude_client.h",
    "claude_credentials.cc",
    "claude_credentials.h",
    "claude_devtools_tools.cc",
    "claude_files.cc",
    "claude_files.h",
    "claude_quick.cc",
    "claude_quick.h",
    "claude_request.cc",
    "claude_request.h",
    "claude_tools.cc",
    "claude_tools.h",
    "devtools_format.cc",
    "devtools_format.h",
    "key_events.cc",
    "key_events.h",
    "openai_edge.cc",
    "openai_edge.h",
    "page_reader.cc",
    "page_reader.h",
    "sse_parser.cc",
    "sse_parser.h",
  ]
  public_deps = [
    ":assets",
    ":devtools_session",
    ":memory",
    ":prefs",
    "//base",
    "//compass/browser/boosts:store",
    "//services/network/public/cpp",
    "//url",
  ]
  deps = [
    "//base:i18n",
    "//chrome/browser:browser_process",
    "//chrome/common",
    "//content/public/browser",
    "//chrome/browser/profiles:profile",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/prefs",
    "//crypto",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/mojom",
    "//third_party/icu",
    "//third_party/re2",
    "//ui/base",
    "//ui/gfx/geometry",
  ]
  # Claude Code runs as a local process on the desktop (docs/design/claude.md).
  if (!is_android) {
    sources += [
      "claude_code.cc",
      "claude_code.h",
      "claude_code_process.cc",
      "claude_code_process.h",
    ]
  }

  # Apple Intelligence through compass-on-device (docs/design/ai-sidebar.md,
  # "On this device").
  if (is_mac) {
    sources += [
      "on_device_model.cc",
      "on_device_model.h",
    ]
    deps += [ ":on_device_buildflags" ]
  }
}

if (!is_android) {
  source_set("unit_tests") {
    testonly = true
    sources = [
      "chatgpt_oauth_unittest.cc",
      "claude_api_unittest.cc",
      "claude_code_unittest.cc",
      "claude_files_unittest.cc",
      "claude_memory_unittest.cc",
      "claude_quick_unittest.cc",
      "claude_request_unittest.cc",
      "devtools_format_unittest.cc",
      "key_events_unittest.cc",
      "openai_edge_unittest.cc",
      "sse_parser_unittest.cc",
    ]
    if (is_mac) {
      sources += [ "on_device_model_unittest.cc" ]
    }
    deps = [
      ":claude",
      ":memory",
      ":prefs",
      "//base",
      "//base/test:test_support",
      "//components/prefs:test_support",
      "//net",
      "//services/network:test_support",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
      "//testing/gmock",
      "//testing/gtest",
      "//url",
    ]
  }

  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "chatgpt_account_browsertest.cc",
      "claude_tools_browsertest.cc",
    ]
    deps = [
      ":claude",
      ":prefs",
      "//compass/browser/sidebar",
      "//compass/browser/ui",
      "//compass/browser/window_sync",
      "//components/prefs",
      "//base",
      "//base/test:test_support",
      "//chrome/browser",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//content/public/browser",
      "//content/test:test_support",
      "//net:test_support",
      "//testing/gmock",
      "//testing/gtest",
      "//ui/base",
    ]
  }
}
