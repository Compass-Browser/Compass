# Live folders: plugins that fill pinned folders (docs/design/live-folders.md).
source_set("live_folders") {
  sources = [
    "live_fetcher.cc",
    "live_fetcher.h",
    "live_folder_store.cc",
    "live_folder_store.h",
    "live_plugin_manifest.cc",
    "live_plugin_manifest.h",
    "live_plugin_package.cc",
    "live_plugin_package.h",
    "live_result.cc",
    "live_result.h",
  ]
  public_deps = [
    "//base",
    "//compass/browser/sidebar",
    "//url",
  ]
  deps = [
    "//base:i18n",
    "//crypto",
    "//components/os_crypt/async/common",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "live_fetcher_unittest.cc",
    "live_folder_store_unittest.cc",
    "live_plugin_manifest_unittest.cc",
    "live_result_unittest.cc",
  ]
  deps = [
    ":live_folders",
    "//base",
    "//base/test:test_support",
    "//components/os_crypt/async/browser:test_support",
    "//components/os_crypt/async/common",
    "//net",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
  data = [ "//compass/plugins/builtin/" ]
}
