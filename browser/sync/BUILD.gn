# A profile's sync chain (docs/design/sync.md, slice 2). Built at startup by
# //chrome/browser/profiles:profiles_extra_parts_impl (see
# patches/chrome-browser-profiles-BUILD.gn.patch); chrome://compass-sync
# drives it through SyncController.
source_set("sync") {
  sources = [
    # Android builds only its kLocalSyncDirName.
    "compass_profile_creator.h",
    "compass_spaces_sync.h",
    "compass_sync_service.cc",
    "compass_sync_service.h",
    "compass_sync_service_factory.cc",
    "compass_sync_service_factory.h",
  ]
  public_deps = [
    ":settings",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_util",
    "//components/keyed_service/core",
    "//components/sync/protocol",
    "//components/sync/service",
    "//compass/components/sync:chain",
    "//url",
  ]
  if (is_android) {
    # One profile and window: the spaces are SpacesAndroid's, and there's no
    # space directory or profile creation (docs/design/android.md).
    sources += [
      "compass_spaces_sync_android.cc",
      "space_directory_android.cc",
    ]
  } else {
    sources += [
      "compass_profile_creator.cc",
      "compass_spaces_sync.cc",
    ]
    public_deps += [
      "//chrome/browser/ui/browser_window",
      "//compass/browser/window_sync",
    ]
  }
  deps = [
    ":favicon_png",
    ":spaces_bridge",
    "//base:i18n",
    "//chrome/browser/favicon",
    "//chrome/browser/history",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//ui/gfx",
    "//chrome/browser/sync:data_type_store_service_factory",
    "//chrome/common:channel_info",
    "//compass/browser/sidebar",
    "//compass/components/sync:controllers_hook",
    "//compass/components/sync:notifier",
    "//components/sync/model",
    "//chrome/browser:browser_process",
    "//chrome/browser/lifetime",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/sync",
    "//chrome/browser/sync:factories",
    "//chrome/common",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/pref_registry",
    "//components/prefs",
    "//components/signin/public/base",
    "//components/sync/base",
    "//components/sync_device_info",
    "//compass/components/sync:engine",
    "//content/public/browser",
    "//google_apis",
    "//services/network/public/cpp",
  ]
  if (is_android) {
    deps += [ "//compass/browser/android:spaces" ]
  } else {
    deps += [
      "//chrome/browser/ui:browser_manager_service",
      "//chrome/browser/ui/tabs:tab_strip",
    ]
  }
}

# What chrome://compass-sync's switches mean for Chromium's sync, and other
# profile-free pieces of the page and the app menu (sync.md, "Slice 4
# notes"). SyncController is the page's interface to CompassSyncService.
source_set("settings") {
  sources = [
    "sync_controller.cc",
    "sync_controller.h",
    "sync_settings.cc",
    "sync_settings.h",
  ]
  public_deps = [
    "//base",
    "//compass/components/sync:chain",
    "//components/sync/base",
    "//components/sync_device_info",
  ]
  deps = [
    "//compass/components/sync:engine",
    "//components/prefs",
    "//components/sync/service",
  ]
}

# COMPASS_SPACES's bridge: the sidebar's model and sync, nothing of windows,
# so it's unit-testable on its own (docs/design/sync.md, "The bridge").
source_set("spaces_bridge") {
  sources = [
    "compass_spaces_sync_bridge.cc",
    "compass_spaces_sync_bridge.h",
  ]
  public_deps = [
    "//base",
    "//compass/browser/sidebar",
    "//components/sync/base",
    "//components/sync/model",
    "//components/sync/protocol",
    "//url",
  ]
  deps = [ "//crypto" ]
}

# A page's icon as COMPASS_SPACES carries it (sync.md, "Favicons").
source_set("favicon_png") {
  sources = [
    "favicon_png.cc",
    "favicon_png.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    ":spaces_bridge",
    "//skia",
    "//ui/gfx/codec",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "compass_spaces_sync_bridge_unittest.cc",
    "compass_spaces_sync_profiles_unittest.cc",
    "favicon_png_unittest.cc",
    "sync_settings_unittest.cc",
  ]
  deps = [
    ":favicon_png",
    ":settings",
    ":spaces_bridge",
    "//base",
    "//base/test:test_support",
    "//compass/browser/sidebar",
    "//components/prefs:test_support",
    "//components/sync:test_support",
    "//components/sync/base",
    "//components/sync/service",
    "//components/sync_device_info",
    "//components/sync/model",
    "//components/sync/protocol",
    "//testing/gmock",
    "//testing/gtest",
    "//skia",
    "//ui/gfx/codec",
    "//url",
  ]
}
