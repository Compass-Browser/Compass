# A profile's sync chain (docs/design/sync.md, slice 2). Built at startup by
# //chrome/browser/profiles:profiles_extra_parts_impl (see
# patches/chrome-browser-profiles-BUILD.gn.patch); chrome://compass-sync
# drives it through SyncController.
source_set("sync") {
  sources = [
    "compass_spaces_sync.cc",
    "compass_spaces_sync.h",
    "compass_sync_service.cc",
    "compass_sync_service.h",
    "compass_sync_service_factory.cc",
    "compass_sync_service_factory.h",
    "sync_controller.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//components/keyed_service/core",
    "//components/sync/service",
    "//compass/components/sync:chain",
    "//url",
  ]
  deps = [
    ":spaces_bridge",
    "//base:i18n",
    "//chrome/browser/sync:data_type_store_service_factory",
    "//chrome/common:channel_info",
    "//compass/browser/sidebar",
    "//compass/browser/window_sync",
    "//compass/components/sync:controllers_hook",
    "//components/sync/model",
    "//chrome/browser:browser_process",
    "//chrome/browser/lifetime",
    "//chrome/browser/sync",
    "//chrome/browser/ui:browser_manager_service",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/pref_registry",
    "//components/prefs",
    "//components/sync/base",
    "//components/sync_device_info",
    "//compass/components/sync:engine",
    "//content/public/browser",
    "//services/network/public/cpp",
  ]
}

# COMPASS_SPACES's bridge: the sidebar's model and sync, nothing of windows,
# so it's unit-testable on its own (docs/design/sync.md, "Slice 3 notes").
source_set("spaces_bridge") {
  sources = [
    "compass_spaces_sync_bridge.cc",
    "compass_spaces_sync_bridge.h",
  ]
  public_deps = [
    "//base",
    "//compass/browser/sidebar",
    "//components/sync/base",
    "//components/sync/model",
    "//components/sync/protocol",
  ]
  deps = [ "//url" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "compass_spaces_sync_bridge_unittest.cc" ]
  deps = [
    ":spaces_bridge",
    "//base",
    "//base/test:test_support",
    "//compass/browser/sidebar",
    "//components/sync:test_support",
    "//components/sync/base",
    "//components/sync/model",
    "//components/sync/protocol",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
