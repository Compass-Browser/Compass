import("//build/buildflag_header.gni")
import("//compass/browser/updates/updates.gni")

# Automatic updates (docs/design/updates.md).

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "COMPASS_VERSION=\"$compass_version\"",
    "COMPASS_UPDATE_PUBLIC_KEY=\"$compass_sparkle_public_key\"",
    "ENABLE_WIN_UPDATER=$compass_enable_win_updater",
  ]
}

# The seams upstream code calls (lifetime, the About page, the installed
# version poller). Only //base, so those targets can depend on it.
source_set("hooks") {
  sources = [
    "update_hooks.cc",
    "update_hooks.h",
  ]
  deps = [
    ":buildflags",
    "//base",
  ]
}

# Channel manifests (stable.json, beta.json) and the checks an installer
# passes before the Windows updater runs it.
source_set("manifest") {
  sources = [
    "update_manifest.cc",
    "update_manifest.h",
  ]
  deps = [
    "//base",
    "//crypto",
    "//third_party/boringssl",
    "//url",
  ]
}

# The update channel pref, registered in Local State
# (patches/chrome-browser-prefs-browser_prefs.cc.patch).
source_set("prefs") {
  sources = [
    "update_prefs.cc",
    "update_prefs.h",
  ]
  deps = [
    ":hooks",
    "//components/prefs",
  ]
}

# Started by patches/chrome-browser-chrome_browser_main.cc.patch.
source_set("updates") {
  sources = [
    "start_updater.cc",
    "start_updater.h",
  ]
  deps = [ ":buildflags" ]
  if (is_mac) {
    sources += [
      "sparkle_updater_mac.h",
      "sparkle_updater_mac.mm",
    ]
    configs += [ ":sparkle_headers" ]
    deps += [
      ":hooks",
      ":prefs",
      "//base",
      "//chrome/browser:browser_process",
      "//chrome/browser/upgrade_detector",
      "//components/prefs",
      "//components/version_info",
    ]
    frameworks = [ "Foundation.framework" ]
  }
  if (is_win && compass_enable_win_updater) {
    sources += [
      "win_updater.cc",
      "win_updater.h",
    ]
    deps += [
      ":hooks",
      ":manifest",
      ":prefs",
      "//base",
      "//chrome/browser:browser_process",
      "//chrome/browser/upgrade_detector",
      "//components/prefs",
      "//net",
      "//services/network/public/cpp",
    ]
  }
}

if (is_mac) {
  config("sparkle_headers") {
    # Sparkle's headers only: the framework is loaded at run time.
    framework_dirs = [ compass_sparkle_sdk_dir ]
  }

  # Sparkle.framework in Compass.app/Contents/Frameworks, for builds with a
  # feed (patches/chrome-BUILD.gn.patch).
  bundle_data("sparkle_framework") {
    sources = [ "$compass_sparkle_bundle_dir/Sparkle.framework" ]
    outputs = [ "{{bundle_contents_dir}}/Frameworks/{{source_file_part}}" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "update_manifest_unittest.cc",
    "update_prefs_unittest.cc",
  ]
  deps = [
    ":hooks",
    ":manifest",
    ":prefs",
    "//base",
    "//components/prefs:test_support",
    "//testing/gtest",
  ]
}
