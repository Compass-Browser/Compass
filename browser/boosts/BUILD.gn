# Boosts: per-site CSS and JavaScript (docs/design/boosts.md).

# The store, with the match patterns. Few deps: sync, Claude's tools and the
# settings page use it.
source_set("store") {
  sources = [
    "boost_store.cc",
    "boost_store.h",
    "zap.cc",
    "zap.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
  ]
  deps = [
    "//compass/strings:compass_strings",
    "//ui/base",
    "//url",
  ]
}

# Sharing: a Boost as a link or a file, and back (docs/design/boosts.md,
# "Sharing"; common/boosts/share_vectors.json).
source_set("share") {
  sources = [
    "boost_share.cc",
    "boost_share.h",
  ]
  public_deps = [ ":store" ]
  deps = [
    "//base",
    "//compass/strings:compass_strings",
    "//third_party/zlib",
    "//ui/base",
    "//url",
  ]
}

if (!is_android) {
  # A tab opening a Boost link gets the settings' import preview. Upstream's
  # tab helpers (//chrome/browser/ui:tab_helpers_impl) depend on this target
  # (see patches/chrome-browser-ui-BUILD.gn.patch and
  # patches/chrome-browser-ui-tab_helpers.cc.patch).
  source_set("link") {
    sources = [
      "boost_link_interceptor.cc",
      "boost_link_interceptor.h",
    ]
    deps = [
      ":share",
      "//base",
      "//content/public/browser",
      "//ui/base",
      "//url",
    ]
  }
}

# resources/boosts/manifest.json as a string constant:
# compass/browser/boosts/boosts_assets.h.
action("assets") {
  script = "//compass/build/embed_text.py"
  inputs = [ "//compass/resources/boosts/manifest.json" ]
  outputs = [ "$target_gen_dir/boosts_assets.h" ]
  args = [
    "--out",
    rebase_path(outputs[0], root_build_dir),
    "--namespace",
    "compass::boosts::assets",
    "kManifest=" + rebase_path(inputs[0], root_build_dir),
  ]
}

# The component extension and its content scripts. Registered with the
# profile's services by chrome_browser_main_extra_parts_profiles.cc (see
# patches/chrome-browser-profiles-chrome_browser_main_extra_parts_profiles.cc.patch).
source_set("boosts") {
  sources = [
    "boost_injector.cc",
    "boost_injector.h",
  ]
  public_deps = [ ":store" ]
  deps = [
    ":assets",
    "//base",
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//extensions/browser",
    "//extensions/common",
    "//extensions/common:mojom",
  ]
}

if (!is_android) {
  source_set("unit_tests") {
    testonly = true
    sources = [
      "boost_share_unittest.cc",
      "boost_store_unittest.cc",
      "zap_unittest.cc",
    ]
    data = [ "//compass/common/boosts/share_vectors.json" ]
    deps = [
      ":share",
      ":store",
      "//base",
      "//base/test:test_support",
      "//testing/gtest",
      "//url",
    ]
  }

  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "boost_share_browsertest.cc",
      "boosts_browsertest.cc",
    ]
    deps = [
      ":boosts",
      ":share",
      "//base",
      "//base/test:test_support",
      "//chrome/browser",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//compass/browser/claude",
      "//compass/browser/claude:prefs",

      # The previews show in the settings window.
      "//compass/browser/ui",
      "//components/prefs",
      "//content/public/browser",
      "//content/test:test_support",
      "//net:test_support",
      "//testing/gtest",
      "//ui/base/clipboard",
      "//url",
    ]
  }
}
