# Import from Arc (docs/design/arc-import.md).
source_set("arc_import") {
  sources = [
    "arc_sidebar.cc",
    "arc_sidebar.h",
  ]
  public_deps = [
    "//base",
    "//compass/browser/sidebar",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "arc_sidebar_unittest.cc" ]
  deps = [
    ":arc_import",
    "//base",
    "//testing/gtest",
  ]
}
