# Import from Arc (docs/design/arc-import.md).
source_set("arc_import") {
  sources = [
    "arc_crypto.cc",
    "arc_crypto.h",
    "arc_easels.cc",
    "arc_easels.h",
    "arc_paths.cc",
    "arc_paths.h",
    "arc_sidebar.cc",
    "arc_sidebar.h",
    "profile_copy.cc",
    "profile_copy.h",
    "sidebar_import.cc",
    "sidebar_import.h",
  ]
  deps = [
    # EaselUrl() for an easel's tab.
    "//compass/browser/easels:store",
    "//crypto",
    "//sql",

    # Arc's Firestore cache (arc_easels.cc).
    "//third_party/leveldatabase",
  ]
  public_deps = [
    "//base",
    "//compass/browser/sidebar",
    "//components/sync/protocol",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "arc_easels_unittest.cc",
    "arc_paths_unittest.cc",
    "arc_sidebar_unittest.cc",
    "profile_copy_unittest.cc",
    "sidebar_import_unittest.cc",
  ]
  deps = [
    ":arc_import",
    "//base",
    "//base/test:test_support",
    "//compass/browser/easels:store",
    "//components/sync/protocol",
    "//sql",
    "//testing/gtest",
    "//third_party/leveldatabase",
  ]
}
