# Live tabs of the sidebar's nodes. Linked into
# //chrome/browser/ui/browser_window/internal, which owns WindowFeatures (see
# patches/chrome-browser-ui-browser_window-internal-BUILD.gn.patch).
source_set("window_sync") {
  sources = [
    "empty_tab.cc",
    "empty_tab.h",
    "live_tab_registry.cc",
    "live_tab_registry.h",
    "restored_tab_matcher.cc",
    "restored_tab_matcher.h",
    "space_directory.cc",
    "space_directory.h",
    "space_service.cc",
    "space_service.h",
    "startup_space.cc",
    "startup_space.h",
    "tab_strip_bridge.cc",
    "tab_strip_bridge.h",
    "undo_close.cc",
    "undo_close.h",
    "window_features.cc",
    "window_features.h",
  ]
  public_deps = [
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/sessions",
    "//components/split_tabs",
    "//components/tab_groups",
    "//components/tabs:public",
    "//compass/browser/sidebar",
    "//ui/base/unowned_user_data",
  ]
  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/lifetime",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/sessions",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui:browser_live_tab_context",
    "//chrome/browser/ui:recently_audible_helper",
    "//chrome/browser/ui/tabs:tab_model",
    "//chrome/browser/ui/tabs:tabs",
    "//chrome/browser/ui/tabs:utils",
    "//chrome/common",
    "//components/prefs",
    "//components/viz/common",
    "//content/public/browser",
    "//skia",
    "//ui/base",
    "//ui/gfx",
    "//ui/gfx/codec",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "space_directory_unittest.cc",
    "space_swap_unittest.cc",
    "space_switch_unittest.cc",
    "tab_strip_bridge_unittest.cc",
  ]
  deps = [
    ":window_sync",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui/browser_active_state_manager",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_model",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//chrome/test/base:browser_with_test_window_test",
    "//content/public/browser",
    "//content/public/common",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//url",
  ]
}
