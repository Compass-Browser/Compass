# "Present as Safari": a Safari user agent for sites the user picks, for
# players that use FairPlay only in Safari (docs/design/fairplay.md).

# The sites and the user agent override; upstream's tab helpers attach it
# (patches/chrome-browser-ui-tab_helpers.cc.patch).
source_set("present_as_safari") {
  sources = [
    "present_as_safari.cc",
    "present_as_safari.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//compass/browser/prefs",
    "//compass/media/avf:common",
    "//components/prefs",
    "//content/public/browser",
    "//net",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# Declared for upstream's page info view, which calls it
# (patches/chrome-browser-ui-views-page_info-BUILD.gn.patch); the code is
# linked by :page_info.
source_set("page_info_hooks") {
  public = [ "present_as_safari_page_info.h" ]
}

source_set("page_info") {
  sources = [
    "present_as_safari_page_info.cc",
    "present_as_safari_page_info.h",
  ]
  deps = [
    ":present_as_safari",
    "//base",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/views/controls",
    "//components/prefs",
    "//components/vector_icons",
    "//content/public/browser",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/views",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "present_as_safari_unittest.cc" ]
  deps = [
    ":present_as_safari",
    "//base",
    "//compass/browser/prefs",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//testing/gtest",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "present_as_safari_browsertest.cc" ]
  deps = [
    ":present_as_safari",
    "//base",
    "//chrome/browser",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
  ]
}
