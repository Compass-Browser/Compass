  testonly = true
  sources = [
    "compass_browser_window_test.cc",
    "compass_browser_window_test.h",
  ]
  public_deps = [ "//chrome/test:test_support" ]
  deps = [
    "//base",
    "//chrome/browser",
    "//content/public/browser",
    "//ui/base",
    "//url",
  ]
}
