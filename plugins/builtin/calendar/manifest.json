{
  "id": "compass.calendar",
  "name": "Calendar",
  "description": "Upcoming events with their meeting links, from a calendar's private iCal address.",
  "version": "1.0.0",
  "api": 1,
  "entry": "main.js",
  "icon": "icon.svg",
  "hosts": ["{secret:ics}"],
  "secrets": [
    {"key": "ics", "label": "Private iCal address",
     "help": "Google Calendar: Settings › your calendar › Secret address in iCal format. Outlook: Settings › Calendar › Shared calendars › Publish a calendar (ICS). iCloud: share the calendar publicly and copy the webcal:// link."}
  ],
  "config": [
    {"key": "hours", "type": "number", "label": "Show the next (hours)", "default": 12, "min": 1, "max": 168},
    {"key": "allDay", "type": "bool", "label": "Include all-day events"},
    {"key": "onlyMeetings", "type": "bool", "label": "Only events with a meeting link"},
    {"key": "fallback", "type": "url", "label": "Open events without a link at", "optional": true,
     "placeholder": "https://calendar.google.com"}
  ],
  "refresh": {"default": 900, "min": 300},
  "preview": {
    "matches": ["https://calendar.google.com/calendar/*"],
    "select": {
      "events": {
        "selector": "[data-eventid]",
        "attrs": ["data-eventid"],
        "text": true,
        "fields": {"label": ".XuJrye", "title": ".I0UMhf"},
        "max": 200
      }
    },
    "session": {"hosts": ["calendar.google.com"]},
    "config": [
      {"key": "count", "type": "number", "label": "Events to show", "default": 5, "min": 1, "max": 10},
      {"key": "allDay", "type": "bool", "label": "Include all-day events"}
    ]
  }
}
