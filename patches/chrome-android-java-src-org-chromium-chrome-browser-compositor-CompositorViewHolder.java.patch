+    // Compass: the widths a split's other pane takes on the left and right of the page.
+    private int mCompassLeftInset;
+    private int mCompassRightInset;
+
+    /** Compass: leaves |left| and |right| px beside the page to a split's other pane. */
+    public void setCompassSideInsets(int left, int right) {
+        if (left == mCompassLeftInset && right == mCompassRightInset) return;
+        mCompassLeftInset = left;
+        mCompassRightInset = right;
+        if (mLayoutManager != null) mLayoutManager.setContentOffsetX(left);
+        updateWebContentsSize();
+        onViewportChanged();
+    }
+
     private void onViewportChanged() {
         if (mLayoutManager != null) mLayoutManager.onViewportChanged();
