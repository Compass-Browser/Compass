@@ -4,6 +4,9 @@
 
 #include "chrome/browser/ui/browser_command_controller.h"
 
+#include "compass/browser/ui/compass_command_ids.h"
+#include "compass/browser/ui/views/command_bar/command_bar.h"
+
 #include <stddef.h>
 
 #include <algorithm>
@@ -640,10 +643,22 @@ void BrowserCommandController::ShowCustomizeChromeSidePanel(
 // BrowserCommandController, CommandUpdater implementation:
 
 bool BrowserCommandController::SupportsCommand(int id) const {
+  // Compass: commands of features it removes (compass_command_ids.h).
+  if (compass::IsRemovedCommand(id)) {
+    return false;
+  }
   return command_updater_->SupportsCommand(id);
 }
 
 bool BrowserCommandController::IsCommandEnabled(int id) const {
+  if (compass::IsRemovedCommand(id)) {
+    return false;
+  }
+  // Compass: Reopen Closed Tab also brings back unloaded entries, which
+  // upstream's TabRestoreService doesn't know.
+  if (compass::IsBrowserCommandEnabled(browser_, id)) {
+    return true;
+  }
   return command_updater_->IsCommandEnabled(id);
 }
 
@@ -652,6 +667,12 @@ bool BrowserCommandController::ExecuteCommandWithDispositionAndContext(
     WindowOpenDisposition disposition,
     std::optional<actions::ActionInvocationContext> context,
     base::TimeTicks time_stamp) {
+  // Compass: its own commands (compass_command_ids.h) aren't upstream's to
+  // enable.
+  if (compass::IsCompassCommand(id)) {
+    return compass::HandleBrowserCommand(browser_, id);
+  }
+
   if (!SupportsCommand(id) || !IsCommandEnabled(id)) {
     return false;
   }
@@ -669,6 +690,10 @@ bool BrowserCommandController::ExecuteCommandWithDispositionAndContext(
 
   DCHECK(IsCommandEnabled(id)) << "Invalid/disabled command " << id;
 
+  if (compass::HandleBrowserCommand(browser_, id)) {
+    return true;
+  }
+
   return command_updater_->ExecuteCommandWithDisposition(
       id, disposition, std::move(context), time_stamp);
 }
