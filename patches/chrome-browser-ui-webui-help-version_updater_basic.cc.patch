 namespace {
 
+// Compass: the Windows updater's progress (docs/design/updates.md).
+void CompassUpdateStatus(VersionUpdater::StatusCallback status_callback,
+                         compass::updates::CheckStatus status,
+                         int progress,
+                         const std::u16string& message) {
+  using compass::updates::CheckStatus;
+  VersionUpdater::Status mapped = VersionUpdater::CHECKING;
+  switch (status) {
+    case CheckStatus::kChecking:
+      mapped = VersionUpdater::CHECKING;
+      break;
+    case CheckStatus::kUpdating:
+      mapped = VersionUpdater::UPDATING;
+      break;
+    case CheckStatus::kNearlyUpdated:
+      mapped = VersionUpdater::NEARLY_UPDATED;
+      break;
+    case CheckStatus::kUpToDate:
+      mapped = VersionUpdater::UPDATED;
+      break;
+    case CheckStatus::kFailed:
+      mapped = VersionUpdater::FAILED;
+      break;
+  }
+  status_callback.Run(mapped, progress < 0 ? 0 : progress, false, false,
+                      std::string(), 0, message);
+}
