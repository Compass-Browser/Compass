 namespace {
 
+#if BUILDFLAG(IS_ANDROID)
+// Compass: the proto database providers of profiles after the startup one,
+// made with their ProfileKey (as StartupData makes the first one's) until
+// their storage partition takes them (compass/docs/design/android.md,
+// "Profiles").
+std::map<base::FilePath, std::unique_ptr<leveldb_proto::ProtoDatabaseProvider>>&
+CompassPendingProtoDbProviders() {
+  static base::NoDestructor<std::map<
+      base::FilePath, std::unique_ptr<leveldb_proto::ProtoDatabaseProvider>>>
+      providers;
+  return *providers;
+}
