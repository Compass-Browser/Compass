-  DCHECK(startup_data && startup_data->GetProfileKey());
-  TakePrefsFromStartupData();
-  async_prefs = false;
+  // Compass: only the profile StartupData was built for takes its prefs;
+  // another one (a profile of the sync chain) loads its own, as on desktop
+  // (compass/docs/design/android.md, "Profiles").
+  if (startup_data && startup_data->GetProfileKey() &&
+      startup_data->GetProfileKey()->GetPath() == path_) {
+    TakePrefsFromStartupData();
