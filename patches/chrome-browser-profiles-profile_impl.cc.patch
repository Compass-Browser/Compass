+    auto provider = std::make_unique<leveldb_proto::ProtoDatabaseProvider>(
+        path_, /*is_in_memory=*/false);
+    key_->SetProtoDatabaseProvider(provider.get());
+    CompassPendingProtoDbProviders()[path_] = std::move(provider);
+  }
 #else
   LoadPrefsForNormalStartup(async_prefs);
 #endif
