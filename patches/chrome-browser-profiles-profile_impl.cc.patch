diff --git a/chrome/browser/profiles/profile_impl.cc b/chrome/browser/profiles/profile_impl.cc
index 5683a13745480d73b1e58fed084d69bc0f285de1..8edc853f646834103b3e4bdfb2da55a976b459dc 100644
--- a/chrome/browser/profiles/profile_impl.cc
+++ b/chrome/browser/profiles/profile_impl.cc
@@ -527,16 +527,17 @@ ProfileImpl::ProfileImpl(
 
 #if BUILDFLAG(IS_ANDROID)
   auto* startup_data = g_browser_process->startup_data();
-  if (profiles::IsAndroidMultiprofileStartupDataEnabled() && startup_data &&
-      !startup_data->GetProfileKey()) {
-    // StartupData pre-creates objects only for the first profile, which has
-    // already taken them over.
-    LoadPrefsForNormalStartup(async_prefs);
-  } else {
-    CHECK(startup_data && startup_data->GetProfileKey(),
-          base::NotFatalUntil::M162);
+  // Compass: only the profile StartupData was built for takes its prefs;
+  // another one (a profile of the sync chain) loads its own, as on desktop,
+  // without AndroidMultiprofileStartupData, which would also start on the
+  // last used profile (compass/docs/design/android.md, "Profiles").
+  // LoadPrefsForNormalStartup() makes the profile's proto database provider.
+  if (startup_data && startup_data->GetProfileKey() &&
+      startup_data->GetProfileKey()->GetPath() == path_) {
     TakePrefsFromStartupData();
     async_prefs = false;
+  } else {
+    LoadPrefsForNormalStartup(async_prefs);
   }
 #else
   LoadPrefsForNormalStartup(async_prefs);
