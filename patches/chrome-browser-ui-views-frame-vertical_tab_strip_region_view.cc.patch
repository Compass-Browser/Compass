+void VerticalTabStripRegionView::InitializeTabStrip() {
+  if (strata_sidebar_) {
+    return;
+  }
+  std::unique_ptr<views::View> sidebar =
+      strata::CreateSidebar(browser_view()->browser());
+  strata_sidebar_ = sidebar.get();
+  // Subscribes to the collapse animation and expand on hover, as for the
+  // native strip.
+  AddTabStripView(std::move(sidebar));
+  strata::InstallSidebar(strata_sidebar_, bottom_button_container_);
+  strata_active_tab_watcher_ = std::make_unique<strata::ActiveTabWatcher>(
+      browser_view()->browser(),
+      base::BindRepeating(&VerticalTabStripRegionView::OnActiveTabChanged,
+                          base::Unretained(this)));
+}
+
+const tabs::TabData& VerticalTabStripRegionView::GetTabData(
+    const tabs::TabHandle& tab) {
+  // Callers use the result before asking again.
+  CHECK(tab.Get());
+  strata_tab_data_ = tabs::TabData::FromTabInterface(tab.Get());
+  return strata_tab_data_;
+}
+
+void VerticalTabStripRegionView::ResetTabStrip() {
+  if (!strata_sidebar_) {
+    return;
+  }
+  strata_active_tab_watcher_.reset();
+  RemoveTabStripView(std::exchange(strata_sidebar_, nullptr));
+}
