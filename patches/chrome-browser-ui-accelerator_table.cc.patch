+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+  // Compass: its shortcuts over upstream's, then the user's
+  // (compass/browser/shortcuts/shortcuts_table.h).
+  std::vector<compass::CommandAccelerator> list;
+  for (const AcceleratorMapping& mapping : *accelerators) {
