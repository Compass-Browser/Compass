+bool TranslateMessage::ShowCompassDownloadProgress(
+    const std::u16string& progress) {
+  if (state_ != State::kTranslating) {
+    return false;
+  }
+  JNIEnv* env = base::android::AttachCurrentThread();
+  const std::u16string description =
+      progress.empty()
+          ? compass_translating_description_
+          : compass_translating_description_ + u" \u00B7 " + progress;
+  bridge_->ShowMessage(
+      env, base::android::ConvertUTF16ToJavaString(env, compass_translating_title_),
+      base::android::ConvertUTF16ToJavaString(env, description),
+      /*primary_button_text=*/nullptr, /*has_overflow_menu=*/true);
+  return true;
+}
