diff --git a/gin/BUILD.gn b/gin/BUILD.gn
index 6f77e78807aba80eeebdcb47ebbd77a2a617a4eb..308f46280b78b8e23a8a87c35ad0e689c075fe02 100644
--- a/gin/BUILD.gn
+++ b/gin/BUILD.gn
@@ -115,6 +115,17 @@ component("gin") {
     frameworks = [ "CoreFoundation.framework" ]
   }
 
+  # Compass: without branch protection (an Apple silicon host,
+  # build/config/arm.gni) V8's builtins have no BTI landing pads, so V8's
+  # code mustn't be guarded with BTI (v8_platform_page_allocator.cc;
+  # docs/building.md, "Android from a Mac").
+  if (current_cpu == "arm64") {
+    import("//build/config/arm.gni")
+    if (arm_control_flow_integrity == "none") {
+      defines += [ "COMPASS_V8_WITHOUT_BTI" ]
+    }
+  }
+
   configs += [ "//v8:external_startup_data" ]
 }
 
