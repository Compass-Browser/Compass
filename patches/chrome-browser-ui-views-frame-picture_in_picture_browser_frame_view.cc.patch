 constexpr int kWindowIconImageSize = 16;
@@ -589,6 +593,20 @@ void PictureInPictureBrowserFrameView::AddedToWidget() {
   PictureInPictureWindowManager::GetInstance()->OnPictureInPictureWindowShown(
       this);
 
+#if BUILDFLAG(IS_MAC)
+  // Compass: float over other apps' fullscreen spaces too, and take clicks
+  // (and keys) without activating the browser, as video picture-in-picture
