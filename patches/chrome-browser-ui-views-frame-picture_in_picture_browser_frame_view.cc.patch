+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+  // Compass: click-through, corners, snapping to the edges; the page keeps
+  // its pinches and scrolls.
+  compass::PipWindows::Get().AddWindow(
+      GetWidget(), compass::PipWindows::Kind::kDocument);
+#endif
+
   BrowserFrameView::AddedToWidget();
