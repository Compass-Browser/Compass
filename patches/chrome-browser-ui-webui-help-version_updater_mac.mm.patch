+// Compass: Sparkle's progress (docs/design/updates.md).
+void CompassUpdateStatus(VersionUpdater::StatusCallback status_callback,
+                         compass::updates::CheckStatus status,
+                         int progress,
+                         const std::u16string& message) {
+  using compass::updates::CheckStatus;
+  VersionUpdater::Status mapped = VersionUpdater::Status::CHECKING;
+  switch (status) {
+    case CheckStatus::kChecking:
+      mapped = VersionUpdater::Status::CHECKING;
+      break;
+    case CheckStatus::kUpdating:
+      mapped = VersionUpdater::Status::UPDATING;
+      break;
+    case CheckStatus::kNearlyUpdated:
+      mapped = VersionUpdater::Status::NEARLY_UPDATED;
+      break;
+    case CheckStatus::kUpToDate:
+      mapped = VersionUpdater::Status::UPDATED;
+      break;
+    case CheckStatus::kFailed:
+      mapped = VersionUpdater::Status::FAILED;
+      break;
+  }
+  status_callback.Run(mapped, std::max(progress, 0), false, false,
+                      std::string(), 0, message);
+}
