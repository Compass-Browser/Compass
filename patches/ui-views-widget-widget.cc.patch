+void Widget::ExchangeContentsWith(Widget& other) {
+  CHECK(non_client_view_);
+  CHECK(other.non_client_view_);
+  // Taking the views out hides their native views, which on Windows hit-tests
+  // the window at once (a synthesized mouse move sends WM_NCHITTEST) through
+  // the frame view of a view no longer in a widget.
+  base::AutoReset<bool> exchanging(&exchanging_contents_, true);
+  base::AutoReset<bool> other_exchanging(&other.exchanging_contents_, true);
+  root_view_->RemoveChildView(non_client_view_);
+  other.root_view_->RemoveChildView(other.non_client_view_);
+  // The client views live in the frame views, which are replaced below: take
+  // them out. Adding the non-client views back puts them in the new ones.
+  for (NonClientView* view : {non_client_view_.get(),
+                              other.non_client_view_.get()}) {
+    ClientView* client_view = view->client_view();
+    if (client_view->parent()) {
+      client_view->parent()->RemoveChildView(client_view);
+    }
+  }
+  std::swap(non_client_view_, other.non_client_view_);
+  WidgetDelegate* delegate = other.widget_delegate_.get();
+  WidgetDelegate* other_delegate = widget_delegate_.get();
+  widget_delegate_ = delegate->AttachWidgetAndGetHandle(this);
+  other.widget_delegate_ = other_delegate->AttachWidgetAndGetHandle(&other);
+  // Frame views are made for one widget and its delegate: new ones, before
+  // the views are added and ask for them.
+  non_client_view_->SetFrameView(CreateFrameView());
+  other.non_client_view_->SetFrameView(other.CreateFrameView());
+  root_view_->SetContentsView(non_client_view_);
+  other.root_view_->SetContentsView(other.non_client_view_);
+}
