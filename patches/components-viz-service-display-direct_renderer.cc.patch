diff --git a/components/viz/service/display/direct_renderer.cc b/components/viz/service/display/direct_renderer.cc
index 93c637769d1d48964dbb91c5ccbf0499e26f615d..24b96c6a290698875525eea23fe380355aba16ab 100644
--- a/components/viz/service/display/direct_renderer.cc
+++ b/components/viz/service/display/direct_renderer.cc
@@ -293,10 +293,25 @@ void DirectRenderer::DrawFrame(
 
   gfx::ColorSpace frame_color_space =
       RenderPassColorSpace(current_frame()->root_render_pass);
+  bool root_needs_alpha =
+      current_frame()->root_render_pass->has_transparent_background;
+#if BUILDFLAG(IS_MAC)
+  // Compass: a video hole (AVPlayer's layer, //compass/media/avf) that can't
+  // be a CA overlay goes beneath the frame, which then needs alpha for the
+  // hole punched in it to show it.
+  if (!root_needs_alpha) {
+    for (const DrawQuad* quad : current_frame()->root_render_pass->quad_list) {
+      if (quad->material == DrawQuad::Material::kVideoHole) {
+        root_needs_alpha = true;
+        break;
+      }
+    }
+  }
+#endif
   SharedImageFormat frame_si_format =
       current_frame()->display_color_spaces.GetOutputFormat(
           current_frame()->root_render_pass->content_color_usage,
-          current_frame()->root_render_pass->has_transparent_background);
+          root_needs_alpha);
 #if BUILDFLAG(IS_WIN)
   bool has_primary_plane = false;
 #endif
@@ -323,8 +338,7 @@ void DirectRenderer::DrawFrame(
                 current_frame()->display_color_spaces.SupportsHDR() &&
                 render_passes_in_draw_order->back()->content_color_usage ==
                     gfx::ContentColorUsage::kHDR,
-            .is_opaque = !render_passes_in_draw_order->back()
-                              ->has_transparent_background,
+            .is_opaque = !root_needs_alpha,
             .si_format = frame_si_format,
             .color_space = frame_color_space,
 #if BUILDFLAG(IS_OZONE)
