--- a/content/renderer/media/media_factory.cc
+++ b/content/renderer/media/media_factory.cc
@@ -4,6 +4,8 @@
 
 #include "content/renderer/media/media_factory.h"
 
+#include "compass/media/avf/renderer/avf_renderer_hooks.h"
+
 #include <memory>
 #include <string>
 #include <tuple>
@@ -458,6 +460,13 @@ std::unique_ptr<blink::WebMediaPlayer> MediaFactory::CreateMediaPlayer(
   std::unique_ptr<media::Demuxer> demuxer_override =
       GetContentClient()->renderer()->OverrideDemuxerForUrl(render_frame_, url,
                                                             media_task_runner);
+  // Compass: native HLS through AVFoundation on macOS (docs/design/fairplay.md).
+  if (!demuxer_override) {
+    demuxer_override = compass::avf::MaybeCreateDemuxer(
+        GURL(url), [this](mojo::GenericPendingReceiver receiver) {
+          GetInterfaceBroker().GetInterface(std::move(receiver));
+        });
+  }
 
 #if BUILDFLAG(ENABLE_CAST_RECEIVER)
   if (!demuxer_override && cast_streaming_resource_provider_) {
@@ -558,6 +567,15 @@ MediaFactory::CreateRendererFactorySelector(
                                      std::move(factory));
   }
 
+  // Compass: AVFoundation plays this URL; it pairs with the AVFDemuxer
+  // created in CreateMediaPlayer().
+  if (auto avf_factory = compass::avf::MaybeCreateRendererFactory(GURL(url))) {
+    CHECK(!is_base_renderer_factory_set);
+    factory_selector->AddConditionalFactory(
+        RendererType::kContentEmbedderDefined, std::move(avf_factory),
+        base::BindRepeating(&compass::avf::IsAVFoundationUsable));
+  }
+
 #if BUILDFLAG(IS_ANDROID)
   // FlingingRendererClientFactory (FRCF) setup.
   auto flinging_factory = std::make_unique<FlingingRendererClientFactory>(
@@ -826,6 +844,16 @@ media::CdmFactory* MediaFactory::GetCdmFactory() {
   cdm_factory_ = std::make_unique<media::DefaultCdmFactory>();
 #endif  // BUILDFLAG(ENABLE_MOJO_CDM)
 
+  // Compass: FairPlay (com.apple.fps) on macOS (docs/design/fairplay.md).
+  cdm_factory_ = compass::avf::WrapCdmFactory(
+      std::move(cdm_factory_),
+      base::BindRepeating(
+          [](MediaFactory* factory, mojo::GenericPendingReceiver receiver) {
+            factory->GetInterfaceBroker().GetInterface(std::move(receiver));
+          },
+          // `this` owns the CDM factory.
+          base::Unretained(this)));
+
   return cdm_factory_.get();
 }
 
