+++ b/components/sync/android/sync_service_android_bridge.cc
@@ -379,6 +379,11 @@ void SyncServiceAndroidBridge::KeepAccountSettingsPrefsOnlyForUsers(
   for (const std::string& gaia_id_string : gaia_id_strings) {
     gaia_ids.emplace_back(gaia_id_string);
   }
+  // Compass: local sync has no account, so its transport data (cache GUID,
+  // birthday, ...) is keyed to the empty Gaia ID. Pruned to the OS accounts,
+  // it was cleared at every launch, and every launch synced as a new client
+  // (compass/docs/design/android.md, "Sync").
+  gaia_ids.emplace_back();
   native_sync_service_->GetUserSettings()->KeepAccountSettingsPrefsOnlyForUsers(
       gaia_ids);
 }
