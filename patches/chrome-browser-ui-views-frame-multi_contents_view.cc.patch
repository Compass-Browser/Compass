+  if (count == pane_count_) {
+    return;
+  }
+  pane_count_ = count;
+  for (size_t i = count; i < contents_container_views_.size(); ++i) {
+    if (contents_container_views_[i]->GetVisible()) {
+      contents_container_views_[i]->contents_view()->SetWebContents(nullptr);
+      contents_container_views_[i]->SetVisible(false);
+    }
+    resize_areas_[i - 1]->SetVisible(false);
+  }
+  if (static_cast<size_t>(active_index_) >= count) {
+    active_index_ = 0;
+  }
