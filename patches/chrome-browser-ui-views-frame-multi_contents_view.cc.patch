+std::optional<split_tabs::SplitTabId> MultiContentsView::GetActiveSplit()
+    const {
+  const tabs::TabInterface* active_tab =
+      browser_view_->browser()->GetTabStripModel()->GetActiveTab();
+  return active_tab ? active_tab->GetSplit() : std::nullopt;
+}
