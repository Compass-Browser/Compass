+void MultiContentsView::CalculatePaneLayouts(
+    const gfx::Rect& available_space,
+    views::ProposedLayout::ChildLayoutList& child_layouts) const {
+  const bool side_by_side =
+      GetSplitLayout() == split_tabs::SplitTabLayout::kSideBySide;
+  const size_t count = pane_count_;
+  const int resize = side_by_side ? resize_area_->GetPreferredSize().width()
+                                  : resize_area_->GetPreferredSize().height();
+  const int length =
+      side_by_side ? available_space.width() : available_space.height();
+  const int content = std::max(0, length - static_cast<int>(count - 1) * resize);
+
+  // Each pane's share; equal unless the split was resized.
+  std::vector<double> shares;
+  if (std::optional<split_tabs::SplitTabId> split = GetActiveSplit()) {
+    if (auto it = pane_sizes_.find(*split); it != pane_sizes_.end()) {
+      shares = it->second;
+    }
+  }
+  double total = 0;
+  for (double share : shares) {
+    total += share > 0 ? share : 0;
+  }
+  if (shares.size() != count || total <= 0) {
+    shares.assign(count, 1.0);
+    total = count;
+  }
+  std::vector<int> sizes(count);
+  int used = 0;
+  for (size_t i = 0; i + 1 < count; ++i) {
+    sizes[i] = static_cast<int>(
+        std::round(std::max(0.0, shares[i]) / total * content));
+    used += sizes[i];
+  }
+  sizes[count - 1] = std::max(0, content - used);
+  // No pane under the minimum: the largest gives.
+  const int min_size = std::min(GetMinViewSize(available_space),
+                                content / static_cast<int>(count));
+  for (size_t i = 0; i < count; ++i) {
+    if (sizes[i] < min_size) {
+      const auto largest = std::max_element(sizes.begin(), sizes.end());
+      const int diff = std::min(min_size - sizes[i], *largest - min_size);
+      if (diff > 0) {
+        *largest -= diff;
+        sizes[i] += diff;
+      }
+    }
+  }
+
+  int offset = 0;
+  for (size_t i = 0; i < contents_container_views_.size(); ++i) {
+    const bool shown = i < count;
+    gfx::Rect pane, area;
+    if (shown) {
+      pane = side_by_side
+                 ? gfx::Rect(available_space.x() + offset, available_space.y(),
+                             sizes[i], available_space.height())
+                 : gfx::Rect(available_space.x(), available_space.y() + offset,
+                             available_space.width(), sizes[i]);
+      offset += sizes[i];
+      if (i + 1 < count) {
+        area = side_by_side
+                   ? gfx::Rect(available_space.x() + offset,
+                               available_space.y(), resize,
+                               available_space.height())
+                   : gfx::Rect(available_space.x(),
+                               available_space.y() + offset,
+                               available_space.width(), resize);
+        offset += resize;
+      }
+    }
+    child_layouts.emplace_back(
+        contents_container_views_[i].get(),
+        shown && contents_container_views_[i]->GetVisible(), pane);
+    if (i + 1 < contents_container_views_.size()) {
+      child_layouts.emplace_back(resize_areas_[i].get(),
+                                 i + 1 < count && resize_areas_[i]->GetVisible(),
+                                 area);
+    }
+  }
+}
+
+void MultiContentsView::OnResizePanes(int resize_amount, bool done_resizing) {
+  if (!resizing_area_) {
+    // The area being dragged, or the one keys resize.
+    resizing_area_ = 0;
+    for (size_t i = 0; i + 1 < pane_count_; ++i) {
+      if (resize_areas_[i]->is_resizing() || resize_areas_[i]->HasFocus()) {
+        resizing_area_ = i;
+        break;
+      }
+    }
+    initial_pane_sizes_on_resize_.clear();
+    for (size_t i = 0; i < pane_count_; ++i) {
+      initial_pane_sizes_on_resize_.push_back(
+          GetResizeAxisComponent(contents_container_views_[i]->size()));
+    }
+  }
+  const size_t area = *resizing_area_;
+  std::vector<int> sizes = initial_pane_sizes_on_resize_;
+  if (area + 1 < sizes.size()) {
+    const int pair = sizes[area] + sizes[area + 1];
+    const int min_size = std::min(
+        GetMinViewSize(GetContentsBounds()), pair / 2);
+    sizes[area] =
+        std::clamp(sizes[area] + resize_amount, min_size, pair - min_size);
+    sizes[area + 1] = pair - sizes[area];
+  }
+  double total = 0;
+  for (int size : sizes) {
+    total += size;
+  }
+  if (total > 0) {
+    std::vector<double> shares;
+    for (int size : sizes) {
+      shares.push_back(size / total);
+    }
+    // The split keeps them while other tabs show.
+    if (std::optional<split_tabs::SplitTabId> split = GetActiveSplit()) {
+      // Splits that ended leave theirs: forget them now and then.
+      if (pane_sizes_.size() > 64) {
+        pane_sizes_.clear();
+      }
+      pane_sizes_[*split] = std::move(shares);
+    }
+    InvalidateLayout();
+  }
+  if (done_resizing) {
+    resizing_area_.reset();
+    initial_pane_sizes_on_resize_.clear();
+  }
+}
