# GPU process: overlay plane id -> CoreAnimation context of a layer drawn by
# another process (AVPlayer, docs/design/fairplay.md). A component so that
# ui/accelerated_widget_mac and the GPU client share one instance in
# component builds.
component("external_layer") {
  output_name = "compass_external_layer"
  sources = [
    "external_layer_constants.h",
    "external_layer_registry.cc",
    "external_layer_registry.h",
  ]
  defines = [ "IS_COMPASS_EXTERNAL_LAYER_IMPL" ]
  public_deps = [ "//base" ]
}

# The compass.mojom.ExternalLayerRegistry receiver the GPU process exposes to
# the browser (patches/chrome-gpu-chrome_content_gpu_client.cc.patch).
source_set("gpu_binder") {
  sources = [
    "external_layer_registry_impl.cc",
    "external_layer_registry_impl.h",
  ]
  deps = [
    ":external_layer",
    "//base",
    "//compass/media/avf/public/mojom",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "external_layer_registry_unittest.cc" ]
  deps = [
    ":external_layer",
    ":gpu_binder",
    "//base/test:test_support",
    "//compass/media/avf/public/mojom",
    "//mojo/public/cpp/bindings",
    "//testing/gtest",
  ]
}
