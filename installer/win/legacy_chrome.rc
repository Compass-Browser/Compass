#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Compass's icon (patched over Chromium's, found through the target's
// include_dirs), for taskbar pins and shortcuts that still show chrome.exe's.
1 ICON "chromium.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "The Compass Authors"
      VALUE "FileDescription", "Compass"
      VALUE "ProductName", "Compass"
      VALUE "InternalName", "legacy_chrome"
      VALUE "OriginalFilename", "chrome.exe"
      VALUE "LegalCopyright", "Copyright 2026 The Compass Authors"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
