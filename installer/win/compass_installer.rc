#include "compass/installer/win/compass_installer_resource.h"

#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// The first icon is the program's. Both files are found through the
// target's include_dirs (BUILD.gn).
IDI_COMPASS ICON "chromium.ico"

IDR_MINI_INSTALLER RCDATA "mini_installer.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "The Compass Authors"
      VALUE "FileDescription", "Compass Installer"
      VALUE "ProductName", "Compass"
      VALUE "InternalName", "compass_installer"
      VALUE "OriginalFilename", "compass_installer.exe"
      VALUE "LegalCopyright", "Copyright 2026 The Compass Authors"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
