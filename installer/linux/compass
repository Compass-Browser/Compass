# Starts Compass from the folder it was unpacked into, wherever it's linked
# from.
here=$(dirname "$(readlink -f "$0")")
export CHROME_WRAPPER="$here/compass"
export CHROME_DESKTOP=compass.desktop
exec "$here/chrome" "$@"
