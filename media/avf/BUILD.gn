# Native HLS through AVFoundation's AVPlayer on macOS, and FairPlay
# (docs/design/fairplay.md).
#
#   :renderer  AVFDemuxer and AVFRenderer, in the renderer process
#              (content/renderer/media/media_factory.cc)
#   :browser   AVFPlayerFactory, per document; launches the utility process
#              and registers layers with the GPU process
#   :service   AVPlayer, in the AVFoundation utility process
#              (chrome/utility/services.cc)
#   //compass/ui/external_layer  the GPU side: hosting the AVPlayer's layer

# A component: the feature flags must have one definition in component builds,
# where the renderer and browser code live in different libraries.
component("common") {
  output_name = "compass_avf_common"
  sources = [
    "common/avf_features.cc",
    "common/avf_features.h",
  ]
  defines = [ "IS_COMPASS_AVF_COMMON_IMPL" ]
  deps = [
    "//base",
    "//url",
  ]
}

source_set("renderer") {
  sources = [
    "renderer/avf_cdm_factory.cc",
    "renderer/avf_cdm_factory.h",
    "renderer/avf_demuxer.cc",
    "renderer/avf_demuxer.h",
    "renderer/avf_renderer.cc",
    "renderer/avf_renderer.h",
    "renderer/avf_renderer_hooks.cc",
    "renderer/avf_renderer_hooks.h",
    "renderer/fairplay_key_system_info.cc",
    "renderer/fairplay_key_system_info.h",
  ]
  public_deps = [ "//compass/media/avf/public/mojom" ]
  deps = [
    ":common",
    "//base",
    "//media",
    "//media/mojo/clients",
    "//mojo/public/cpp/bindings",
    "//ui/gfx/geometry",
    "//url",
  ]
}

source_set("browser") {
  sources = [
    "browser/avf_player_factory_impl.cc",
    "browser/avf_player_factory_impl.h",
  ]
  public_deps = [ "//compass/media/avf/public/mojom" ]
  deps = [
    ":common",
    "//base",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/profiles:profile",
    "//components/content_settings/core/browser",
    "//components/embedder_support:user_agent",
    "//content/public/browser",
    "//content/public/common",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//url",
  ]
}

if (is_mac) {
  source_set("service") {
    sources = [
      "service/avf_cdm.h",
      "service/avf_cdm.mm",
      "service/avf_media_service.h",
      "service/avf_media_service.mm",
      "service/avf_player_impl.h",
      "service/avf_player_impl.mm",
    ]
    public_deps = [ "//compass/media/avf/public/mojom" ]
    deps = [
      "//base",
      "//compass/ui/external_layer",
      "//media",
      "//mojo/public/cpp/bindings",
      "//net",
      "//ui/base",
      "//ui/gfx/geometry",
      "//url",
    ]
    frameworks = [
      "AVFoundation.framework",
      "CoreMedia.framework",
      "QuartzCore.framework",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "common/avf_features_unittest.cc" ]
  deps = [
    ":common",
    "//base/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "browser/avf_hls_browsertest.cc",
    "browser/fairplay_browsertest.cc",
  ]
  deps = [
    ":common",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//compass/media/avf/public/mojom",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
  ]
  data = [ "test/data/" ]
}
