# GN args shared by every Compass build. Imported from out/<Config>/args.gn,
# which `compass gen` writes (it also sets cc_wrapper).

# chromium_src overrides need a local compiler wrapper (build/redirect_cc.py).
use_remoteexec = false

# H.264/AAC playback, like other Chromium-based browsers.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Widevine DRM (Netflix, Spotify, Prime Video...). Non-branded builds get the
# CDM from the component updater (<user data>/WidevineCdm), like Chromium.
# Without Google's VMP signature (CDM host verification, Chrome-branded only)
# the CDM runs unverified: fine for most sites, but some services refuse
# their HD streams or all playback. docs/design/widevine.md.
enable_widevine = true

# No Google API keys: Google services that need them stay disabled.
use_official_google_api_keys = false

# Non-branded builds otherwise apply Chromium's field trial testing config
# (testing/variations/fieldtrial_testing_config.json) at every start: dozens of
# experiments, Gemini (Glic) among them, over Compass's own feature defaults
# (browser/feature_overrides.cc). docs/design/privacy.md.
disable_fieldtrial_testing_config = true
