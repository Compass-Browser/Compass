# GN args for Android, imported after common.gn and the config's file when
# `compass gen <config> --cpu android-arm64` writes args.gn (target_os and
# target_cpu are set there). Design: docs/design/android.md. Building from a
# Mac: docs/building.md, "Android from a Mac".

# Android lint and Error Prone slow the build down and check upstream code.
android_static_analysis = "off"

# mksnapshot runs natively on an Apple silicon host, and by default V8 lets
# it use the features its compiler targets (the Mac's: JSCVT, LSE, ...) in
# the builtins it writes. Many Android CPUs don't have them, and the
# renderer dies of SIGILL on the first JavaScript. Linux hosts run
# mksnapshot through a simulator, where this doesn't come up and the arg
# doesn't build (an unused function in V8's arm64 assembler): there
# `compass gen` sets it back to true after this file (tools/compass_tool/cli.py).
v8_use_host_cpu_arm_features = false

# Desktop-class Android (docs/design/android.md, "Extensions"): turns on
# upstream's extensions for Android (enable_desktop_android_extensions and
# what it needs, like the WebUI new tab page). Compass's shell replaces the
# desktop-class toolbar and tab strip it brings.
is_desktop_android = true

# 64-bit only. Official builds otherwise add the 32-bit ABI (for 32-bit
# WebView), whose V8 snapshot a Mac host can't build ("Do not know how to
# build a snapshot for android_clang_arm on mac arm64").
enable_android_secondary_abi = false
