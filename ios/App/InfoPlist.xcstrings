{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Compass scans the pairing code shown on your Mac, and lets websites you allow use the camera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compass scansiona il codice di associazione mostrato sul Mac e consente ai siti web che autorizzi di usare la fotocamera."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Privacy - Face ID Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Compass asks for Face ID before showing your recovery code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compass richiede Face ID prima di mostrare il codice di recupero."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Compass lets websites you allow use the microphone, for calls and recordings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compass consente ai siti web che autorizzi di usare il microfono, per chiamate e registrazioni."
          }
        }
      }
    }
  },
  "version": "1.0"
}
