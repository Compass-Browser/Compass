            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "Off" : {
      "comment" : "Extensions list: the extension is turned off.\nPage menu: Development Mode subtitle while it's off.\nSettings: sync status",
      "localizations" : {
        "it" : {
          "stringUnit" : {
