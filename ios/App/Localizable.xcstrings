    },
    "Off: add it to Today." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivo: aggiungila a Oggi."
          }
        }
      }
    },
    "Off: the AI only works with the page you're chatting about. On: it can also read and open your other tabs. Web pages can contain text written to trick it, so turn this on only when you need it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: l’AI lavora solo con la pagina di cui stai parlando. Attivato: può anche leggere e aprire le altre schede. Le pagine web possono contenere testo scritto per ingannarla, quindi attivalo solo quando ti serve."
          }
        }
      }
    },
    "On" : {
      "comment" : "Settings: sync status",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivo"
          }
        }
