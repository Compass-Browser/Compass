{
  "sourceLanguage" : "en",
  "strings" : {
    "Can't reach the server (%@)." : {
      "comment" : "Sharing (shared spaces, folders and Easels): error.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server (%@)."
          }
        }
      }
    },
    "Couldn't create the shared item. Try again." : {
