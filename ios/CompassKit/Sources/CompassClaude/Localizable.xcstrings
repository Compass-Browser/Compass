    "Too many requests (429). Wait a moment and try again." : {
      "comment" : "AI request error: HTTP 429.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe richieste (429). Attendi un momento e riprova."
