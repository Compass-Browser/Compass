{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is not set" : {
      "comment" : "Live folder error, shown under the folder: a setting the plugin needs (such as an API key) is empty. The argument is its label.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è impostato"
          }
        }
      }
    },
    "No response" : {
      "comment" : "Live folder error, shown under the folder.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna risposta"
          }
        }
      }
    },
    "No result after %lld ms" : {
      "comment" : "Live folder error, shown under the folder: the plugin timed out. The argument is milliseconds.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun risultato dopo %lld ms"
