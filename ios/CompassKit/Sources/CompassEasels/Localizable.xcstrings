{
  "sourceLanguage" : "en",
  "strings" : {
    "An image of the object is missing." : {
      "comment" : "Easel error, shown in an alert or toast.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca un’immagine dell’oggetto."
          }
        }
      }
    },
    "Easels hold 64 MB of images, which is used up. Delete some images first." : {
      "comment" : "Easel error, shown in an alert or toast.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli Easel possono contenere 64 MB di immagini e lo spazio è esaurito. Elimina prima alcune immagini."
          }
        }
      }
    },
    "Only PNG, JPEG and WebP images can be added." : {
      "comment" : "Easel error, shown in an alert or toast.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aggiungere solo immagini PNG, JPEG e WebP."
          }
        }
      }
    },
    "That Easel already exists." : {
