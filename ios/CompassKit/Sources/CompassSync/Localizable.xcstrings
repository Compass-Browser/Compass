{
  "sourceLanguage" : "en",
  "strings" : {
    "Can't reach the sync server (%@)." : {
      "comment" : "Settings → Sync: error removing a device. The argument is the system's network error.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server di sincronizzazione (%@)."
          }
        }
      }
    },
    "Checking your Cloudflare account…" : {
      "comment" : "Progress while setting up a sync server on Cloudflare.",
