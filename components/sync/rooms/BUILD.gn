# Rooms (shared spaces, folders and easels): the identity key, room key
# envelopes, record encryption and invite links. See docs/design/sync.md,
# "Rooms: crypto and links", and common/rooms/vectors.json.
source_set("crypto") {
  sources = [
    "room_crypto.cc",
    "room_crypto.h",
    "room_invite_link.cc",
    "room_invite_link.h",
  ]
  public_deps = [
    "//base",
    "//compass/components/sync:chain",
  ]
  deps = [
    "//crypto",
    "//third_party/boringssl",
    "//url",
  ]
}

# The rooms API of a sync server (docs/design/sync.md, "Rooms").
source_set("client") {
  sources = [
    "room_client.cc",
    "room_client.h",
  ]
  public_deps = [
    ":crypto",
    "//base",
    "//url",
  ]
  deps = [
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "room_client_unittest.cc",
    "room_crypto_unittest.cc",
    "room_invite_link_unittest.cc",
    "room_test_vectors.h",
  ]
  data = [ "//compass/common/rooms/vectors.json" ]
  deps = [
    ":client",
    ":crypto",
    "//base",
    "//base/test:test_support",
    "//net",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//testing/gtest",
  ]
}
