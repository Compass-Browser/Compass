# The compass:// scheme, shared by every process. //chrome/common registers
# it, and the browser targets that rewrite or show URLs depend on it (see
# docs/design/branding.md "compass://").
source_set("url") {
  sources = [
    "compass_url.cc",
    "compass_url.h",
  ]
  deps = [
    "//base",
    "//url",
  ]
}

# Compass's user data folder on macOS (docs/design/branding.md, "User data
# folder"). //chrome/common's chrome_paths uses it (see patches/).
if (is_mac) {
  source_set("user_data_dir") {
    sources = [
      "user_data_dir_mac.h",
      "user_data_dir_mac.mm",
    ]
    deps = [ "//base" ]
    frameworks = [ "Foundation.framework" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "compass_url_unittest.cc" ]
  deps = [
    ":url",
    "//testing/gtest",
    "//url",
  ]
  if (is_mac) {
    sources += [ "user_data_dir_mac_unittest.mm" ]
    deps += [
      ":user_data_dir",
      "//base",
    ]
  }
}
