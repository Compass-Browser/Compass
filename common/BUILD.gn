# The compass:// scheme, shared by every process. //chrome/common registers
# it, and the browser targets that rewrite or show URLs depend on it (see
# docs/design/branding.md "compass://").
source_set("url") {
  sources = [
    "compass_url.cc",
    "compass_url.h",
  ]
  deps = [
    "//base",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "compass_url_unittest.cc" ]
  deps = [
    ":url",
    "//testing/gtest",
    "//url",
  ]
}
