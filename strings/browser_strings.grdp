  </message>
  <message name="IDS_COMPASS_EASELS_EXISTS" desc="Error when creating an Easel that already exists.">
    That Easel already exists.
  </message>
  <message name="IDS_COMPASS_EASELS_NO_SUCH" desc="Error: the Easel was deleted or doesn&#x27;t exist.">
    There's no such Easel.
  </message>
  <message name="IDS_COMPASS_EASELS_FULL" desc="Error when adding to an Easel that has the most objects it can hold.">
    This Easel is full (1,000 objects). Delete some first.
  </message>
  <message name="IDS_COMPASS_EASELS_IMAGE_TOO_LARGE" desc="Error when adding an image to an Easel.">
    The image is too large.
  </message>
  <message name="IDS_COMPASS_EASELS_IMAGE_TYPE" desc="Error when adding an image of an unsupported format to an Easel.">
    Only PNG, JPEG and WebP images can be added.
  </message>
  <message name="IDS_COMPASS_EASELS_IMAGES_FULL" desc="Error when adding an image: the space for Easels&#x27; images is used up.">
    Easels hold 64 MB of images, which is used up. Delete some images first.
  </message>
  <message name="IDS_COMPASS_EASELS_IMAGE_UNREADABLE" desc="Error when adding an image to an Easel: it couldn&#x27;t be decoded.">
    The image couldn't be read.
  </message>
  <message name="IDS_COMPASS_EASELS_IMAGE_NOT_ENCODED" desc="Error when adding an image to an Easel: it couldn&#x27;t be converted.">
    The image couldn't be encoded.
  </message>
  <message name="IDS_COMPASS_UPDATES_UNREACHABLE" desc="Update error on Windows, in Settings&#x27; About section.">
    Couldn't reach the update server.
  </message>
  <message name="IDS_COMPASS_UPDATES_DOWNLOAD_FAILED" desc="Update error on Windows, in Settings&#x27; About section.">
    The update didn't download.
  </message>
  <message name="IDS_COMPASS_UPDATES_VERIFY_FAILED" desc="Update error on Windows: the downloaded update failed its signature or integrity checks.">
    The update didn't pass its checks.
  </message>
  <message name="IDS_COMPASS_UPDATES_INSTALL_FAILED" desc="Update error on Windows, in Settings&#x27; About section.">
    The update didn't install.
  </message>
  <message name="IDS_COMPASS_UPDATES_NOT_SUPPORTED" desc="Shown in Settings&#x27; About section on builds that don&#x27;t update themselves.">
    This build doesn't update itself.
  </message>
  <message name="IDS_COMPASS_SETTINGS_CARDS_UNAVAILABLE" desc="Error in Settings: saved payment cards can&#x27;t be used in this profile.">
    Payment methods aren't available here.
  </message>
  <message name="IDS_COMPASS_SETTINGS_CARD_NOT_EDITABLE" desc="Error in Settings when editing a payment card.">
    This card can't be edited here.
  </message>
  <message name="IDS_COMPASS_SETTINGS_CARD_NUMBER_INVALID" desc="Error in Settings when saving a payment card.">
    That card number isn't valid.
  </message>
  <message name="IDS_COMPASS_SETTINGS_CARD_EXPIRED" desc="Error in Settings when saving a payment card with a past expiry date.">
    Use an expiry date that hasn't passed.
  </message>
  <message name="IDS_COMPASS_SETTINGS_ADDRESSES_UNAVAILABLE" desc="Error in Settings: saved addresses can&#x27;t be used in this profile.">
    Addresses aren't available here.
  </message>
  <message name="IDS_COMPASS_SETTINGS_ADDRESS_NO_COUNTRY" desc="Error in Settings when saving an address without a country.">
    Pick a country.
  </message>
  <message name="IDS_COMPASS_SETTINGS_ADDRESS_REMOVED" desc="Error in Settings when editing an address removed meanwhile.">
    This address was removed.
  </message>
  <message name="IDS_COMPASS_SETTINGS_ADDRESS_EMPTY" desc="Error in Settings when saving an empty address.">
    Fill in at least a name or a street.
  </message>
  <message name="IDS_COMPASS_SETTINGS_SEARCH_ENGINES_LOADING" desc="Error in Settings: the search engines haven&#x27;t loaded yet.">
    Search engines aren't loaded yet.
  </message>
  <message name="IDS_COMPASS_SETTINGS_SEARCH_ENGINE_NOT_EDITABLE" desc="Error in Settings when editing a built-in search engine.">
    This search engine can't be edited.
  </message>
  <message name="IDS_COMPASS_SETTINGS_SEARCH_ENGINE_NO_NAME" desc="Error in Settings when saving a search engine without a name.">
    Give it a name.
  </message>
  <message name="IDS_COMPASS_SETTINGS_SEARCH_ENGINE_BAD_KEYWORD" desc="Error in Settings: a search engine&#x27;s shortcut (the keyword typed in the address bar) has spaces or is taken.">
    Use a shortcut without spaces that no other engine has.
  </message>
  <message name="IDS_COMPASS_SETTINGS_SEARCH_ENGINE_BAD_URL" desc="Error in Settings: a search engine&#x27;s address isn&#x27;t valid. Keep %s as is: it&#x27;s what the user types in the address.">
    Use a web address; <ph name="QUERY">%s<ex>%s</ex></ph> in it marks where the query goes.
  </message>
  <message name="IDS_COMPASS_SETTINGS_DOWNLOAD_LOCATION_DIALOG_TITLE" desc="Title of the dialog that picks the folder downloads go to.">
    Download Location
  </message>
  <message name="IDS_COMPASS_SPACES_EXPORT_FILE_NAME" desc="Default file name (without extension) when exporting all spaces (groups of tabs) as a bookmarks file.">
    Compass Spaces
  </message>
  <message name="IDS_COMPASS_SPACES_EXPORT_FALLBACK_FILE_NAME" desc="Default file name (without extension) when exporting a space whose name can&#x27;t be a file name.">
    Space
  </message>
  <message name="IDS_COMPASS_SPACES_EXPORT_SPACE_DIALOG_TITLE" desc="Title of the dialog that saves one space as a bookmarks file.">
    Export Space
  </message>
  <message name="IDS_COMPASS_SPACES_EXPORT_SPACES_DIALOG_TITLE" desc="Title of the dialog that saves all spaces as a bookmarks file.">
    Export Spaces
  </message>
  <message name="IDS_COMPASS_ADBLOCK_NOT_RUNNING" desc="Error when adding a filter list: the ad blocker isn&#x27;t running.">
    The ad blocker isn't running
  </message>
  <message name="IDS_COMPASS_PLUGINS_NO_SUCH" desc="Error in Settings: the live folder plugin doesn&#x27;t exist.">
    There's no such plugin.
  </message>
  <message name="IDS_COMPASS_PLUGINS_SETTINGS_INVALID" desc="Error in Settings when saving a plugin&#x27;s settings.">
    The settings aren't valid.
  </message>
  <message name="IDS_COMPASS_PLUGINS_UNAVAILABLE" desc="Error in Settings: plugins can&#x27;t be used in this profile.">
    Plugins aren't available here.
  </message>
  <message name="IDS_COMPASS_SYNC_ALREADY_ASKING" desc="Error on the sync page: Compass is already asking for Touch ID or the password.">
    Already asking.
  </message>
  <message name="IDS_COMPASS_SHARE_NO_ROLE" desc="Error when creating an invite link without picking whether people can edit or only view.">
    Choose a role.
  </message>
  <message name="IDS_COMPASS_SYNC_AUTH_SHOW_RECOVERY_CODE" desc="macOS shows it in the Touch ID or password prompt as &quot;Compass is trying to &lt;this&gt;.&quot;, so it starts in lower case and has no period.">
    show your sync recovery code
  </message>
  <message name="IDS_COMPASS_CLAUDE_KEY_UNREADABLE" desc="Error when testing the AI connection in Settings: the saved API key can&#x27;t be decrypted.">
    The saved key can't be read any more. Enter it again.
  </message>
  <message name="IDS_COMPASS_CLAUDE_ENTER_BASE_URL" desc="Error when testing an OpenAI-compatible AI server in Settings without its address.">
    Enter the server's base URL first.
  </message>
  <message name="IDS_COMPASS_CLAUDE_ENTER_API_KEY" desc="Error when testing the AI connection in Settings without an API key.">
    Enter an API key first.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CODE_NOT_INSTALLED_SET_PATH" desc="Error in Settings: the Claude Code command-line tool wasn&#x27;t found. Keep claude.com/claude-code as is.">
    Claude Code isn't installed where Compass looks. Install it (claude.com/claude-code), or set its path.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CODE_NOT_AT_PATH" desc="Error in Settings: the Claude Code path the user set has no Claude Code.">
    There's no Claude Code at that path.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CODE_NOT_INSTALLED_SETTINGS" desc="Error in the chat with Claude: the Claude Code command-line tool wasn&#x27;t found.">
    Claude Code isn't installed where Compass looks. Install it (claude.com/claude-code), or set its path in Compass's Claude settings.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CODE_NOT_AT_SETTINGS_PATH" desc="Error in the chat with Claude: the Claude Code path set in Settings has no Claude Code.">
    Claude Code isn't at the path set in Compass's Claude settings.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CODE_NOT_STARTED" desc="Error in the chat with Claude: the Claude Code program couldn&#x27;t be started. PATH is the program&#x27;s path.">
    Claude Code couldn't start (<ph name="PATH">$1<ex>/usr/local/bin/claude</ex></ph>).
  </message>
  <message name="IDS_COMPASS_CLAUDE_APPLE_INTELLIGENCE_UNAVAILABLE" desc="Error in Settings: Apple&#x27;s on-device AI can&#x27;t be used on this Mac. Apple Intelligence is a product name.">
    Apple Intelligence isn't available here.
  </message>
  <message name="IDS_COMPASS_CLAUDE_FOLDER_DIALOG_TITLE" desc="Title of the dialog that picks a folder Claude can read and write files in.">
    Choose a folder for Claude
  </message>
  <message name="IDS_COMPASS_CLAUDE_MEMORY_UNAVAILABLE" desc="Error in Settings: Claude&#x27;s memory can&#x27;t be used in this profile.">
    Memory isn't available in this profile.
  </message>
  <message name="IDS_COMPASS_CLAUDE_NO_TAB" desc="Error in the chat with Claude: there&#x27;s no tab to read.">
    No tab is open.
  </message>
  <message name="IDS_COMPASS_CLAUDE_NOTHING_TO_SEND" desc="Error in the chat with Claude: the message is empty.">
    Nothing to send.
  </message>
  <message name="IDS_COMPASS_CLAUDE_ENTER_MODEL_ID" desc="Error in the chat: the AI server needs a model ID set in Settings.">
    Enter a model ID in Compass's AI settings.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_DENIED" desc="Error when setting up a sync server on Cloudflare: the user didn&#x27;t allow access.">
    You didn't allow Compass on Cloudflare.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_NOT_FINISHED" desc="Error when setting up a sync server on Cloudflare: sign-in failed.">
    Cloudflare sign-in didn't finish. Try again.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_NO_ACCESS" desc="Error when setting up a sync server on Cloudflare: no access token came back.">
    Cloudflare didn't give Compass access. Try again.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_NO_WINDOW" desc="Error when setting up a sync server on Cloudflare: there&#x27;s no browser window to open the sign-in page in.">
    Open a Compass window and try again.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_PAGE_FAILED" desc="Error when setting up a sync server on Cloudflare.">
    Couldn't open Cloudflare's sign-in page.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_CLOSED" desc="Error when setting up a sync server on Cloudflare: the user closed the sign-in tab.">
    Cloudflare sign-in was closed before it finished.
  </message>
  <message name="IDS_COMPASS_EASELS_UNAVAILABLE_IN_WINDOW" desc="Error in an Easel: Easels can&#x27;t be used in this window (e.g. incognito).">
    Easels aren't available in this window.
  </message>
  <message name="IDS_COMPASS_EASELS_VIEW_ONLY" desc="Error when editing an Easel someone shared with the user for viewing only.">
    You can only view this shared easel.
  </message>
  <message name="IDS_COMPASS_EASELS_OBJECT_ELSEWHERE" desc="Error when editing an object that belongs to another Easel.">
    The object is on another Easel.
  </message>
  <message name="IDS_COMPASS_SYNC_NOT_SUPPORTED" desc="Error for a sync action on a platform that doesn&#x27;t support it.">
    Not supported here.
  </message>
  <message name="IDS_COMPASS_ADBLOCK_LIST_BAD_URL" desc="Error when adding a filter list to the ad blocker: the address isn&#x27;t complete.">
    Enter the list's full address, starting with https://
  </message>
  <message name="IDS_COMPASS_ADBLOCK_LIST_NOT_HTTPS" desc="Error when adding a filter list to the ad blocker with an http address.">
    Only https:// lists can be added
  </message>
  <message name="IDS_COMPASS_ADBLOCK_LIST_EXISTS" desc="Error when adding a filter list the ad blocker already has.">
    That list is already added
  </message>
  <message name="IDS_COMPASS_DEFAULT_SPACE_NAME" meaning="Default space name" desc="Name of the space (a group of tabs with its own sidebar) a new profile starts with. The user can rename it.">
    Home
  </message>
  <message name="IDS_COMPASS_TAB_GROUP_FOLDER_NAME" desc="Name of a sidebar folder made from a tab group that had no name (e.g. a group an extension created).">
    Group
  </message>
  <message name="IDS_COMPASS_IMPORT_FOLDER" desc="Name of an imported folder that had no name in the other browser.">
    Folder
  </message>
  <message name="IDS_COMPASS_IMPORT_SPACE" desc="Name of an imported space (a group of tabs) that had no name in the other browser.">
    Space
  </message>
  <message name="IDS_COMPASS_IMPORT_WORKSPACE" desc="Name of a space imported from a browser&#x27;s workspace that had no name.">
    Workspace
  </message>
  <message name="IDS_COMPASS_IMPORT_TAB_GROUP" desc="Name of a space imported from a Safari tab group that had no name.">
    Tab Group
  </message>
  <message name="IDS_COMPASS_IMPORT_PERSONAL" desc="Name of the first space imported from a browser that names it Personal by default.">
    Personal
  </message>
  <message name="IDS_COMPASS_IMPORT_CHROMIUM_OTHER_BOOKMARKS" desc="Name of the imported folder holding a Chromium-based browser&#x27;s &quot;Other bookmarks&quot;.">
    Other bookmarks
  </message>
  <message name="IDS_COMPASS_IMPORT_CHROMIUM_MOBILE_BOOKMARKS" desc="Name of the imported folder holding a Chromium-based browser&#x27;s &quot;Mobile bookmarks&quot;.">
    Mobile bookmarks
  </message>
  <message name="IDS_COMPASS_IMPORT_BOOKMARKS_MENU" desc="Name of the imported folder holding Safari&#x27;s or Firefox&#x27;s Bookmarks Menu.">
    Bookmarks Menu
  </message>
  <message name="IDS_COMPASS_IMPORT_READING_LIST" desc="Name of the imported folder holding Safari&#x27;s Reading List.">
    Reading List
  </message>
  <message name="IDS_COMPASS_IMPORT_FIREFOX_OTHER_BOOKMARKS" desc="Name of the imported folder holding Firefox&#x27;s &quot;Other Bookmarks&quot;.">
    Other Bookmarks
  </message>
  <message name="IDS_COMPASS_IMPORT_FIREFOX_MOBILE_BOOKMARKS" desc="Name of the imported folder holding Firefox&#x27;s &quot;Mobile Bookmarks&quot;.">
    Mobile Bookmarks
  </message>
  <message name="IDS_COMPASS_IMPORT_EASEL" desc="Name of an Easel imported from Arc that had no name. Easel is a feature name.">
    Easel
  </message>
  <message name="IDS_COMPASS_BOOSTS_SHARE_INVALID" desc="Error when opening a shared Boost (a site&#x27;s custom CSS and JavaScript) link or file that&#x27;s damaged. Boost is a feature name.">
    This isn't a Boost that Compass can read. The link or file may be incomplete.
  </message>
  <message name="IDS_COMPASS_BOOSTS_SHARE_TOO_BIG" desc="Error when opening a shared Boost that&#x27;s too large.">
    This Boost is too big to add: shared Boosts are at most 512 KB.
  </message>
  <message name="IDS_COMPASS_BOOSTS_SHARE_NEWER" desc="Error when opening a Boost shared from a newer version of Compass.">
    This Boost was made by a newer Compass. Update Compass to add it.
  </message>
  <message name="IDS_COMPASS_BOOSTS_WEB_PAGES_ONLY" desc="Error when saving a Boost whose site pattern isn&#x27;t a web address.">
    Boosts apply to web pages only (http and https).
  </message>
  <message name="IDS_COMPASS_BOOSTS_LOADING" desc="Error: Boosts haven&#x27;t finished loading.">
    Boosts are still loading. Try again in a moment.
  </message>
  <message name="IDS_COMPASS_BOOSTS_ZAP_NAME" desc="Name of the Boost made when the user hides (&quot;zaps&quot;) elements on a site. SITE is the site&#x27;s host.">
    Zapped on <ph name="SITE">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_COMPASS_AI_ERROR_UNREACHABLE" desc="Error in the AI chat or settings: the AI server couldn&#x27;t be reached.">
    Couldn't reach the server. Check the connection and the endpoint URL.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_KEY_REFUSED" desc="Error from an AI server: the API key was refused (HTTP 401).">
    The key was refused (401). Check it.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_OVERLOADED" desc="Error from an AI server: it&#x27;s overloaded. CODE is the HTTP status code.">
    The server is overloaded (<ph name="CODE">$1<ex>503</ex></ph>). Try again in a moment.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_ANTHROPIC_KEY_REFUSED" desc="Error from Anthropic&#x27;s API: the key was refused. Keep `claude setup-token` as is (a command).">
    The key was refused (401). Check it, and the auth style. A token from `claude setup-token` may have expired: make a new one.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_FORBIDDEN" desc="Error from an AI server (HTTP 403).">
    The key isn't allowed to do this (403).
  </message>
  <message name="IDS_COMPASS_AI_ERROR_NOT_FOUND" desc="Error from an AI server (HTTP 404).">
    Nothing answers at that URL (404). Check the endpoint URL.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_TOO_MANY_REQUESTS" desc="Error from an AI server (HTTP 429).">
    Too many requests (429). Wait a moment and try again.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_CLAUDE_OVERLOADED" desc="Error from Anthropic&#x27;s API (HTTP 529). Claude is the AI assistant&#x27;s name.">
    Claude is overloaded (529). Try again in a moment.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_HTTP" desc="Error from an AI server with an unexpected HTTP status. CODE is the status.">
    The server answered with HTTP <ph name="CODE">$1<ex>500</ex></ph>.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_NOT_MODEL_LIST" desc="Error when testing an AI server in Settings: it didn&#x27;t return a list of models.">
    The server answered, but not with a list of models. Check the endpoint URL.
  </message>
  <message name="IDS_COMPASS_AI_ERROR_STOPPED" desc="Error in the chat: Claude&#x27;s reply stopped with an error that has no description.">
    Claude stopped with an error.
  </message>
  <message name="IDS_COMPASS_AI_ENTER_URL" desc="Error when testing an AI server without its address.">
    Enter the server's URL first.
  </message>
  <message name="IDS_COMPASS_AI_ENTER_URL_IN_SETTINGS" desc="Error in the chat: the AI server&#x27;s address isn&#x27;t set.">
    Enter the server's URL in Compass's AI settings.
  </message>
  <message name="IDS_COMPASS_AI_ENTER_KEY_IN_SETTINGS" desc="Error in the chat: the API key isn&#x27;t set.">
    Enter an API key in Compass's AI settings.
  </message>
  <message name="IDS_COMPASS_AI_REQUEST_NOT_WRITTEN" desc="Error in the chat: the request to the AI couldn&#x27;t be prepared.">
    The request couldn't be written.
  </message>
  <message name="IDS_COMPASS_AI_REPLY_CUT_OFF" desc="Error in the chat: the AI&#x27;s reply stopped unexpectedly.">
    The reply was cut off. Try again.
  </message>
  <message name="IDS_COMPASS_AI_REPLY_FAILED" desc="Error in the chat: the AI&#x27;s reply failed without a reason.">
    The reply failed.
  </message>
  <message name="IDS_COMPASS_AI_KEY_UNREADABLE_SETTINGS" desc="Error in the chat: the saved API key can&#x27;t be decrypted.">
    The saved key can't be read any more. Enter it again in Compass's AI settings.
  </message>
  <message name="IDS_COMPASS_AI_ADD_KEY_IN_SETTINGS" desc="Error in the chat: no API key is set.">
    Add your API key in Compass's AI settings.
  </message>
  <message name="IDS_COMPASS_AI_PROVIDER_COMPATIBLE" desc="Name of the AI provider choice for any server with OpenAI&#x27;s API, in Settings.">
    Other (OpenAI-compatible)
  </message>
  <message name="IDS_COMPASS_AI_KEY_PLACEHOLDER_COMPATIBLE" desc="Placeholder of the API key field for an OpenAI-compatible AI server.">
    Key (if the server needs one)
  </message>
  <message name="IDS_COMPASS_AI_PRIVACY_ANTHROPIC" desc="Note under the AI provider choice in Settings: where chats are sent.">
    Chats and the sidebar's requests go to Anthropic, or the endpoint under Advanced.
  </message>
  <message name="IDS_COMPASS_AI_PRIVACY_OPENAI" desc="Note under the AI provider choice in Settings: where chats are sent.">
    Chats and the sidebar's requests go to OpenAI, under its terms, instead of Anthropic.
  </message>
  <message name="IDS_COMPASS_AI_PRIVACY_GEMINI" desc="Note under the AI provider choice in Settings: where chats are sent.">
    Chats and the sidebar's requests go to Google, under the Gemini API's terms, instead of Anthropic.
  </message>
  <message name="IDS_COMPASS_AI_PRIVACY_COMPATIBLE" desc="Note under the AI provider choice in Settings: where chats are sent.">
    Chats and the sidebar's requests go to the server below, instead of Anthropic.
  </message>
  <message name="IDS_COMPASS_AI_ON_DEVICE_UNSUPPORTED" desc="Shown when Apple Intelligence (Apple&#x27;s on-device AI, a product name) can&#x27;t run on this Mac.">
    This Mac can't run Apple Intelligence: it needs macOS 26 or later on a Mac with Apple silicon.
  </message>
  <message name="IDS_COMPASS_AI_ON_DEVICE_DISABLED" desc="Shown when Apple Intelligence is off in macOS settings.">
    Apple Intelligence is turned off in System Settings.
  </message>
  <message name="IDS_COMPASS_AI_ON_DEVICE_NOT_READY" desc="Shown while Apple Intelligence&#x27;s model is still downloading.">
    Apple Intelligence is still downloading. Try again later.
  </message>
  <message name="IDS_COMPASS_CHATGPT_SIGN_IN_TIMED_OUT" desc="Error when signing in with a ChatGPT account in Settings.">
    The sign-in timed out. Try again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_SIGN_IN_CANCELED" desc="Shown when the user canceled signing in with ChatGPT.">
    The sign-in was cancelled.
  </message>
  <message name="IDS_COMPASS_CHATGPT_NO_LISTENER" desc="Error signing in with ChatGPT: Compass couldn&#x27;t open a local port for the sign-in reply.">
    Compass couldn't listen for ChatGPT's answer on this device.
  </message>
  <message name="IDS_COMPASS_CHATGPT_CALLBACK_WRONG_SIGN_IN" desc="Shown on the page ChatGPT&#x27;s sign-in returns to, when it&#x27;s from an old sign-in attempt.">
    This page isn't from Compass's current sign-in. Go back to Compass and try again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_DENIED" desc="Error signing in with ChatGPT: the user denied access.">
    You didn't allow Compass to use ChatGPT.
  </message>
  <message name="IDS_COMPASS_CHATGPT_REFUSED" desc="Error signing in with ChatGPT. ERROR is a technical error code.">
    ChatGPT refused the sign-in (<ph name="ERROR">$1<ex>server_error</ex></ph>).
  </message>
  <message name="IDS_COMPASS_CHATGPT_NO_CODE" desc="Error signing in with ChatGPT: its reply had no authorization code.">
    ChatGPT's answer had no sign-in code. Try again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_CODE_REFUSED" desc="Error signing in with ChatGPT: the authorization code was refused.">
    The sign-in code was refused. Try again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_NO_PLAN_SCOPE" desc="Error signing in with ChatGPT: the user&#x27;s ChatGPT plan can&#x27;t be used by Compass.">
    ChatGPT signed you in, but didn't let Compass use your plan. Sign in again and allow it, or check that your plan includes using it in other apps.
  </message>
  <message name="IDS_COMPASS_CHATGPT_NO_REFRESH_TOKEN" desc="Error signing in with ChatGPT: no long-lived sign-in came back.">
    ChatGPT didn't give Compass a lasting sign-in. Try again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_NOT_STORED" desc="Error signing in with ChatGPT: the OS keychain refused to store it.">
    The sign-in couldn't be stored: the system's secure storage refused it.
  </message>
  <message name="IDS_COMPASS_CHATGPT_CALLBACK_SIGNED_IN" desc="Shown on the page ChatGPT&#x27;s sign-in returns to, after signing in.">
    Compass can now use your ChatGPT plan. You can close this tab.
  </message>
  <message name="IDS_COMPASS_CHATGPT_SIGN_IN_IN_SETTINGS" desc="Error in the chat when using a ChatGPT plan without being signed in.">
    Sign in with ChatGPT in Compass's AI settings.
  </message>
  <message name="IDS_COMPASS_CHATGPT_SESSION_UNREADABLE" desc="Error in the chat: the saved ChatGPT sign-in can&#x27;t be decrypted.">
    Your ChatGPT sign-in can't be read any more. Sign in again in Compass's AI settings.
  </message>
  <message name="IDS_COMPASS_CHATGPT_SESSION_ENDED" desc="Error in the chat: the ChatGPT sign-in expired or was revoked.">
    Your ChatGPT sign-in has ended. Sign in again in Compass's AI settings.
  </message>
  <message name="IDS_COMPASS_CHATGPT_NOT_REGISTERED" desc="Error signing in with ChatGPT: Compass&#x27;s app registration didn&#x27;t finish.">
    ChatGPT didn't finish registering Compass. Try signing in again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_OTHER_REGISTRATION" desc="Error signing in with ChatGPT: the reply was for another app registration.">
    ChatGPT answered for another registration than Compass's. Try signing in again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_UNREACHABLE" desc="Error: ChatGPT&#x27;s servers couldn&#x27;t be reached.">
    Couldn't reach ChatGPT. Check the connection.
  </message>
  <message name="IDS_COMPASS_CHATGPT_SIGN_IN_ENDED" desc="Error: the ChatGPT sign-in expired or was revoked.">
    Your ChatGPT sign-in has ended. Sign in again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_REGISTRATION_GONE" desc="Error: ChatGPT no longer knows Compass&#x27;s app registration.">
    ChatGPT doesn't know Compass's registration any more. Sign in again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_SIGN_IN_UNAVAILABLE" desc="Error: ChatGPT&#x27;s sign-in service is down.">
    ChatGPT's sign-in is unavailable right now. Try again in a moment.
  </message>
  <message name="IDS_COMPASS_CHATGPT_REFUSED_HTTP" desc="Error: ChatGPT refused signing in. CODE is the HTTP status.">
    ChatGPT refused the sign-in (HTTP <ph name="CODE">$1<ex>400</ex></ph>).
  </message>
  <message name="IDS_COMPASS_CHATGPT_PLAN_LIMIT" desc="Error in the chat: the user&#x27;s ChatGPT plan reached its usage limit. URL is the page showing usage.">
    You've reached your ChatGPT plan's usage limit (or the limit you set for Compass). See <ph name="URL">$1<ex>https://chatgpt.com/settings/usage</ex></ph>, or use an API key instead.
  </message>
  <message name="IDS_COMPASS_CHATGPT_PLAN_NOT_ELIGIBLE" desc="Error in the chat: the user&#x27;s ChatGPT plan can&#x27;t be used outside ChatGPT.">
    Your ChatGPT plan can't be used in other apps. Use an OpenAI API key instead.
  </message>
  <message name="IDS_COMPASS_CHATGPT_PLAN_UNAVAILABLE" desc="Error in the chat: ChatGPT plan usage is temporarily unavailable.">
    ChatGPT plan usage is unavailable right now. Try again in a moment.
  </message>
  <message name="IDS_COMPASS_CHATGPT_PLAN_INVALID_USER" desc="Error in the chat: ChatGPT didn&#x27;t accept the sign-in.">
    ChatGPT didn't accept your sign-in. If you disconnected Compass in ChatGPT's settings, sign in again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_PLAN_UNSUPPORTED" desc="Error in the chat: the request uses a feature the ChatGPT plan doesn&#x27;t support.">
    This request uses something your ChatGPT plan doesn't support here. Try another model, or an API key.
  </message>
  <message name="IDS_COMPASS_CHATGPT_REQUEST_REFUSED" desc="Error in the chat: ChatGPT refused the request. CODE is a technical error code.">
    ChatGPT refused the request (<ph name="CODE">$1<ex>chatpass_v2_scope_not_authorized</ex></ph>). Try signing in with ChatGPT again.
  </message>
  <message name="IDS_COMPASS_CHATGPT_CALLBACK_TITLE_OK" desc="Title of the page ChatGPT&#x27;s sign-in returns to, after signing in.">
    Signed in to ChatGPT
  </message>
  <message name="IDS_COMPASS_CHATGPT_CALLBACK_TITLE_FAILED" desc="Title of the page ChatGPT&#x27;s sign-in returns to, when signing in failed.">
    ChatGPT sign-in failed
  </message>
  <message name="IDS_COMPASS_CHATGPT_CALLBACK_HEADING_OK" desc="Heading of the page ChatGPT&#x27;s sign-in returns to, after signing in.">
    You're signed in
  </message>
  <message name="IDS_COMPASS_CHATGPT_CALLBACK_HEADING_FAILED" desc="Heading of the page ChatGPT&#x27;s sign-in returns to, when signing in failed.">
    Sign-in didn't work
  </message>
  <message name="IDS_COMPASS_AI_TOKEN_RISKS" desc="Error in Compass&#x27;s AI settings and chat: the key is a Claude subscription token, which needs a switch turned on. Keep `claude setup-token` as is; the quoted switch name must match its label in Settings.">
    This is a token from `claude setup-token`, which uses your Claude subscription. To use it, turn on "Accept the risks of subscription tokens" in Compass's Claude settings.
  </message>
  <message name="IDS_COMPASS_AI_TOKEN_RISKS_ANDROID" desc="On Android, error in the Claude sheet: the key is a Claude subscription token, which needs a switch turned on.">
    This is a token from `claude setup-token`, which uses your Claude subscription. To use it, turn on "Accept the risks of subscription tokens" in the Claude sheet's menu (Settings).
  </message>
  <message name="IDS_COMPASS_CHATGPT_SIGNED_OUT_NOT_REVOKED" desc="On Android, note after signing out of ChatGPT when OpenAI didn&#x27;t confirm revoking access.">
    Signed out of Compass. OpenAI didn't confirm revoking the sign-in: you can disconnect Compass in ChatGPT's settings.
  </message>
  <message name="IDS_COMPASS_AI_ADD_PROVIDER_KEY" desc="On Android, error in the Claude sheet: no API key for the chosen AI provider. PROVIDER is its name.">
    Add your <ph name="PROVIDER">$1<ex>OpenAI</ex></ph> API key first.
  </message>
  <message name="IDS_COMPASS_AI_NOTICE_MAX_TOKENS" desc="Notice in the chat: the AI&#x27;s answer hit its length limit.">
    The answer was cut off at its length limit.
  </message>
  <message name="IDS_COMPASS_AI_NOTICE_REFUSAL" desc="Notice in the chat: Claude refused to answer.">
    Claude declined to answer this.
  </message>
  <message name="IDS_COMPASS_AI_BASE_URL_INVALID" desc="On Android, error testing an AI server&#x27;s address.">
    That URL isn't usable: it must be https (http only to this device), without a query.
  </message>
  <message name="IDS_COMPASS_AI_CONNECTED_MODELS" desc="On Android, result of testing the AI connection: how many models the server offers.">
    {COUNT, plural, =1 {Connected: 1 model available.} other {Connected: # models available.}}
  </message>
  <message name="IDS_COMPASS_AI_KEY_NOT_SAVED" desc="On Android, error saving the AI API key.">
    Couldn't save the key.
  </message>
  <message name="IDS_COMPASS_AI_ENTER_URL_IN_SETTINGS_ANDROID" desc="On Android, error in the chat: the AI server&#x27;s address isn&#x27;t set.">
    Enter the server's URL in Settings first.
  </message>
  <message name="IDS_COMPASS_AI_ENTER_MODEL_IN_SETTINGS_ANDROID" desc="On Android, error in the chat: the AI server&#x27;s model isn&#x27;t set.">
    Enter the server's model ID in Settings first.
  </message>
  <message name="IDS_COMPASS_AI_TOO_MANY_TOOL_ROUNDS" desc="Error in the chat: Claude kept using tools for too many rounds.">
    Claude used tools for too long; ask again to go on.
  </message>
  <message name="IDS_COMPASS_AI_MEMORY_NOT_ADDED" desc="On Android, error adding a fact to Claude&#x27;s memory.">
    Couldn't add the memory.
  </message>
  <message name="IDS_COMPASS_AI_MEMORY_NOT_CHANGED" desc="On Android, error changing a fact in Claude&#x27;s memory.">
    Couldn't change the memory.
  </message>
  <message name="IDS_COMPASS_READER_PAGE_UNREADABLE" desc="On Android, error in reader mode: the page&#x27;s text couldn&#x27;t be extracted.">
    This page couldn't be read (it may still be loading).
  </message>
  <message name="IDS_COMPASS_ROOMS_SHARING_UNAVAILABLE" desc="On Android, error: sharing with other people isn&#x27;t available.">
    Sharing isn't available.
  </message>
  <message name="IDS_COMPASS_EASELS_UNAVAILABLE" desc="On Android, error: Easels can&#x27;t be used here. Easel is a feature name.">
    Easels aren't available here.
  </message>
  <message name="IDS_COMPASS_EASELS_SIDEBAR_LOADING" desc="On Android, error creating an Easel before the sidebar loaded.">
    The sidebar is still loading. Try again in a moment.
  </message>
  <message name="IDS_COMPASS_EASELS_NO_PAGE" desc="On Android, error capturing to an Easel without a page open.">
    There's no page.
  </message>
  <message name="IDS_COMPASS_EASELS_CANT_CAPTURE" desc="On Android, error: this page can&#x27;t be captured to an Easel.">
    This page can't be captured.
  </message>
  <message name="IDS_COMPASS_EASELS_DELETED" desc="On Android, error: the Easel was deleted meanwhile.">
    That Easel was deleted.
  </message>
  <message name="IDS_COMPASS_SYNC_INVITE_LINK_INVALID" desc="Error in sync settings when the text pasted as an invite link to someone's sync chain isn't one. The placeholder is an example link.">
    Paste the whole invite link, like <ph name="EXAMPLE_LINK">$1<ex>https://compass-sync.example.workers.dev/invite#…</ex></ph>.
  </message>
</grit-part>
