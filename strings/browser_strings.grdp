<?xml version="1.0" encoding="utf-8"?>
<grit-part>
  <message name="IDS_COMPASS_SYNC_MENU_DEVICE_REMOVED" desc="Sync status in the app menu and on the sync page: another device removed this one from sync.">
    Sync: device removed
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_SERVER_FULL" desc="Sync status in the app menu: the sync server has no room left.">
    Sync: server full
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_THROTTLED" desc="Sync status in the app menu: the sync server asked Compass to slow down.">
    Sync: paused by server
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_HISTORY_FULL" desc="Sync status in the app menu: sync works, but browsing history no longer fits on the server.">
    Synced (history full)
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_OFF" desc="Sync status in the app menu: sync isn&#x27;t turned on.">
    Sync is off
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_NEEDS_RESTART" desc="Sync status in the app menu: Compass must restart to finish turning sync on or off.">
    Sync: restart to finish
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_STARTING" desc="Sync status in the app menu: sync is starting.">
    Syncing…
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_ON" desc="Sync status in the app menu: everything is synced.">
    Synced
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_ERROR" desc="Sync status in the app menu: sync stopped because of an error.">
    Sync error
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_LOGIN_REQUIRED" desc="Sync status in the app menu: the sync server wants the user to sign in again.">
    Sync: sign in needed
  </message>
  <message name="IDS_COMPASS_SYNC_MENU_DEFAULT" desc="App menu item that opens sync settings, when there&#x27;s no status to show.">
    Sync
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_SERVER_FULL" desc="Sync status on the sync settings page: the sync server has no room left for this group of synced devices (the &quot;chain&quot;).">
    The sync server is full for this chain: new changes stay on this device. Remove data you don't need, or ask the server's owner to raise its limits.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_THROTTLED" desc="Sync status on the sync settings page: the server is slowing this device down.">
    The sync server is holding this device back (too many devices in the chain, or too many requests). Compass tries again by itself.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_HISTORY_FULL" desc="Sync status on the sync settings page, after the last-synced time: browsing history no longer fits on the server.">
    History is full on the server: new visits stay on this device until older ones expire.
  </message>
  <message name="IDS_COMPASS_SYNC_STARTING_READING_KEY" desc="Sync status while sync starts: reading the device&#x27;s encryption key.">
    Starting: reading this device's sync key…
  </message>
  <message name="IDS_COMPASS_SYNC_STARTING_CONNECTING" desc="Sync status while sync starts: connecting to the server.">
    Starting: connecting to the sync server…
  </message>
  <message name="IDS_COMPASS_SYNC_STARTING_ENCRYPTION" desc="Sync status while sync starts: setting up encryption.">
    Starting: setting up encryption…
  </message>
  <message name="IDS_COMPASS_SYNC_STARTING_CONFIGURING" desc="Sync status while sync starts: preparing the data types.">
    Starting: getting the data ready to sync…
  </message>
  <message name="IDS_COMPASS_SYNC_STARTING_STUCK" desc="Added after a starting sync status when it has taken a long time.">
    This is taking long. Restart Compass if it doesn't change.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_DEVICE_REMOVED" desc="Sync status on the sync settings page: another device removed this one from sync.">
    This device was removed from sync on another device. Its data stays here. Leave sync to set it up again.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_FINISH_IN_TAB" desc="Sync status while the user signs in to the sync server in a browser tab. USER_CODE is a short code the sign-in page also shows.">
    Finish signing in in the tab that opened. Check that it shows the code <ph name="USER_CODE">$1<ex>WDJB-MJHT</ex></ph>.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_STARTING" desc="Sync status while sign-in to the sync server starts.">
    Starting sign-in…
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_LEFT" desc="Sync status after the user left sync, until Compass restarts.">
    Restart Compass to finish leaving sync.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_RESET" desc="Sync status after the user reset sync (started a new group of synced devices, a &quot;chain&quot;).">
    Restart Compass to start the new sync chain. Then add your other devices again.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_REQUIRED" desc="Sync status: the sync server asks the user to sign in. Followed by how to finish signing in.">
    This server requires sign-in.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_REQUIRED_WITH" desc="Sync status: the sync server asks the user to sign in with an identity provider. Followed by how to finish signing in.">
    This server requires sign-in with <ph name="PROVIDER">$1<ex>Acme SSO</ex></ph>.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_OFF_FOR_PROFILE" desc="Sync status: sync can&#x27;t run for this browser profile.">
    Sync is turned off for this profile.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_RESTART_TO_START" desc="Sync status: sync is set up and starts after a restart.">
    Restart Compass to start syncing.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_PROFILE_REFUSED" desc="Sync error: the sync server doesn&#x27;t allow this browser profile&#x27;s account.">
    The sync server refused this profile (it may serve only invited people). Ask the server's owner to allow it.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_CHAIN_REFUSED" desc="Sync error: the sync server doesn&#x27;t allow this group of synced devices (the &quot;chain&quot;).">
    The sync server refused this device's chain (it may serve only invited people). Ask the server's owner to allow it.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_KEY_UNREADABLE" desc="Sync error: the encryption key stored on this device can&#x27;t be read.">
    Couldn't read this device's sync key. Leave sync and join again.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_PASSPHRASE_REJECTED" desc="Sync error: the data on the server was encrypted with another key.">
    The data on the server is encrypted for another chain. Leave sync and join again with the right code.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_STOPPED" desc="Sync error: sync stopped. ERROR is a technical description of the error, in English.">
    Sync stopped: <ph name="ERROR">$1<ex>Datatype error</ex></ph>
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_KEY_REFUSED_AT" desc="Sync error: the server refused this device&#x27;s key. TIME is when it happened.">
    The server refused this device's key (<ph name="TIME">$1<ex>Nov 26, 2026, 10:42 AM</ex></ph>).
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_UNREACHABLE_AT" desc="Sync error: the server couldn&#x27;t be reached. TIME is when it happened.">
    Can't reach the server (<ph name="TIME">$1<ex>Nov 26, 2026, 10:42 AM</ex></ph>).
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_SYNCING" desc="Sync status: syncing, not finished yet.">
    Syncing…
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_LAST_SYNCED" desc="Sync status: when this device last synced.">
    Last synced <ph name="TIME">$1<ex>Nov 26, 2026, 10:42 AM</ex></ph>.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_ADDED" desc="Shown on the device that added another one to sync.">
    Device added. It starts syncing after a restart.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_DENIED" desc="Shown on the device that was asked to add another one, after the user said no.">
    Not added.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_WRONG_CODE" desc="Pairing error: the other device entered a wrong code.">
    Wrong code. Try again with a new code.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_CANCELED" desc="Pairing error: the other device stopped pairing.">
    The other device canceled.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_EXPIRED" desc="Pairing error: the pairing code is no longer valid.">
    The code expired. Try again with a new code.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_RATE_LIMITED" desc="Pairing error: the sync server is busy.">
    The server is busy. Try again in a few minutes.
  </message>
  <message name="IDS_COMPASS_SYNC_SERVER_UNREACHABLE" desc="Sync error: the sync server didn&#x27;t answer.">
    Couldn't reach the server.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_JOINED" desc="Shown on a device that joined sync with a pairing code.">
    Joined. Restart Compass to start syncing.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_DENIED" desc="Pairing error: the other device didn&#x27;t allow this one.">
    Not added: the other device said no.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_BAD_CODE" desc="Pairing error: the code the user typed isn&#x27;t in the right format. 7-482913 is an example code, keep it as is.">
    Enter the code as shown, like 7-482913.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_NO_SUCH_CODE" desc="Pairing error: the server doesn&#x27;t know the code.">
    No such code on this server, or it expired.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_CODE_USED" desc="Pairing error: the code was already used.">
    That code was already used. Ask for a new one.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_WRONG_CODE" desc="Pairing error: the code is wrong.">
    Wrong code. Ask the other device for a new one.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_CANCELED" desc="Pairing error: the other device stopped pairing.">
    The other device canceled. Ask for a new code.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_CLOSED" desc="Pairing error: the other device ended pairing.">
    The other device ended pairing. Check the code and ask for a new one.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_EXPIRED" desc="Pairing error: the code expired.">
    Code expired. Ask for a new one.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_RATE_LIMITED" desc="Pairing error: too many attempts.">
    Too many attempts. Try again in a few minutes.
  </message>
  <message name="IDS_COMPASS_SYNC_SETUP_ALREADY_RESTART" desc="Sync setup error: sync is already set up on this device.">
    Sync is already set up. Restart first.
  </message>
  <message name="IDS_COMPASS_SYNC_SETUP_BAD_URL" desc="Sync setup error: the server address isn&#x27;t valid. Keep the example URL as is.">
    Enter the server's URL, like https://sync.example.com/v2.
  </message>
  <message name="IDS_COMPASS_SYNC_SETUP_IN_PROGRESS" desc="Sync setup error: another setup is running.">
    Sync is being set up.
  </message>
  <message name="IDS_COMPASS_SYNC_SETUP_ALREADY" desc="Sync setup error: sync is already set up on this device.">
    Sync is already set up.
  </message>
  <message name="IDS_COMPASS_SYNC_SETUP_BAD_RECOVERY_CODE" desc="Sync setup error: the 12-word recovery code isn&#x27;t valid.">
    That recovery code isn't valid. Check the 12 words.
  </message>
  <message name="IDS_COMPASS_SYNC_SETUP_KEY_NOT_STORED" desc="Sync setup error: the encryption key couldn&#x27;t be saved on this device.">
    Couldn't store the sync key.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_NO_SERVER" desc="Pairing error: no sync server is set.">
    No server is set.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_SHOW_CODE" desc="Shown next to the pairing code the user types on their other device.">
    Enter this code on the other device.
  </message>
  <message name="IDS_COMPASS_SYNC_JOIN_WAITING" desc="Shown while a joining device waits for the other one to allow it.">
    Confirm on the other device.
  </message>
  <message name="IDS_COMPASS_SYNC_REMOVE_DEVICE_THIS_DEVICE" desc="Error when removing a device from sync: it&#x27;s the device the user is on.">
    That's this device. To stop syncing it, leave sync.
  </message>
  <message name="IDS_COMPASS_SYNC_REMOVE_DEVICE_LOGIN_REQUIRED" desc="Error when removing a device from sync: the server wants the user to sign in.">
    The sync server wants you to sign in again first.
  </message>
  <message name="IDS_COMPASS_SYNC_REMOVE_DEVICE_UNAUTHORIZED" desc="Error when removing a device from sync: the server refused this device&#x27;s key.">
    The sync server refused this device's key.
  </message>
  <message name="IDS_COMPASS_SYNC_REMOVE_DEVICE_REMOVED" desc="Error when removing a device from sync: this device itself was removed.">
    This device was removed from sync on another device.
  </message>
  <message name="IDS_COMPASS_SYNC_REMOVE_DEVICE_UNSUPPORTED" desc="Error when removing a device from sync: the server is too old.">
    This sync server can't remove devices. Update it, then try again.
  </message>
  <message name="IDS_COMPASS_SYNC_REMOVE_DEVICE_FAILED" desc="Error when removing a device from sync: the server didn&#x27;t answer.">
    Couldn't remove the device: the server didn't answer. Try again.
  </message>
  <message name="IDS_COMPASS_SYNC_NOT_RUNNING" desc="Sync error for an action that needs sync running.">
    Sync isn't running on this device.
  </message>
  <message name="IDS_COMPASS_SYNC_RESET_UNREACHABLE" desc="Error when resetting sync: the server couldn&#x27;t be reached.">
    Couldn't reach your sync server to move it to the new chain. Nothing changed; try again.
  </message>
  <message name="IDS_COMPASS_SYNC_MAPPING_NOT_NEEDED" desc="Error when matching this device&#x27;s browser profiles with the synced ones: nothing to match.">
    There's nothing to map.
  </message>
  <message name="IDS_COMPASS_SYNC_MAPPING_INVALID" desc="Error when matching this device&#x27;s browser profiles with the synced ones: one synced profile was picked twice.">
    Each profile of the chain can go to one profile only.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_SIGN_IN_TO_SYNC" desc="Sync status: the user must sign in to the sync server.">
    Sign in to sync.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_SIGN_IN_TO_SYNC_WITH" desc="Sync status: the user must sign in to the sync server with an identity provider.">
    Sign in to <ph name="PROVIDER">$1<ex>Acme SSO</ex></ph> to sync.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_SIGN_IN" desc="Shown while setting up a free sync server on Cloudflare: the user signs in in a new tab.">
    Sign in to Cloudflare in the new tab and allow Compass…
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_NO_TOKEN" desc="Error when setting up a sync server on Cloudflare: no access token was pasted.">
    Paste your Cloudflare token.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_NO_SCRIPT" desc="Error when setting up a sync server on Cloudflare: this Compass build doesn&#x27;t include the server.">
    This build has no sync server to set up.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_CONNECTING" desc="Shown while setting up a sync server on Cloudflare.">
    Connecting to Cloudflare…
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_STARTING" desc="Shown while setting up a sync server on Cloudflare, once the server is up.">
    Starting sync…
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_BUSY" desc="Error: the sync server is already being set up or updated.">
    The server is being set up or updated.
  </message>
  <message name="IDS_COMPASS_SYNC_CLOUDFLARE_CANT_UPDATE" desc="Error: Compass can&#x27;t update this sync server.">
    This server can't be updated from here.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_RATE_LIMITED" desc="Sign-in error: too many attempts.">
    Too many sign-in attempts. Try again in a few minutes.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_START_FAILED" desc="Sign-in error: the server couldn&#x27;t start signing in.">
    The server couldn't start the sign-in.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_DENIED" desc="Sign-in error: the identity provider denied sign-in.">
    Sign-in was denied.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_EXPIRED" desc="Sign-in error: the user took too long.">
    The sign-in timed out.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_CANCELED" desc="Sign-in error: the user canceled.">
    Sign-in canceled.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_PROVIDER_UNAVAILABLE" desc="Sign-in error: the identity provider can&#x27;t be reached.">
    Can't reach <ph name="PROVIDER">$1<ex>Acme SSO</ex></ph> right now. Try again.
  </message>
  <message name="IDS_COMPASS_SYNC_LOGIN_UNAVAILABLE" desc="Sign-in error: the sign-in service can&#x27;t be reached.">
    Can't reach the sign-in service right now. Try again.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_MAP_PROFILES_MAC" desc="Sync status on a Mac: the user must choose which synced profile each of this Mac&#x27;s other browser profiles syncs with.">
    Choose how this Mac's other profiles sync.
  </message>
  <message name="IDS_COMPASS_SYNC_STATUS_MAP_PROFILES" desc="Sync status on Windows and Linux: the user must choose which synced profile each of this computer&#x27;s other browser profiles syncs with.">
    Choose how this computer's other profiles sync.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_MAP_PROFILES_MAC" desc="Shown on a Mac after it joined sync, above a list of its browser profiles; Continue is the button below.">
    Choose how this Mac's other profiles sync, then Continue.
  </message>
  <message name="IDS_COMPASS_SYNC_PAIRING_MAP_PROFILES" desc="Shown on Windows and Linux after the computer joined sync, above a list of its browser profiles; Continue is the button below.">
    Choose how this computer's other profiles sync, then Continue.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_NETWORK" desc="Error when sharing a folder, space or Easel with other people: the sync server couldn&#x27;t be reached.">
    Can't reach the sync server. Check your connection and try again.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_LOGIN_REQUIRED" desc="Sharing error: the user must sign in to their company&#x27;s sync server.">
    Sign in to your company's sync server first.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_CHAIN_NOT_ALLOWED" desc="Sharing error: the sync server doesn&#x27;t allow sharing from this browser.">
    This sync server doesn't let this browser share.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_GONE" desc="Sharing error: the user was removed from a shared item.">
    You're no longer a member of this.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_FORBIDDEN" desc="Sharing error: only the person who shared the item can do this.">
    Only the owner can do that.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_QUOTA" desc="Sharing error: the sharer&#x27;s sync storage is full.">
    The owner's sync storage is full.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_INVITE_EXPIRED" desc="Sharing error: an invite link expired.">
    This invite link has expired.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_INVITE_USED_UP" desc="Sharing error: an invite link was used as many times as allowed.">
    This invite link has been used up.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_INVITE_REVOKED" desc="Sharing error: an invite link was revoked.">
    This invite link no longer works.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_ROOM_FULL" desc="Sharing error: a shared item has the most members it can have.">
    This is shared with as many people as it can be (50).
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_OWNER_MUST_TRANSFER" desc="Sharing error: the owner tried to leave their own shared item.">
    You own this: delete it for everyone instead.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_REMOVED" desc="Sharing error: the user was removed from a shared item.">
    You were removed. Ask for a new invite.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_UNKNOWN" desc="Generic sharing error.">
    Something went wrong.
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_WITH_CODE" desc="Generic sharing error with a technical error code.">
    Something went wrong (<ph name="ERROR_CODE">$1<ex>bad_request</ex></ph>).
  </message>
  <message name="IDS_COMPASS_ROOMS_ERROR_ROOM_GONE" desc="Sharing error: the shared item was removed while joining it.">
    The room went away.
  </message>
  <message name="IDS_COMPASS_ROOMS_SHARED" desc="Tooltip of a sidebar item shared with other people.">
    Shared
  </message>
  <message name="IDS_COMPASS_ROOMS_SHARED_VIEW_ONLY" desc="Tooltip of a sidebar item someone shared with the user, who can only view it.">
    Shared (view only)
  </message>
  <message name="IDS_COMPASS_ROOMS_SOMEONE" desc="Stands for a member of a shared item whose name isn&#x27;t known, in a list of names.">
    Someone
  </message>
  <message name="IDS_COMPASS_ROOMS_SHARED_WITH" desc="Tooltip of a sidebar item shared with other people. NAMES is a comma-separated list of their names.">
    Shared with <ph name="NAMES">$1<ex>Anna, Marco</ex></ph>
  </message>
  <message name="IDS_COMPASS_ROOMS_VIEW_ONLY_TOOLTIP" desc="Tooltip of a shared sidebar item the user can only view. TOOLTIP is the tooltip saying who it&#x27;s shared with.">
    <ph name="TOOLTIP">$1<ex>Shared with Anna, Marco</ex></ph> (view only)
  </message>
  <message name="IDS_COMPASS_ROOMS_SHARE_NEEDS_SYNC" desc="Error when the user tries to share an item without sync turned on.">
    Turn on sync to share. Sharing goes through your sync server.
  </message>
  <message name="IDS_COMPASS_ROOMS_JOIN_NEEDS_SYNC" desc="Error when the user opens an invite link without sync turned on.">
    Turn on sync to join. Shared items sync through your sync account.
  </message>
  <message name="IDS_COMPASS_ROOMS_CANT_SHARE" desc="Sharing error: this kind of item can&#x27;t be shared.">
    This can't be shared.
  </message>
  <message name="IDS_COMPASS_ROOMS_NOT_SHARED" desc="Sharing error: the item isn&#x27;t shared (any more).">
    Not shared.
  </message>
  <message name="IDS_COMPASS_ROOMS_TRY_AGAIN_SOON" desc="Sharing error: Compass is still busy; the user should retry shortly.">
    Try again in a moment.
  </message>
  <message name="IDS_COMPASS_ROOMS_NO_SUCH_ACCOUNT" desc="Error when inviting someone by email to a shared item: nobody uses that email on the sync server.">
    Nobody with that email uses Compass on this server yet.
  </message>
  <message name="IDS_COMPASS_ROOMS_ALREADY_MEMBER" desc="Error when inviting someone to a shared item: they&#x27;re already a member.">
    They're already a member.
  </message>
  <message name="IDS_COMPASS_ROOMS_INVITE_INVALID" desc="Error when the user pastes something that isn&#x27;t an invite link.">
    This invite link isn't valid.
  </message>
  <message name="IDS_COMPASS_SHORTCUTS_SECTION_COMPASS" meaning="Shortcuts section heading" desc="Heading of a group of keyboard shortcuts in Settings: Compass&#x27;s own commands. Compass is the product name.">
    Compass
  </message>
  <message name="IDS_COMPASS_SHORTCUTS_SECTION_TABS" desc="Heading of a group of keyboard shortcuts in Settings: commands for tabs.">
    Tabs
  </message>
  <message name="IDS_COMPASS_SHORTCUTS_SECTION_WINDOWS" desc="Heading of a group of keyboard shortcuts in Settings: commands for browser windows.">
    Windows
  </message>
  <message name="IDS_COMPASS_SHORTCUTS_SECTION_BROWSER" desc="Heading of a group of keyboard shortcuts in Settings: commands that open browser pages (history, downloads, settings).">
    Browser
  </message>
  <message name="IDS_COMPASS_SHORTCUTS_SECTION_DEVELOPER" desc="Heading of a group of keyboard shortcuts in Settings: web developer commands.">
    Developer
  </message>
  <message name="IDS_COMPASS_SHORTCUTS_SECTION_SPACES" desc="Heading of a group of keyboard shortcuts in Settings: switching between spaces (groups of tabs).">
    Spaces
  </message>
  <message name="IDS_COMPASS_SHORTCUTS_NEW_TAB" desc="Keyboard shortcut name in Settings: opens a new tab through the command bar.">
    New tab (command bar)
  </message>
  <message name="IDS_COMPASS_SHORTCUTS_OPEN_LOCATION" desc="Keyboard shortcut name in Settings: edit the current page&#x27;s address.">
    Edit the page's address
  </message>
