  </message>
  <message name="IDS_COMPASS_SHARE_INVITE" desc="Button that invites the email address entered.">
    Invite
  </message>
  <message name="IDS_COMPASS_SHARE_INVITE_BY_EMAIL" desc="Heading of the invite by email form.">
    Invite by email
  </message>
