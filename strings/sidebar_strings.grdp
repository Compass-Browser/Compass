  <message name="IDS_COMPASS_SHARE_LEAVE_CONFIRM_EASEL" desc="Question before a member leaves a shared Easel.">
    Leave this Easel? You keep a copy, but won’t see new changes.
  </message>
  <message name="IDS_COMPASS_SHARE_LEAVE_CONFIRM_FOLDER" desc="Question before a member leaves a shared folder.">
    Leave this folder? You keep a copy, but won’t see new changes.
  </message>
  <message name="IDS_COMPASS_SHARE_BAD_LINK_TITLE" desc="Title of the join page when the invite link is broken.">
    This invite link doesn’t work
  </message>
  <message name="IDS_COMPASS_SHARE_BAD_LINK" desc="Join page text when the invite link is broken.">
    It may have been copied only in part. Ask for a new one.
  </message>
  <message name="IDS_COMPASS_SHARE_JOIN_TITLE" desc="Title of the page for joining a shared item.">
    Join “<ph name="NAME">$1<ex>Trip</ex></ph>”
  </message>
  <message name="IDS_COMPASS_SHARE_JOIN_INVITED_SPACE" desc="Join page text for a shared space.">
    You’ve been invited to a shared space on <ph name="SERVER">$1<ex>sync.example.com</ex></ph>. The person who shared it decides whether you can edit it or only view it.
  </message>
  <message name="IDS_COMPASS_SHARE_JOIN_INVITED_EASEL" desc="Join page text for a shared Easel.">
    You’ve been invited to a shared Easel on <ph name="SERVER">$1<ex>sync.example.com</ex></ph>. The person who shared it decides whether you can edit it or only view it.
  </message>
  <message name="IDS_COMPASS_SHARE_JOIN_INVITED_FOLDER" desc="Join page text for a shared folder.">
    You’ve been invited to a shared folder on <ph name="SERVER">$1<ex>sync.example.com</ex></ph>. The person who shared it decides whether you can edit it or only view it.
  </message>
  <message name="IDS_COMPASS_SHARE_ALREADY_JOINED" desc="Join page text when the user already joined.">
    You’ve already joined it.
  </message>
  <message name="IDS_COMPASS_SHARE_PUT_IT_IN" desc="Heading of the menu of spaces the joined item goes in.">
    Put it in
  </message>
  <message name="IDS_COMPASS_SHARE_JOIN" desc="Button that joins a shared item.">
    Join
  </message>
  <message name="IDS_COMPASS_SHARE_JOINING" desc="Shown on the join button while joining.">
    Joining…
  </message>
  <message name="IDS_COMPASS_SHARE_JOINED" desc="Title of the join page once joined.">
    Joined
  </message>
  <message name="IDS_COMPASS_SHARE_JOINED_IN_SIDEBAR" desc="Join page text once joined.">
    “<ph name="NAME">$1<ex>Trip</ex></ph>” is in your sidebar.
  </message>
  <message name="IDS_COMPASS_SIDEBAR_FAVORITES" desc="Accessible name of the sidebar's Favorites: the row of site tiles at its top, shared by every space.">
    Favorites
  </message>
  <message name="IDS_COMPASS_SIDEBAR_FAVORITES_HINT" desc="Shown in the empty Favorites row while a tab is dragged.">
    Drop here to add to Favorites
  </message>
  <message name="IDS_COMPASS_SIDEBAR_SPACE_NAME_TOOLTIP" desc="Tooltip of the space's name at the top of the sidebar.">
    Double-click to edit the space
  </message>
  <message name="IDS_COMPASS_SIDEBAR_TABS" desc="Accessible name of the sidebar's list of tabs.">
    Tabs
  </message>
  <message name="IDS_COMPASS_SIDEBAR_DISMISS" desc="Button that dismisses a notice in the sidebar.">
    Dismiss
  </message>
  <message name="IDS_COMPASS_SIDEBAR_PINNED" desc="Heading of the sidebar section of pinned tabs and folders, which stay until removed.">
    Pinned
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NEW_LIVE_FOLDER" desc="Button that creates a live folder: a folder a plugin fills with links (from a feed, GitHub...).">
    New live folder
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NEW_EASEL" desc="Button that creates an Easel (a board of notes, images and links). Easel is a feature name.">
    New Easel
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NEW_FOLDER" desc="Button that creates a folder in the sidebar.">
    New folder
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NEW_FOLDER_NAME" desc="The name a new folder in the sidebar gets.">
    New Folder
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NEW_TODAY_FOLDER" desc="Accessible name of the button that creates a folder in the Today section.">
    New folder in Today
  </message>
  <message name="IDS_COMPASS_SIDEBAR_PINNED_HINT" desc="Shown in the empty Pinned section.">
    Drag tabs here to pin them
  </message>
  <message name="IDS_COMPASS_SIDEBAR_TODAY" desc="Heading of the sidebar section of open tabs, which are archived after a while.">
    Today
  </message>
  <message name="IDS_COMPASS_SIDEBAR_TIDYING_TOOLTIP" desc="Tooltip of the Tidy button while Claude (an AI assistant) groups the tabs.">
    Claude is tidying Today
  </message>
  <message name="IDS_COMPASS_SIDEBAR_TIDY_TOOLTIP" desc="Tooltip of the Tidy button.">
    Group Today's tabs into folders with Claude
  </message>
  <message name="IDS_COMPASS_SIDEBAR_TIDYING" desc="The Tidy button while Claude groups the tabs.">
    Tidying…
  </message>
  <message name="IDS_COMPASS_SIDEBAR_TIDY" desc="Button that has Claude group the Today tabs into folders.">
    Tidy
  </message>
  <message name="IDS_COMPASS_SIDEBAR_CLEAR_TODAY_TOOLTIP" desc="Tooltip of the button that closes every tab in Today.">
    Close all Today tabs
  </message>
  <message name="IDS_COMPASS_SIDEBAR_CLEAR" desc="Button that empties a list (the Today tabs, the archive).">
    Clear
  </message>
  <message name="IDS_COMPASS_SIDEBAR_ARCHIVED_TABS" desc="Button and popup of the space's archived tabs.">
    Archived tabs
  </message>
  <message name="IDS_COMPASS_SIDEBAR_ARCHIVED" desc="Heading of the popup of archived tabs.">
    Archived
  </message>
  <message name="IDS_COMPASS_SIDEBAR_REMOVE_FROM_ARCHIVE" desc="Button that removes a tab from the archive.">
    Remove from archive
  </message>
  <message name="IDS_COMPASS_SIDEBAR_ARCHIVE_OFF" desc="Shown in the empty archive of a space that doesn't archive tabs.">
    Nothing archived. Auto-archive is off for this space.
  </message>
  <message name="IDS_COMPASS_SIDEBAR_ARCHIVE_EMPTY" desc="Shown in the empty archive, with how long until tabs are archived.">
    Nothing archived yet. Today tabs you haven't looked at for <ph name="DELAY">$1<ex>12 hours</ex></ph> come here.
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NEW_TAB" desc="Button that opens a new tab; also the name of a tab with no title.">
    New Tab
  </message>
  <message name="IDS_COMPASS_SIDEBAR_UNDO" desc="Button in a notice that undoes what was just done.">
    Undo
  </message>
  <message name="IDS_COMPASS_SIDEBAR_SPACES" desc="Accessible name of the row of spaces at the bottom of the sidebar.">
    Spaces
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NEW_SPACE" desc="Button that creates a space.">
    New space
  </message>
  <message name="IDS_COMPASS_SIDEBAR_SPACE_LOCAL_ONLY" desc="Tooltip of a space that isn't synced to the user's other devices.">
    <ph name="SPACE_NAME">$1<ex>Work</ex></ph> · On this device only
  </message>
  <message name="IDS_COMPASS_SIDEBAR_MUTE_TAB" desc="Button that mutes a tab playing sound.">
    Mute tab
  </message>
  <message name="IDS_COMPASS_SIDEBAR_UNMUTE_TAB" desc="Button that unmutes a muted tab.">
    Unmute tab
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NEW_NOTIFICATIONS" desc="Accessible name of the dot on a tab whose site has new notifications.">
    New notifications
  </message>
  <message name="IDS_COMPASS_SIDEBAR_NOTIFICATIONS" desc="Accessible name of the count of unread notifications on a tab.">
    {COUNT, plural, =1 {1 notification} other {# notifications}}
  </message>
  <message name="IDS_COMPASS_SIDEBAR_SHARE_MENU" desc="Button that opens the share sheet for an item that isn't shared yet.">
    Share…
  </message>
  <message name="IDS_COMPASS_SIDEBAR_SHARING_MENU" desc="Button that opens the share sheet for an item that is shared.">
    Sharing…
  </message>
  <message name="IDS_COMPASS_NODE_TAB_NAME" desc="Accessible name of the field for renaming a tab.">
    Tab name
  </message>
  <message name="IDS_COMPASS_NODE_FOLDER_NAME" desc="Accessible name of the field for renaming a folder.">
    Folder name
  </message>
  <message name="IDS_COMPASS_NODE_DELETE_FOLDER" desc="Button that deletes a folder.">
    Delete folder
  </message>
  <message name="IDS_COMPASS_NODE_UNSEEN" desc="Accessible name of the count of new links in a collapsed live folder.">
    {COUNT, plural, =1 {1 new} other {# new}}
  </message>
  <message name="IDS_COMPASS_NODE_UNLOAD_TAB" desc="Button on a loaded pinned tab that unloads it; the tab stays in the sidebar.">
    Unload tab
  </message>
  <message name="IDS_COMPASS_NODE_CLOSE_TAB" desc="Button that closes a tab.">
    Close tab
  </message>
  <message name="IDS_COMPASS_NODE_CLICK_AGAIN_TO_CLOSE" desc="Tooltip of a tab's close button after a first click, asking for a second one.">
    Click again to close
  </message>
  <message name="IDS_COMPASS_NODE_CLICK_AGAIN_TO_REMOVE" desc="Tooltip of an unloaded tab's remove button after a first click, asking for a second one.">
    Click again to remove
  </message>
  <message name="IDS_COMPASS_NOW_PLAYING_PICTURE_IN_PICTURE" desc="Button that plays the video in picture-in-picture (a floating window).">
    Picture in picture
  </message>
  <message name="IDS_COMPASS_NOW_PLAYING_GO_TO" desc="Accessible name of the button that shows the tab playing media.">
    Go to <ph name="TITLE">$1<ex>Song - YouTube</ex></ph>
  </message>
  <message name="IDS_COMPASS_NOW_PLAYING_PREVIOUS" desc="Media control: previous track.">
    Previous
  </message>
  <message name="IDS_COMPASS_NOW_PLAYING_NEXT" desc="Media control: next track.">
    Next
  </message>
  <message name="IDS_COMPASS_NOW_PLAYING_PLAY" desc="Media control: play.">
    Play
  </message>
  <message name="IDS_COMPASS_NOW_PLAYING_PAUSE" desc="Media control: pause.">
    Pause
  </message>
  <message name="IDS_COMPASS_NOW_PLAYING_MUTE" desc="Media control: mute.">
    Mute
  </message>
  <message name="IDS_COMPASS_NOW_PLAYING_UNMUTE" desc="Media control: unmute.">
    Unmute
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_THEME" desc="Space editor: the row and page for a space's theme (its colors).">
    Theme
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_EMOJI" desc="Space editor: the button and page for picking an emoji as the space's icon.">
    Emoji
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_NAME" desc="Accessible name of the space editor's name field.">
    Space name
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_ICON" desc="Space editor: heading of the choice of icons for the space.">
    Icon
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_NO_ICON" desc="Space editor: the choice of no icon (the space shows its initial).">
    No icon
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_SPACE" desc="Space editor: heading of the space's options.">
    Space
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_ARCHIVE_AFTER" desc="Space editor: label of the menu of how long until tabs in the Today section are archived.">
    Archive Today tabs after
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_PROFILE" desc="Space editor: label of the menu of the browser profile the space uses.">
    Profile
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_NEW_PROFILE" desc="Space editor: menu choice that creates a new browser profile for the space.">
    New profile…
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_SYNC" desc="Space editor: switch that syncs the space to the user's other devices.">
    Sync to your other devices
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_UNSYNC_CONFIRM" desc="Question before a space stops syncing.">
    Stop syncing “<ph name="SPACE_NAME">$1<ex>Work</ex></ph>”? It’s removed from your other devices and stays only on this one.
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_STOP_SYNCING" desc="Button that confirms a space stops syncing.">
    Stop syncing
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_LAST_SPACE" desc="Tooltip of the disabled delete button when only one space is left.">
    The last space can’t be deleted
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_DELETE" desc="Button that deletes the space.">
    Delete space
  </message>
  <message name="IDS_COMPASS_SPACE_EDITOR_DELETE_CONFIRM" desc="Question before a space is deleted.">
    Delete “<ph name="SPACE_NAME">$1<ex>Work</ex></ph>”? Its tabs close, and its pinned tabs and folders are deleted with it.
  </message>
  <message name="IDS_COMPASS_SPACE_OPTIONS_HOURS" desc="A number of hours, a choice of how long until a space's Today tabs are archived.">
    {COUNT, plural, =1 {1 hour} other {# hours}}
  </message>
  <message name="IDS_COMPASS_SPACE_OPTIONS_DAYS" desc="A number of days, a choice of how long until a space's Today tabs are archived.">
    {COUNT, plural, =1 {1 day} other {# days}}
  </message>
  <message name="IDS_COMPASS_SPACE_OPTIONS_NEVER" desc="The choice of never archiving a space's Today tabs.">
    Never
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_MATCH_SYSTEM" desc="Theme editor: appearance choice that follows the system's light or dark mode.">
    Match the system
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_LIGHT" desc="Theme editor: the light appearance.">
    Light
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_DARK" desc="Theme editor: the dark appearance.">
    Dark
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_MAIN_COLOR" desc="Theme editor: accessible name of the dot for the space's main color on the color pad.">
    Main color
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_COLOR" desc="Theme editor: accessible name of the dot for another color of the space's gradient, with its number.">
    Gradient color <ph name="NUMBER">$1<ex>2</ex></ph>
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_APPEARANCE" desc="Theme editor: accessible name of the choice between light, dark and the system's appearance.">
    Appearance
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLORS" desc="Theme editor: the color pad and the page of plain colors.">
    Colors
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_FEWER_COLORS" desc="Theme editor: button that removes a color from the space's gradient.">
    One color less
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_MORE_COLORS" desc="Theme editor: button that adds a color to the space's gradient.">
    One more color
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_PALETTE" desc="Theme editor: accessible name of the swatches of colors to pick from.">
    Palette
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_ANY_COLOR" desc="Theme editor: swatch that opens a picker for any color.">
    Any color
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENTS" desc="Theme editor: the page of preset gradients.">
    Gradients
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_INTENSITY" desc="Theme editor: slider for how strong the space's tint is.">
    Intensity
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRAIN" desc="Theme editor: dial for how much noise texture (film grain) the space's tint has.">
    Grain
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_TRANSLUCENCY" desc="Theme editor: slider for how see-through the sidebar is.">
    Translucency
  </message>
</grit-part>
