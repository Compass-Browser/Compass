  </message>
  <message name="IDS_COMPASS_SHARE_INVITE_EASEL" desc="Share sheet, before an Easel (a board of notes and images) is shared.">
    Invite people to this Easel. Everyone sees changes as they happen. It stays end-to-end encrypted: your sync server can’t read it.
  </message>
  <message name="IDS_COMPASS_SHARE_INVITE_FOLDER" desc="Share sheet, before a folder of tabs is shared.">
    Invite people to this folder. Everyone sees changes as they happen. It stays end-to-end encrypted: your sync server can’t read it.
  </message>
  <message name="IDS_COMPASS_SHARE_START" desc="Button that starts sharing an item.">
    Start sharing
  </message>
