    Copy invite link
  </message>
  <message name="IDS_COMPASS_SHARE_COPIED" desc="Shown on the button for a moment after the link was copied.">
    Copied
  </message>
  <message name="IDS_COMPASS_SHARE_INVITE_WITH_LINK" desc="Heading of the invite link options.">
    Invite with a link
  </message>
  <message name="IDS_COMPASS_SHARE_LINK_NOTE" desc="Note under the invite link options.">
