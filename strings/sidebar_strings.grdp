  </message>
  <message name="IDS_COMPASS_SHARE_REMOVE_MEMBER_CONFIRM" desc="Question before removing a member from a shared item.">
    Remove <ph name="NAME">$1<ex>Alex</ex></ph>? They keep a copy of what was shared, but won’t see new changes.
  </message>
  <message name="IDS_COMPASS_SHARE_PEOPLE" desc="Heading of the list of members of a shared item, with their number.">
    People (<ph name="COUNT">$1<ex>3</ex></ph>)
  </message>
  <message name="IDS_COMPASS_SHARE_INVITE_EXPIRES" desc="When an open invite link expires.">
    expires <ph name="DATE">$1<ex>12/31/2026</ex></ph>
  </message>
  <message name="IDS_COMPASS_SHARE_INVITE_NEVER_EXPIRES" desc="An open invite link that never expires.">
    never expires
  </message>
  <message name="IDS_COMPASS_SHARE_INVITE_USES_LEFT" desc="How many more times an invite link can be used.">
    {COUNT, plural, =1 {1 use left} other {# uses left}}
  </message>
  <message name="IDS_COMPASS_SHARE_REVOKE" desc="Button that revokes an invite link.">
    Revoke
  </message>
  <message name="IDS_COMPASS_SHARE_INVITE_LINKS" desc="Heading of the open invite links.">
    Invite links
  </message>
  <message name="IDS_COMPASS_SHARE_YOUR_NAME" desc="Heading of the field for the name other members see.">
    Your name for sharing
  </message>
  <message name="IDS_COMPASS_SHARE_YOUR_NAME_NOTE" desc="Note under the field for the name other members see.">
    What the people you share with see, unless your company’s sign-in gives your name.
  </message>
  <message name="IDS_COMPASS_SHARE_DELETE_FOR_EVERYONE" desc="Button with which the owner stops sharing an item.">
    Delete for everyone
  </message>
  <message name="IDS_COMPASS_SHARE_LEAVE" desc="Button with which a member leaves a shared item.">
    Leave
  </message>
  <message name="IDS_COMPASS_SHARE_STOP_CONFIRM_SPACE" desc="Question before the owner stops sharing a space.">
    Stop sharing this space and remove it from everyone else? You keep it.
  </message>
  <message name="IDS_COMPASS_SHARE_STOP_CONFIRM_EASEL" desc="Question before the owner stops sharing an Easel.">
    Stop sharing this Easel and remove it from everyone else? You keep it.
  </message>
  <message name="IDS_COMPASS_SHARE_STOP_CONFIRM_FOLDER" desc="Question before the owner stops sharing a folder.">
    Stop sharing this folder and remove it from everyone else? You keep it.
  </message>
  <message name="IDS_COMPASS_SHARE_LEAVE_CONFIRM_SPACE" desc="Question before a member leaves a shared space.">
