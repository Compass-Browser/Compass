    Expires in 7 days
  </message>
  <message name="IDS_COMPASS_SHARE_EXPIRES_1_DAY" desc="Choice for when an invite link expires.">
    Expires in 1 day
  </message>
  <message name="IDS_COMPASS_SHARE_NEVER_EXPIRES" desc="Choice for an invite link that never expires.">
    Never expires
  </message>
  <message name="IDS_COMPASS_SHARE_USES_ANY" desc="Choice for how many people an invite link can be used by.">
