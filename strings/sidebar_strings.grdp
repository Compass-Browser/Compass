<?xml version="1.0" encoding="utf-8"?>
<!-- The sidebar and the pages around it: the command bar, Claude's chat,
     the space editor, sharing, live folders, the find bar, the placeholder
     (resources/sidebar/, but its settings; browser/ui/webui/localized_strings/
     sidebar_strings.cc). -->
<grit-part>
  <message name="IDS_COMPASS_CLAUDE_CHAT_MODEL" desc="Claude chat: menu of Claude models.">
    Model
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_NEW_CHAT" desc="Claude chat: button that starts a new conversation.">
    New chat
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_NO_KEY_LEAD" desc="Claude chat, before an API key is set: what the chat does.">
    Chat with Claude about the page you're on.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_NO_KEY" desc="Claude chat, before an API key is set.">
    Compass ships no key: add your own Anthropic API key in settings.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_ADD_KEY" desc="Claude chat: button that opens the settings to add an API key.">
    Add an API key
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_EMPTY_LEAD" desc="Claude chat: shown before the first message.">
    Ask about the page you're on, or anything else.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_USING_TOOLTIP" desc="Claude chat: tooltip of the chip showing the tab Claude is working in.">
    Claude reads and acts in this tab
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_USING" desc="Claude chat: chip showing the tab Claude is working in.">
    Using <ph name="TAB_TITLE">$1<ex>Inbox</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_MORE_WAITING" desc="Claude chat: how many more requests for permission wait after this one.">
    {COUNT, plural, =1 {1 more waiting} other {# more waiting}}
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_DENY" desc="Claude chat: button that refuses Claude permission for an action.">
    Deny
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_ALLOW_FOR_CHAT" desc="Claude chat: button that allows an action for the rest of the conversation.">
    Allow for this chat
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_ALLOW" desc="Claude chat: button that allows an action once.">
    Allow
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_QUEUED" desc="Claude chat: accessible name of the messages waiting to be sent.">
    Queued messages
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_QUEUED_SENDS" desc="Claude chat: label of the queued messages while Claude replies.">
    Sends after this reply
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_QUEUED_PAUSED" desc="Claude chat: label of the queued messages when nothing is running.">
    Paused: send to go on
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_PLACEHOLDER" desc="AI chat: placeholder of the message field. ASSISTANT is the AI assistant's name: Claude, GPT or Gemini.">
    Ask <ph name="ASSISTANT">$1<ex>Claude</ex></ph>…
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_PLACEHOLDER_AI" desc="AI chat: placeholder of the message field, for an assistant with no name of its own (an OpenAI-compatible server).">
    Ask AI…
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_MESSAGE" desc="Claude chat: accessible name of the message field.">
    Message to Claude
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_QUEUE_TOOLTIP" desc="Claude chat: tooltip of the button that queues a message, with its shortcut.">
    Send after this reply (Enter)
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_QUEUE" desc="Claude chat: button that queues a message.">
    Send after this reply
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_STOP_TOOLTIP" desc="Claude chat: tooltip of the button that stops Claude, with its shortcut.">
    Stop (Esc)
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_STOP" desc="Claude chat: button that stops Claude.">
    Stop
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_SEND_TOOLTIP" desc="Claude chat: tooltip of the send button, with its shortcut.">
    Send (Enter)
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_SEND" desc="Claude chat: send button.">
    Send
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_SUGGEST_SUMMARIZE" desc="Claude chat: a suggested first message, sent to Claude as written.">
    Summarize this page
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_SUGGEST_KEY_POINTS" desc="Claude chat: a suggested first message, sent to Claude as written.">
    What are the key points?
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_SUGGEST_EXPLAIN" desc="Claude chat: a suggested first message, sent to Claude as written.">
    Explain this page simply
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_ATTACH_ON" desc="Claude chat: tooltip of the page chip when the page goes with the message.">
    Claude gets this page's text with your message
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_ATTACH_OFF" desc="Claude chat: tooltip of the page chip when the page doesn't go with the message.">
    Not sent
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOO_MANY_STEPS" desc="Claude chat: error when Claude took too many steps. &quot;go on&quot; is what the user can type; translate it.">
    Claude stopped after <ph name="COUNT">$1<ex>50</ex></ph> steps. Send "go on" to let it continue.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_UNDONE" desc="Claude chat: a memory or Boost change the user undid.">
    Undone
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_SCREENSHOT" desc="Claude chat: alt text of a screenshot Claude took.">
    Screenshot Claude took
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_THINKING" desc="Claude chat: heading of Claude's reasoning while it thinks.">
    Thinking…
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_THOUGHT" desc="Claude chat: heading of Claude's reasoning once done.">
    Thought
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_ANSWERING" desc="Claude chat: accessible name of the dots shown while Claude answers.">
    Claude is answering
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_REFUSED" desc="Claude chat: Claude refused to answer.">
    Claude declined to answer this.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_CUT_OFF" desc="Claude chat: Claude's answer hit its length limit.">
    The answer was cut off at its length limit.
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_RETRY" desc="Claude chat: button that asks again after an error.">
    Retry
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_BOOST_SAVED" desc="Claude chat: Claude saved a Boost (CSS and JavaScript for a site) for the sites shown.">
    Saved Boost for <ph name="SITES">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_BOOST_UPDATED" desc="Claude chat: Claude changed a Boost.">
    Updated Boost for <ph name="SITES">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_BOOST_DELETED" desc="Claude chat: Claude deleted a Boost.">
    Deleted Boost for <ph name="SITES">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_PLUGIN_SAVED" desc="Claude chat: Claude saved a live folder plugin.">
    Saved plugin <ph name="PLUGIN">$1<ex>rss</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_PLUGIN_UPDATED" desc="Claude chat: Claude changed a live folder plugin.">
    Updated plugin <ph name="PLUGIN">$1<ex>rss</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_PLUGIN_DELETED" desc="Claude chat: Claude deleted a live folder plugin.">
    Deleted plugin <ph name="PLUGIN">$1<ex>rss</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_MEMORY_SAVED" desc="Claude chat: Claude remembered something about the user, quoted.">
    Saved to memory: <ph name="TEXT">$1<ex>Prefers metric units</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_MEMORY_UPDATED" desc="Claude chat: Claude changed something it remembered.">
    Updated memory: <ph name="TEXT">$1<ex>Prefers metric units</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_MEMORY_FORGOT" desc="Claude chat: Claude forgot something it remembered.">
    Forgot: <ph name="TEXT">$1<ex>Prefers metric units</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_READ_PAGE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Read the page
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_GET_PAGE_TEXT" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Read the page's text
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_FIND" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Find “<ph name="QUERY">$1<ex>Sign in</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_SCREENSHOT" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Screenshot
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_READ_CONSOLE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Read the console
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_RUN_JS" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Run JavaScript
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_CLICK" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Click
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_CLICK_REF" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. The placeholder is an element's reference.">
    Click <ph name="ELEMENT">$1<ex>ref_12</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_CLICK_AT" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. The placeholder is a point's coordinates.">
    Click at <ph name="POINT">$1<ex>120, 340</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_HOVER" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Claude points the mouse at something.">
    Point
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_HOVER_REF" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Claude points the mouse at an element.">
    Point at <ph name="ELEMENT">$1<ex>ref_12</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_HOVER_AT" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Claude points the mouse at a point.">
    Point at <ph name="POINT">$1<ex>120, 340</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_FILL" meaning="Filling in a form field" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Claude fills in a form field.">
    Fill
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_FILL_REF" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Claude fills in a form field.">
    Fill <ph name="ELEMENT">$1<ex>ref_12</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_FILL_AT" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Claude fills in a form field at a point.">
    Fill at <ph name="POINT">$1<ex>120, 340</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_TYPE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Type “<ph name="TEXT">$1<ex>hello</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_KEY" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. The placeholder is keys, like Enter.">
    Press <ph name="KEYS">$1<ex>Enter</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_SCROLL" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. The placeholder is a direction in English (up, down, left, right).">
    Scroll <ph name="DIRECTION">$1<ex>down</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_NAVIGATE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Go to <ph name="URL">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_WAIT" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. The placeholder is a number of seconds.">
    Wait <ph name="SECONDS">$1<ex>2</ex></ph> s
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_REMEMBER" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Remember “<ph name="TEXT">$1<ex>Prefers metric units</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_UPDATE_MEMORY" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Update memory “<ph name="TEXT">$1<ex>Prefers metric units</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_FORGET" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Forget a memory
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_LIST_BOOSTS_FOR" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    List Boosts for <ph name="HOST">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_LIST_BOOSTS" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    List Boosts
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_SAVE_BOOST" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Save Boost for <ph name="SITES">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_DELETE_BOOST" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Delete a Boost
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_LIST_PLUGINS" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    List plugins
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_GET_PLUGIN" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Read plugin <ph name="PLUGIN">$1<ex>rss</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_TEST_FOLDER_PLUGIN" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Test a live folder plugin
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_TEST_PREVIEW_PLUGIN" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Test a tab preview
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_SAVE_PLUGIN" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Save a plugin
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_DELETE_PLUGIN" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Delete plugin <ph name="PLUGIN">$1<ex>rss</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_SAVE_FILE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Save “<ph name="FILE">$1<ex>notes.md</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_LIST_PATH" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    List “<ph name="PATH">$1<ex>docs</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_LIST_FOLDER" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    List the folder
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_READ_FILE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Read “<ph name="FILE">$1<ex>notes.md</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_WRITE_FILE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Write “<ph name="FILE">$1<ex>notes.md</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_EDIT_FILE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Edit “<ph name="FILE">$1<ex>notes.md</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_NETWORK_REQUESTS" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    List network requests
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_NETWORK_RESPONSE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Read request <ph name="REQUEST">$1<ex>42</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_INSPECT" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Inspect <ph name="ELEMENT">$1<ex>ref_12</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_PAGE_STORAGE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Read the site's storage
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_CLEAR_STORAGE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. The placeholder is a storage name like localStorage.">
    Clear <ph name="STORE">$1<ex>localStorage</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_SET_STORAGE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Sets an item in a site's storage (like localStorage).">
    Set “<ph name="NAME">$1<ex>theme</ex></ph>” in <ph name="STORE">$2<ex>localStorage</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_REMOVE_STORAGE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Removes an item from a site's storage (like localStorage).">
    Remove “<ph name="NAME">$1<ex>theme</ex></ph>” in <ph name="STORE">$2<ex>localStorage</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_PERFORMANCE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Measure performance
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_STOP_EMULATING" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Ends emulating a device.">
    Stop emulating
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_EMULATE" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Emulates a device; the placeholder is its name and may be empty.">
    Emulate <ph name="DEVICE">$1<ex>iPhone 15</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_RUN" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. Runs a shell command.">
    Run <ph name="COMMAND">$1<ex>ls</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_SEARCH_FILES" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Search files for “<ph name="PATTERN">$1<ex>TODO</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_FETCH" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Fetch <ph name="URL">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_SEARCH_WEB" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply.">
    Search the web for “<ph name="QUERY">$1<ex>weather</ex></ph>”
  </message>
  <message name="IDS_COMPASS_CLAUDE_CHAT_TOOL_GENERIC" desc="Label of a step Claude (an AI assistant) took in the browser chat, shown in its reply. A step whose tool has no name.">
    Tool
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLOR_GREY" desc="Name of a color a space can have, shown as the tooltip of its swatch in the theme editor.">
    Grey
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLOR_BLUE" desc="Name of a color a space can have, shown as the tooltip of its swatch in the theme editor.">
    Blue
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLOR_PURPLE" desc="Name of a color a space can have, shown as the tooltip of its swatch in the theme editor.">
    Purple
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLOR_PINK" desc="Name of a color a space can have, shown as the tooltip of its swatch in the theme editor.">
    Pink
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLOR_RED" desc="Name of a color a space can have, shown as the tooltip of its swatch in the theme editor.">
    Red
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLOR_ORANGE" desc="Name of a color a space can have, shown as the tooltip of its swatch in the theme editor.">
    Orange
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLOR_YELLOW" desc="Name of a color a space can have, shown as the tooltip of its swatch in the theme editor.">
    Yellow
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_COLOR_GREEN" desc="Name of a color a space can have, shown as the tooltip of its swatch in the theme editor.">
    Green
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_LAGOON" desc="Name of a preset gradient (a set of colors) a space can have, shown as the tooltip of its swatch in the theme editor.">
    Lagoon
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_DUSK" desc="Name of a preset gradient (a set of colors) a space can have, shown as the tooltip of its swatch in the theme editor.">
    Dusk
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_EMBER" desc="Name of a preset gradient (a set of colors) a space can have, shown as the tooltip of its swatch in the theme editor.">
    Ember
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_MEADOW" desc="Name of a preset gradient (a set of colors) a space can have, shown as the tooltip of its swatch in the theme editor.">
    Meadow
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_OCEAN" desc="Name of a preset gradient (a set of colors) a space can have, shown as the tooltip of its swatch in the theme editor.">
    Ocean
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_PEACH" desc="Name of a preset gradient (a set of colors) a space can have, shown as the tooltip of its swatch in the theme editor.">
    Peach
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_AURORA" desc="Name of a preset gradient (a set of colors) a space can have, shown as the tooltip of its swatch in the theme editor.">
    Aurora
  </message>
  <message name="IDS_COMPASS_THEME_EDITOR_GRADIENT_SAND" desc="Name of a preset gradient (a set of colors) a space can have, shown as the tooltip of its swatch in the theme editor.">
