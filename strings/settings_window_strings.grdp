  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_DELETE_CONFIRM" desc="Confirmation before deleting a space.">
    Deletes “<ph name="SPACE_NAME">$1<ex>Work</ex></ph>” with its pinned and Today tabs and its archive.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_DELETE_LAST_CONFIRM" desc="Confirmation before deleting a profile's last space. &quot;Profiles&quot; is the name of the settings pane.">
    Deletes “<ph name="SPACE_NAME">$1<ex>Work</ex></ph>” with its pinned and Today tabs and its archive. It's <ph name="PROFILE_NAME">$2<ex>Personal</ex></ph>'s last space: the profile leaves the switcher, and stays in Profiles.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_DELETE_SPACE_ELLIPSIS" desc="Button that asks to confirm deleting a space.">
    Delete space…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_DEVICE_ONLY" desc="A space that doesn't sync.">
    On this device only
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_EDIT_ELLIPSIS" desc="Button that shows a space's settings.">
    Edit…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_EDIT_THEME_ELLIPSIS" desc="Button that opens a space's theme editor.">
    Edit theme…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_EMOJI" desc="Icon choice that opens the emoji picker.">
    Emoji
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_EXPORT_ELLIPSIS" desc="Button that exports spaces to a bookmarks file.">
    Export…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_EXPORT_SPACES" desc="Row for exporting every space to a bookmarks file.">
