    New space
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_NEW_SPACE_IN" desc="Accessible name of the button adding a space to the named profile.">
    New space in <ph name="PROFILE_NAME">$1<ex>Personal</ex></ph>
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_NO_ICON" desc="Icon choice: the space shows its initial.">
    No icon
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_NO_SPACES" desc="A profile has no spaces in the space switcher; adding one brings the profile back into it.">
    No spaces in the switcher. A new space brings the profile in.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_PROFILE" desc="The profile a space is in.">
    Profile
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_PROFILE_DETAIL" desc="What moving a space to another profile does. Pinned and Today are the sidebar's two sections.">
    Its open tabs close; its pinned and Today tabs move with it.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_PROFILE_OF" desc="Accessible name of the menu choosing a space's profile.">
    Profile of <ph name="SPACE_NAME">$1<ex>Work</ex></ph>
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_SHARED" desc="A space the user shares with others.">
    Shared
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_SHARED_VIEW_ONLY" desc="A space someone shared with the user, who can't edit it.">
    Shared with you, view only
