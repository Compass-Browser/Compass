  <message name="IDS_COMPASS_SETTINGS_WINDOW_PRIVACY_SAFE_BROWSING_OFF" desc="Safe Browsing level choice: no protection." meaning="Safe Browsing level">
    Off
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PRIVACY_SAFE_BROWSING_OFF_DETAIL" desc="Safety check: Safe Browsing is off.">
