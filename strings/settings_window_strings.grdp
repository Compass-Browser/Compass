<?xml version="1.0" encoding="utf-8"?>
<!-- The settings window (resources/sidebar/settings_window/). -->
<grit-part>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT" desc="Name of the settings pane about Compass (version, updates, licenses).">
    About
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_AUTO_UPDATE_DETAIL" desc="Explains that updates are automatic, before any manual check.">
    Compass checks for updates by itself.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_CHANNEL_BETA" desc="Update channel: releases that get features before Stable.">
    Beta
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_CHANNEL_CANARY" desc="Update channel: daily, least tested releases. A name; usually not translated.">
    Canary
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_CHANNEL_STABLE" desc="Update channel: the regular, tested releases.">
    Stable
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_CHECKING" desc="Shown while Compass checks for a newer version.">
    Checking for updates…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_CHECK_FAILED" desc="Update row label when the check for updates failed.">
    Couldn't check for updates
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_CHECK_FAILED_DETAIL" desc="The check for updates failed and gave no reason.">
    Couldn't check for updates.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_CHECK_FOR_UPDATES" desc="Button that checks for a newer version of Compass.">
    Check for Updates
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_DEVELOPMENT_BUILD" desc="Shown instead of a version number for a Compass built by a developer.">
    Development build
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_DOWNLOADING" desc="Shown while Compass downloads a new version.">
    Downloading the update…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_DOWNLOADING_PROGRESS" desc="Shown while Compass downloads a new version, with how much is done, in percent.">
    Downloading the update… <ph name="PERCENT">$1<ex>42</ex></ph>%
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_LICENSES" desc="Row that opens the open-source licenses of the software Compass uses.">
    Open-source licenses
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_RELAUNCH_TO_UPDATE" desc="Button that restarts Compass to install a downloaded update.">
    Relaunch to Update
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UPDATES" desc="Title of the About pane's group about software updates, and the update row's label before any check.">
    Updates
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UPDATES_OFF" desc="Update row label when this copy of Compass can't update itself.">
    Updates are off
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UPDATES_OFF_DETAIL" desc="Explains that this copy of Compass (e.g. one built by a developer or a Linux package) has no updater.">
    This build doesn't update itself.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UPDATE_CHANNEL" desc="Label of the menu choosing which release channel (Stable, Beta, Canary) Compass updates from.">
    Update channel
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UPDATE_CHANNEL_DETAIL" desc="Explains the update channels. Beta and Canary are channel names.">
    Beta and Canary get new features first, with more bugs.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_SIDEBAR_NOTICE" desc="About pane switch: whether the sidebar shows a card when an update is ready to install.">
    Show updates in the sidebar
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_SIDEBAR_NOTICE_DETAIL" desc="Explains the switch that shows a card in the sidebar when an update is ready to install.">
    When an update is ready, offer to relaunch at the bottom of the sidebar.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UPDATE_READY" desc="Update row label when a new version was downloaded.">
    An update is ready
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UPDATE_READY_DETAIL" desc="A downloaded update waits to be installed.">
    The update is ready to install.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UP_TO_DATE" desc="Update row label after a check found no newer version.">
    Compass is up to date
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_UP_TO_DATE_DETAIL" desc="A check found no newer version.">
    Compass is up to date.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_VERSION" desc="Compass's version, under its name in the About pane.">
    Version <ph name="VERSION">$1<ex>20261125.1200</ex></ph>
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ABOUT_VERSION_READY" desc="A downloaded update waits to be installed.">
    Version <ph name="VERSION">$1<ex>20261125.1200</ex></ph> is ready to install.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED" desc="Name of the settings pane for advanced settings.">
    Advanced
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_ACCESSIBILITY" desc="Title of the Advanced pane's group of accessibility settings.">
    Accessibility
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_BLURB" desc="Description under the Advanced pane's title.">
    Performance, accessibility and tools for developers.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_CARET_BROWSING" desc="Setting for caret browsing.">
    Navigate pages with a text cursor
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_CARET_BROWSING_DETAIL" desc="Explains caret browsing and its key, F7.">
    Caret browsing; F7 turns it on or off.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_ENERGY_SAVER" desc="Setting that limits background activity to save battery.">
    Energy saver
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_ENERGY_SAVER_ALWAYS" desc="Energy saver choice: always on.">
    Always
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_ENERGY_SAVER_BATTERY_LOW" desc="Energy saver choice: on when the battery is low.">
    When the battery is low
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_ENERGY_SAVER_DETAIL" desc="Explains the energy saver setting.">
    Limits background activity and visual effects.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_ENERGY_SAVER_OFF" desc="Energy saver choice: never on.">
    Off
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_ENERGY_SAVER_UNPLUGGED" desc="Energy saver choice: on when the computer runs on battery.">
    When unplugged
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_FOCUS_HIGHLIGHT" desc="Setting that draws a ring around the focused item on pages.">
    Highlight the focused object
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_LIVE_CAPTION" desc="Setting that shows captions for audio and video automatically.">
    Live caption
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_LIVE_CAPTION_DETAIL" desc="Explains live caption, which only supports English speech.">
    Captions for audio and video in English.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_MEMORY_SAVER" desc="Setting that frees memory from inactive tabs.">
    Memory saver
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_MEMORY_SAVER_DETAIL" desc="Explains the memory saver setting.">
    Frees memory from tabs you haven't used in a while.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_PERFORMANCE" desc="Title of the Advanced pane's group of performance settings.">
    Performance
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_RESET" desc="Title of the Advanced pane's reset group, and the button confirming the reset of settings.">
    Reset
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_RESETTING" desc="Shown while the settings are being reset.">
    Resetting…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_RESET_CONFIRM" desc="Confirmation of what resetting the settings does, next to Cancel and Reset buttons.">
    Resets the search engine, site permissions and other browser settings, clears cookies and turns off extensions. Your spaces, tabs, history and passwords stay.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_RESET_DONE" desc="Shown after the settings were reset.">
    Settings were reset.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_RESET_ELLIPSIS" desc="Button that asks to confirm resetting the settings.">
    Reset…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_RESET_SETTINGS" desc="Row that resets the browser's settings to their defaults.">
    Reset settings
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_ADVANCED_RESET_SETTINGS_DETAIL" desc="What resetting the settings resets.">
    Search engine, permissions, startup and more.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_AI" desc="Name of the settings pane for Claude, the AI assistant.">
    AI
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_AI_BLURB" desc="Description under the AI pane's title.">
    AI in your browser: who answers, and what it may do for you.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_BOOSTS" desc="Name of the settings pane for Boosts (a Compass feature: the user's own CSS and JavaScript for sites). Feature name; usually kept.">
    Boosts
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_BOOSTS_BLURB" desc="Description under the Boosts pane's title.">
    Your own CSS and JavaScript, added to the sites you pick.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_DEVELOPERS" desc="Title of the Advanced pane's group of developer rows.">
    Developers
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_DEVELOPMENT_MODE" desc="Row opening the Development mode page (a Compass feature for web developers), and its title.">
    Development mode
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_FILTER" desc="Placeholder of a field that filters a list (saved passwords, languages, search engines).">
    Filter
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_APPEARANCE" desc="Title of the General pane's group of appearance settings.">
    Appearance
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_BLURB" desc="Description under the General pane's title.">
    How Compass opens, searches, downloads and shows pages.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_BROWSER" desc="Title of the General pane's group about the browser itself (default browser, search engine).">
    Browser
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_CHANGE_ELLIPSIS" desc="Button that opens a dialog to choose another download folder.">
    Change…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_DEFAULT_BROWSER" desc="Row about whether Compass is the system's default web browser.">
    Default browser
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_DEFAULT_BROWSER_IS_DEFAULT" desc="Compass is the default web browser.">
    Compass is your default browser.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_DEFAULT_BROWSER_MANAGED" desc="The default browser is set by an administrator's policy.">
    Your organization manages the default browser.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_DEFAULT_BROWSER_NOT_DEFAULT" desc="Another browser is the default.">
    Compass isn't your default browser.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_DEFAULT_BROWSER_UNKNOWN" desc="The system doesn't let Compass read or set the default browser.">
    Compass can't tell or change the default browser here.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_DOWNLOADS" desc="Title of the General pane's group of download settings.">
    Downloads
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_DOWNLOAD_LOCATION" desc="Row showing the folder downloads are saved in.">
    Location
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_FIXED_WIDTH_FONT" desc="Setting for the font pages use for monospaced text (code).">
    Fixed-width font
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_FONTS" desc="Row and subpage title for the fonts pages are shown in.">
    Fonts
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_FONT_SIZE" desc="Setting for the default text size of pages.">
    Font size
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_FONT_SIZE_LARGE" desc="Font size choice.">
    Large
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_FONT_SIZE_MEDIUM" desc="Font size choice.">
    Medium
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_FONT_SIZE_SMALL" desc="Font size choice.">
    Small
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_FONT_SIZE_VERY_LARGE" desc="Font size choice.">
    Very large
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_FONT_SIZE_VERY_SMALL" desc="Font size choice.">
    Very small
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_HARDWARE_ACCELERATION" desc="Setting for hardware (GPU) acceleration.">
    Use graphics acceleration when available
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_LANGUAGES" desc="Title of the General pane's group of language settings.">
    Languages
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_MAKE_DEFAULT" desc="Button that makes Compass the default web browser.">
    Make Default
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_MANAGE_SEARCH_ENGINES" desc="Row that opens the list of search engines and site search shortcuts.">
    Manage search engines and site search
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_MINIMUM_FONT_SIZE" desc="Setting for the smallest text size pages may use.">
    Minimum font size
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_MINIMUM_FONT_SIZE_NONE" desc="Minimum font size choice: no minimum.">
    None
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_OFFER_TRANSLATE" desc="Setting: offer to translate pages in other languages.">
    Offer to translate pages
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_OFFER_TRANSLATE_DETAIL" desc="Explains which pages get the offer to translate.">
    In languages that aren't among your preferred ones.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_OPENS_SYSTEM_SETTINGS" desc="Tooltip on the proxy row's arrow icon.">
    Opens your computer's settings
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PAGE_ZOOM" desc="Setting for the default zoom level of pages.">
    Page zoom
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PAGE_ZOOM_DETAIL" desc="Explains that the default zoom doesn't change sites the user zoomed.">
    For sites you haven't zoomed yourself.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PIP" desc="Title of the General pane's group about picture-in-picture video.">
    Picture-in-picture
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PIP_ON_LEAVING_WINDOW" desc="Setting: picture-in-picture starts also when the user leaves the browser window (it always does on tab switches).">
    Also when you leave the window
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PIP_ON_LEAVING_WINDOW_DETAIL" desc="Explains the picture-in-picture setting.">
    A playing video or a call goes into picture-in-picture when its window is covered or minimized, or you switch to another app.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PREFERRED_LANGUAGES" desc="Row that opens the list of languages the user reads, in order.">
    Preferred languages
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PROMPT_FOR_DOWNLOAD" desc="Setting: ask for a location before each download.">
    Ask where to save each file
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PROXY" desc="Row that opens the system's proxy settings.">
    Proxy settings
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_PROXY_DETAIL" desc="Explains that proxies are set in the operating system.">
    In your computer's network settings.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_RELAUNCH" desc="Button that restarts Compass.">
    Relaunch
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_RELAUNCH_NEEDED" desc="The changed setting needs a restart.">
    Takes effect when Compass restarts.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_SANS_SERIF_FONT" desc="Setting for the font pages use for sans-serif text.">
    Sans-serif font
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_SEARCH_ENGINE" desc="Setting for the default search engine.">
    Search engine
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_SEARCH_ENGINE_DETAIL" desc="Explains the search engine setting. The command bar is where the user types addresses and searches.">
    What the command bar searches with.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_SERIF_FONT" desc="Setting for the font pages use for serif text.">
    Serif font
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_SPELLCHECK" desc="Setting for the spell checker.">
    Check spelling as you type
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_STANDARD_FONT" desc="Setting for the font pages use by default.">
    Standard font
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_SYSTEM" desc="Title of the General pane's group of system settings.">
    System
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_GENERAL_TITLE" desc="Name of the General pane, on the button that goes back to it from a subpage.">
    General
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_IMPORT" desc="Row opening the import page, and its title.">
    Import from another browser
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LANGUAGES_ADD" desc="Accessible name of the button adding a language to the preferred list.">
    Add <ph name="LANGUAGE">$1<ex>Italian</ex></ph>
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LANGUAGES_ADD_LANGUAGE" desc="Title of the list of languages to add.">
    Add a language
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LANGUAGES_FILTER" desc="Accessible name of the field filtering the languages to add.">
    Filter languages
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LANGUAGES_MOVE_DOWN" desc="Accessible name of the button moving a language down in the preferred list.">
    Move <ph name="LANGUAGE">$1<ex>Italian</ex></ph> down
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LANGUAGES_MOVE_UP" desc="Accessible name of the button moving a language up in the preferred list.">
    Move <ph name="LANGUAGE">$1<ex>Italian</ex></ph> up
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LANGUAGES_OFFER_TO_TRANSLATE" desc="Accessible name of the switch offering to translate pages in the named language.">
    Offer to translate <ph name="LANGUAGE">$1<ex>Italian</ex></ph>
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LANGUAGES_REMOVE" desc="Accessible name of the button removing a preferred language.">
    Remove <ph name="LANGUAGE">$1<ex>Italian</ex></ph>
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LANGUAGES_TRANSLATE" desc="Label of the switch offering to translate pages in a language.">
    Translate
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LINKS" desc="Name of the settings pane choosing which app or window opens links.">
    Links
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_LINKS_BLURB" desc="Description under the Links pane's title.">
    Which app or window opens links to the sites you choose.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_NO_RESULTS" desc="Shown when searching the settings finds nothing.">
    No settings match “<ph name="QUERY">$1<ex>cookies</ex></ph>”.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_OPENS_IN_TAB" desc="Tooltip on a row's arrow icon: clicking the row opens a page in a browser tab.">
    Opens in a tab
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PAGE_TITLE" desc="Title of the settings window, and the accessible name of its toolbar of panes.">
    Settings
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS" desc="Name of the settings pane for passwords, cards and addresses; also a row and group title there.">
    Passwords
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_ADDRESSES" desc="Group, row and page title for saved addresses.">
    Addresses
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_ADD_ADDRESS" desc="Title of the form for a new address.">
    Add an address
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_ADD_ADDRESS_ELLIPSIS" desc="Button that opens the form for a new address.">
    Add Address…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_ADD_CARD" desc="Title of the form for a new card.">
    Add a card
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_ADD_CARD_ELLIPSIS" desc="Button that opens the form for a new card.">
    Add Card…
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_AUTO_SIGN_IN" desc="Setting for signing in to sites with saved passwords automatically.">
    Sign in automatically
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_AUTO_SIGN_IN_DETAIL" desc="Explains automatic sign-in.">
    On sites where you saved one password.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_BLURB" desc="Description under the Passwords pane's title.">
    Passwords, cards and addresses that Compass fills in for you.
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_CARDS" desc="Row and page title for saved payment cards.">
    Cards
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_CARD_EXPIRES" desc="A saved card's expiration date (month/year).">
    Expires <ph name="DATE">$1<ex>04/2029</ex></ph>
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_CARD_NUMBER" desc="Card form field.">
    Card number
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_CITY" desc="Address form field.">
    City
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_COPIED" meaning="A password was copied" desc="Shown on the copy button after a password was copied.">
    Copied
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_COUNTRY" desc="Address form field.">
    Country
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_EDIT_ADDRESS" desc="Title of the form editing an address.">
    Edit address
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_EDIT_CARD" desc="Title of the form editing a card, with its last four digits.">
    Edit card •••• <ph name="LAST_FOUR">$1<ex>4242</ex></ph>
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_EMAIL" desc="Address form field.">
    Email
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_EXPIRES" desc="Card form field: expiration month and year.">
    Expires
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_EXPIRY_MONTH" desc="Accessible name of the card's expiration month menu.">
    Expiry month
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_PASSWORDS_EXPIRY_YEAR" desc="Accessible name of the card's expiration year menu.">
