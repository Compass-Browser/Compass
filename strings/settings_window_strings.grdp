  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SYNC" desc="Row opening the Sync page, and its title.">
    Sync
  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SYNC_AND_IMPORT" desc="Title of the Profiles pane's group of rows opening the Sync and Import pages.">
    Sync and import
