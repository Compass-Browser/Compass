  </message>
  <message name="IDS_COMPASS_SETTINGS_WINDOW_SPACES_MOVE_SPACE_UP" desc="Accessible name of the button moving a space up.">
    Move <ph name="SPACE_NAME">$1<ex>Work</ex></ph> up
  </message>
