<?xml version="1.0" encoding="UTF-8"?>

<!-- Compass's own user-facing strings: its desktop views, menus, bubbles and
notifications, and its WebUI pages (the sidebar, settings, the command bar,
Easels). Messages are in the parts below, one per area. Translations are in
translations/, made with update_translations.py.

Upstream's strings aren't here: Compass renames the product in theirs with
rebrand_strings.py (docs/design/branding.md). -->

<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en">
  <outputs>
    <output filename="grit/compass_strings.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="compass_strings_af.pak" type="data_package" lang="af" />
    <output filename="compass_strings_am.pak" type="data_package" lang="am" />
    <output filename="compass_strings_ar.pak" type="data_package" lang="ar" />
    <output filename="compass_strings_as.pak" type="data_package" lang="as" />
    <output filename="compass_strings_az.pak" type="data_package" lang="az" />
    <output filename="compass_strings_be.pak" type="data_package" lang="be" />
    <output filename="compass_strings_bg.pak" type="data_package" lang="bg" />
    <output filename="compass_strings_bn.pak" type="data_package" lang="bn" />
    <output filename="compass_strings_bs.pak" type="data_package" lang="bs" />
    <output filename="compass_strings_ca.pak" type="data_package" lang="ca" />
    <output filename="compass_strings_cs.pak" type="data_package" lang="cs" />
    <output filename="compass_strings_cy.pak" type="data_package" lang="cy" />
    <output filename="compass_strings_da.pak" type="data_package" lang="da" />
    <output filename="compass_strings_de.pak" type="data_package" lang="de" />
    <output filename="compass_strings_el.pak" type="data_package" lang="el" />
    <output filename="compass_strings_en-GB.pak" type="data_package" lang="en-GB" />
    <output filename="compass_strings_en-US.pak" type="data_package" lang="en" />
    <output filename="compass_strings_es.pak" type="data_package" lang="es" />
    <if expr="is_ios">
      <!-- iOS uses es-MX for es-419 -->
      <output filename="compass_strings_es-MX.pak" type="data_package" lang="es-419" />
    </if>
    <if expr="not is_ios">
      <output filename="compass_strings_es-419.pak" type="data_package" lang="es-419" />
    </if>
    <output filename="compass_strings_et.pak" type="data_package" lang="et" />
    <output filename="compass_strings_eu.pak" type="data_package" lang="eu" />
    <output filename="compass_strings_fa.pak" type="data_package" lang="fa" />
    <output filename="compass_strings_fi.pak" type="data_package" lang="fi" />
    <output filename="compass_strings_fil.pak" type="data_package" lang="fil" />
    <output filename="compass_strings_fr-CA.pak" type="data_package" lang="fr-CA" />
    <output filename="compass_strings_fr.pak" type="data_package" lang="fr" />
    <output filename="compass_strings_gl.pak" type="data_package" lang="gl" />
    <output filename="compass_strings_gu.pak" type="data_package" lang="gu" />
    <output filename="compass_strings_he.pak" type="data_package" lang="he" />
    <output filename="compass_strings_hi.pak" type="data_package" lang="hi" />
    <output filename="compass_strings_hr.pak" type="data_package" lang="hr" />
    <output filename="compass_strings_hu.pak" type="data_package" lang="hu" />
    <output filename="compass_strings_hy.pak" type="data_package" lang="hy" />
    <output filename="compass_strings_id.pak" type="data_package" lang="id" />
    <output filename="compass_strings_is.pak" type="data_package" lang="is" />
    <output filename="compass_strings_it.pak" type="data_package" lang="it" />
    <output filename="compass_strings_ja.pak" type="data_package" lang="ja" />
    <output filename="compass_strings_ka.pak" type="data_package" lang="ka" />
    <output filename="compass_strings_kk.pak" type="data_package" lang="kk" />
    <output filename="compass_strings_km.pak" type="data_package" lang="km" />
    <output filename="compass_strings_kn.pak" type="data_package" lang="kn" />
    <output filename="compass_strings_ko.pak" type="data_package" lang="ko" />
    <output filename="compass_strings_ky.pak" type="data_package" lang="ky" />
    <output filename="compass_strings_lo.pak" type="data_package" lang="lo" />
    <output filename="compass_strings_lt.pak" type="data_package" lang="lt" />
    <output filename="compass_strings_lv.pak" type="data_package" lang="lv" />
    <output filename="compass_strings_mk.pak" type="data_package" lang="mk" />
    <output filename="compass_strings_ml.pak" type="data_package" lang="ml" />
    <output filename="compass_strings_mn.pak" type="data_package" lang="mn" />
    <output filename="compass_strings_mr.pak" type="data_package" lang="mr" />
    <output filename="compass_strings_ms.pak" type="data_package" lang="ms" />
    <output filename="compass_strings_my.pak" type="data_package" lang="my" />
    <output filename="compass_strings_ne.pak" type="data_package" lang="ne" />
    <output filename="compass_strings_nl.pak" type="data_package" lang="nl" />
    <!-- The translation console uses 'no' for Norwegian Bokmål. It should
         be 'nb'. -->
    <output filename="compass_strings_nb.pak" type="data_package" lang="no" />
    <output filename="compass_strings_pa.pak" type="data_package" lang="pa" />
    <output filename="compass_strings_pl.pak" type="data_package" lang="pl" />
    <if expr="is_ios">
      <!-- iOS uses pt for pt-BR -->
      <output filename="compass_strings_pt.pak" type="data_package" lang="pt-BR" />
    </if>
    <if expr="not is_ios">
      <output filename="compass_strings_pt-BR.pak" type="data_package" lang="pt-BR" />
    </if>
    <output filename="compass_strings_pt-PT.pak" type="data_package" lang="pt-PT" />
    <output filename="compass_strings_or.pak" type="data_package" lang="or" />
    <output filename="compass_strings_ro.pak" type="data_package" lang="ro" />
    <output filename="compass_strings_ru.pak" type="data_package" lang="ru" />
    <output filename="compass_strings_si.pak" type="data_package" lang="si" />
    <output filename="compass_strings_sk.pak" type="data_package" lang="sk" />
    <output filename="compass_strings_sl.pak" type="data_package" lang="sl" />
    <output filename="compass_strings_sq.pak" type="data_package" lang="sq" />
    <output filename="compass_strings_sr-Latn.pak" type="data_package" lang="sr-Latn" />
    <output filename="compass_strings_sr.pak" type="data_package" lang="sr" />
    <output filename="compass_strings_sv.pak" type="data_package" lang="sv" />
    <output filename="compass_strings_sw.pak" type="data_package" lang="sw" />
    <output filename="compass_strings_ta.pak" type="data_package" lang="ta" />
    <output filename="compass_strings_te.pak" type="data_package" lang="te" />
    <output filename="compass_strings_th.pak" type="data_package" lang="th" />
    <output filename="compass_strings_tr.pak" type="data_package" lang="tr" />
    <output filename="compass_strings_uk.pak" type="data_package" lang="uk" />
    <output filename="compass_strings_ur.pak" type="data_package" lang="ur" />
    <output filename="compass_strings_uz.pak" type="data_package" lang="uz" />
    <output filename="compass_strings_vi.pak" type="data_package" lang="vi" />
    <output filename="compass_strings_zh-CN.pak" type="data_package" lang="zh-CN" />
    <output filename="compass_strings_zh-HK.pak" type="data_package" lang="zh-HK" />
    <output filename="compass_strings_zh-TW.pak" type="data_package" lang="zh-TW" />
    <output filename="compass_strings_zu.pak" type="data_package" lang="zu" />
    <!-- Pseudolocales -->
    <output filename="compass_strings_ar-XB.pak" type="data_package" lang="ar-XB" />
    <output filename="compass_strings_en-XA.pak" type="data_package" lang="en-XA" />
  </outputs>
  <translations>
    <file path="translations/compass_strings_it.xtb" lang="it" />
  </translations>
  <release seq="1">
    <messages fallback_to_english="true">
      <part file="common_strings.grdp" />
      <part file="browser_strings.grdp" />
      <part file="browser_ui_strings.grdp" />
      <part file="settings_sections_strings.grdp" />
      <part file="settings_window_strings.grdp" />
      <part file="sidebar_strings.grdp" />
      <part file="easel_strings.grdp" />
    </messages>
  </release>
</grit>
