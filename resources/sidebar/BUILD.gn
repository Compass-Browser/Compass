# chrome://compass-settings/licenses.html: the licenses of the third-party
# files Compass adds to Chromium (//compass/third_party), which the About
# page links to.
action("licenses_page") {
  script = "//compass/build/licenses_page.py"
  inputs = [
    "//compass/third_party/strip_on_share/MPL2/LICENSE",
    "//compass/third_party/strip_on_share/LGPL/LICENSE",
    "//compass/third_party/unicode_emoji/LICENSE",
  ]
  outputs = [ "$target_gen_dir/licenses/licenses.html" ]
  _source = "https://github.com/mozilla-firefox/firefox/tree/main/toolkit/components/antitracking/StripOnShareLists"
  args = [
    "--out",
    rebase_path(outputs[0], root_build_dir),
    "Firefox's strip-on-share list|The tracking parameters Remove tracking from copied links leaves out.|$_source|Mozilla Public License 2.0|" + rebase_path(
            inputs[0],
            root_build_dir),
    "Firefox's strip-on-share list, from ClearURLs|More tracking parameters for Remove tracking from copied links.|$_source|GNU Lesser General Public License 3.0|" + rebase_path(
            inputs[1],
            root_build_dir),
    "Unicode emoji and CLDR annotations|The emoji, names and keywords of the space emoji picker.|https://unicode.org/emoji/|Unicode License V3|" + rebase_path(
            inputs[2],
            root_build_dir),
  ]
}

generate_grd("build_licenses_grdp") {
  grd_prefix = "compass_licenses"
  out_grd = "$target_gen_dir/licenses.grdp"
  deps = [ ":licenses_page" ]
  input_files_base_dir = rebase_path("$target_gen_dir/licenses", root_build_dir)
  input_files = [ "licenses.html" ]
}

# Live folders' plugin scripts, as the plugins/ tree has them
# (docs/design/live-folders.md), served under /plugins/.
generate_grd("build_live_plugins_grdp") {
  grd_prefix = "compass_live_plugins"
  out_grd = "$target_gen_dir/live_plugins.grdp"
  input_files_base_dir = rebase_path("//compass/plugins", "//")
  resource_path_prefix = "plugins"
  input_files = [
    "builtin/calendar/icon.svg",
    "builtin/calendar/main.js",
    "builtin/calendar/manifest.json",
    "builtin/github/icon.svg",
    "builtin/github/main.js",
    "builtin/github/manifest.json",
    "builtin/gmail/icon.svg",
    "builtin/gmail/main.js",
    "builtin/gmail/manifest.json",
    "builtin/rss/icon.svg",
    "builtin/rss/main.js",
    "builtin/rss/manifest.json",
    "builtin/web-list/icon.svg",
    "builtin/web-list/main.js",
    "builtin/web-list/manifest.json",
    "runtime/prelude.js",
    "runtime/result.js",
    "runtime/select.js",
    "sdk/html.js",
    "sdk/ics.js",
    "sdk/text.js",
    "sdk/xml.js",
  ]
}

generate_grd("build_live_worker_grdp") {
  grd_prefix = "compass_live_worker"
  out_grd = "$target_gen_dir/live_worker.grdp"
  input_files_base_dir = rebase_path(".", "//")
  input_files = [ "live_folders/worker.js" ]
}

# The sync server for Cloudflare, as `npm run bundle` builds it in
# server/cloudflare: Compass uploads it when the user sets up a free server
# (docs/design/sync.md, "A free server on Cloudflare"). CompassSyncService
# reads it from the resource bundle by its path; pages that serve all of
# this pak's files serve it too, which is harmless (it's open source).
generate_grd("build_sync_worker_grdp") {
  grd_prefix = "compass_sync_worker"
  out_grd = "$target_gen_dir/sync_worker.grdp"
  input_files_base_dir = rebase_path("//compass/server/cloudflare/dist", "//")
  resource_path_prefix = "sync_worker"
  input_files = [
    "compass-sync.js",
    "compass-sync.version",
  ]
}
