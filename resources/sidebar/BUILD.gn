import("//ui/webui/resources/tools/build_webui.gni")

# chrome://strata-sidebar, and the other Strata pages (the placeholder, the
# command bar). Produces :resources, whose pak is added to Chrome's resources
# (see patches/chrome-chrome_paks.gni.patch).
build_webui("build") {
  grd_prefix = "strata_sidebar"
  grit_output_dir = "$root_gen_dir/strata"

  static_files = [
    "command_bar.html",
    "placeholder.html",
    "strata_sidebar.html",
  ]
  ts_files = [
    "app.html.ts",
    "app.ts",
    "browser_proxy.ts",
    "command_bar/app.html.ts",
    "command_bar/app.ts",
    "command_bar/browser_proxy.ts",
    "node.html.ts",
    "node.ts",
    "placeholder.ts",
  ]
  css_files = [
    "app.css",
    "command_bar/app.css",
  ]

  webui_context_type = "trusted"

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps = [
    "//strata/browser/ui/webui/command_bar:mojo_bindings_ts__generator",
    "//strata/browser/ui/webui/sidebar:mojo_bindings_ts__generator",
  ]
  mojo_files = [
    "$root_gen_dir/strata/browser/ui/webui/command_bar/command_bar.mojom-webui.ts",
    "$root_gen_dir/strata/browser/ui/webui/sidebar/sidebar.mojom-webui.ts",
  ]
}
