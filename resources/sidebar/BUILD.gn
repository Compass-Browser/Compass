import("//ui/webui/resources/tools/build_webui.gni")

# chrome://compass-sidebar, and the other Compass pages (the placeholder, the
# command bar). Produces :resources, whose pak is added to Chrome's resources
# (see patches/chrome-chrome_paks.gni.patch).
build_webui("build") {
  grd_prefix = "compass_sidebar"
  grit_output_dir = "$root_gen_dir/compass"

  static_files = [
    "arc_import.html",
    "command_bar.html",
    "compass_sync.html",
    "placeholder.html",
    "compass_sidebar.html",
  ]
  ts_files = [
    "app.html.ts",
    "app.ts",
    "arc_import.ts",
    "browser_proxy.ts",
    "command_bar/app.html.ts",
    "command_bar/app.ts",
    "command_bar/browser_proxy.ts",
    "compass_sync.ts",
    "favicon.ts",
    "node.html.ts",
    "node.ts",
    "placeholder.ts",
    "preview.html.ts",
    "preview.ts",
  ]
  css_files = [
    "app.css",
    "command_bar/app.css",
    "preview.css",
  ]

  webui_context_type = "trusted"

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_components/color_change_listener:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps = [
    "//compass/browser/ui/webui/command_bar:mojo_bindings_ts__generator",
    "//compass/browser/ui/webui/sidebar:mojo_bindings_ts__generator",
    "//compass/browser/ui/webui/sync:mojo_bindings_ts__generator",
  ]
  mojo_files = [
    "$root_gen_dir/compass/browser/ui/webui/command_bar/command_bar.mojom-webui.ts",
    "$root_gen_dir/compass/browser/ui/webui/sidebar/sidebar.mojom-webui.ts",
    "$root_gen_dir/compass/browser/ui/webui/sync/compass_sync.mojom-webui.ts",
  ]
}
