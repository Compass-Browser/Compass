import("//ui/webui/resources/tools/build_webui.gni")

# chrome://strata-sidebar. Produces :resources, whose pak is added to Chrome's
# resources (see patches/chrome-chrome_paks.gni.patch).
build_webui("build") {
  grd_prefix = "strata_sidebar"
  grit_output_dir = "$root_gen_dir/strata"

  static_files = [ "strata_sidebar.html" ]
  ts_files = [
    "app.html.ts",
    "app.ts",
    "browser_proxy.ts",
    "node.html.ts",
    "node.ts",
  ]
  css_files = [ "app.css" ]

  webui_context_type = "trusted"

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps =
      [ "//strata/browser/ui/webui/sidebar:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/strata/browser/ui/webui/sidebar/sidebar.mojom-webui.ts" ]
}
