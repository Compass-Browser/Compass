import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

# chrome://easel (docs/design/easels.md, "Editor"): the Easels list and a
# board's editor. Its own pak, unlike the sidebar's pages, because Android
# ships it too (see patches/chrome-chrome_paks.gni.patch). Plain TypeScript
# on the DOM, no Lit: the board updates only what a gesture moves.
build_webui("build") {
  grd_prefix = "compass_easel"
  grit_output_dir = "$root_gen_dir/compass"

  static_files = [
    "easel.html",
    "easel_icon.svg",
  ]
  ts_files = [
    "app.ts",
    "board_view.ts",
    "browser_proxy.ts",
    "dom.ts",
    "editor.ts",
    "geometry.ts",
    "history.ts",
    "icons.ts",
    "list.ts",
    "model.ts",
  ]

  webui_context_type = "trusted"

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps =
      [ "//compass/browser/ui/webui/easel:mojo_bindings_ts__generator" ]
  mojo_files =
      [ "$root_gen_dir/compass/browser/ui/webui/easel/easel.mojom-webui.ts" ]

  if (is_android) {
    # The sync server for Cloudflare, which the desktop has in the sidebar's
    # pak (resources/sidebar/BUILD.gn, build_sync_worker_grdp). Android ships
    # only this Compass pak, so it comes here: CompassSyncService reads it
    # by its path when the user sets up or updates a free server
    # (docs/design/android.md, "Sync and push").
    extra_grdp_deps = [ ":build_sync_worker_grdp" ]
    extra_grdp_files = [ "$target_gen_dir/sync_worker.grdp" ]
  }
}

if (is_android) {
  generate_grd("build_sync_worker_grdp") {
    grd_prefix = "compass_sync_worker"
    out_grd = "$target_gen_dir/sync_worker.grdp"
    input_files_base_dir = rebase_path("//compass/server/cloudflare/dist", "//")
    resource_path_prefix = "sync_worker"
    input_files = [
      "compass-sync.js",
      "compass-sync.version",
    ]
  }
}
