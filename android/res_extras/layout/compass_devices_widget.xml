<!-- The Other Devices widget (DevicesWidgetProvider), as the iOS app's: tabs
     open on the sync chain's other devices; a tap opens one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compass_devices_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/compass_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/compass_devices_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:text="Other Devices"
        android:textColor="#FF1F2937"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/compass_devices_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="4dp"
        android:text="No tabs on other devices"
        android:textColor="#FF5F6368"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/compass_devices_row0"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/compass_widget_row"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FF1F2937"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/compass_devices_row1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/compass_widget_row"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FF1F2937"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/compass_devices_row2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/compass_widget_row"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FF1F2937"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/compass_devices_row3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/compass_widget_row"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FF1F2937"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
