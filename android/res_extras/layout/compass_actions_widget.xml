<!-- The Quick Actions widget (QuickActionsWidgetProvider), as the iOS app's:
     search, an Incognito tab, Claude and the sidebar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/compass_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/compass_actions_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/compass_widget_button"
            android:contentDescription="Search"
            android:padding="12dp"
            android:src="@drawable/compass_sym_search"
            android:tint="#FF1F2937" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Search"
            android:textColor="#FF44474E"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/compass_actions_incognito"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/compass_widget_button"
            android:contentDescription="Incognito"
            android:padding="12dp"
            android:src="@drawable/compass_sym_eyeglasses"
            android:tint="#FF1F2937" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Incognito"
            android:textColor="#FF44474E"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/compass_actions_claude"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/compass_widget_button"
            android:contentDescription="Claude"
            android:padding="12dp"
            android:src="@drawable/compass_sym_auto_awesome"
            android:tint="#FF1F2937" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Claude"
            android:textColor="#FF44474E"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/compass_actions_sidebar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/compass_widget_button"
            android:contentDescription="Sidebar"
            android:padding="12dp"
            android:src="@drawable/compass_sym_view_sidebar"
            android:tint="#FF1F2937" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Sidebar"
            android:textColor="#FF44474E"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
