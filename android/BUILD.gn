# The extras' resources (the search widget).
android_resources("extras_resources") {
  sources = [
    "res_extras/drawable/compass_widget_background.xml",
    "res_extras/layout/compass_search_widget.xml",
    "res_extras/xml/compass_autofill_service.xml",
    "res_extras/xml/compass_search_widget.xml",
  ]
  deps = [ ":icon_resources" ]
}

chrome_public_apk_or_module_tmpl("compass_apk") {
  target_type = "android_apk"
  apk_name = "Compass"
  manifest_package = "it.cipi1965.compass"
  jinja_input = "//compass/android/AndroidManifest.xml"
  deps = [
    ":extras_resources",
    ":icon_resources",
    ":java",
  ]
}

# The shell's unit tests, on the host's JVM (Robolectric): the sidebar's and
# the Claude sheet's state, drops (P5) and On Launch (P3). Run with
# out/<dir>/bin/run_compass_junit_tests.
robolectric_binary("compass_junit_tests") {
  sources = [
    "junit/src/it/cipi1965/compass/shell/ClaudeChatStateTest.java",
    "junit/src/it/cipi1965/compass/shell/OnLaunchTest.java",
    "junit/src/it/cipi1965/compass/shell/SidebarStateTest.java",
  ]
  deps = [
    ":java",
    "//base:base_java",
    "//base:base_java_test_support",
    "//base:base_junit_test_support",
    "//third_party/junit",
  ]
}
