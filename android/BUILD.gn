# Compass for Android (docs/design/android.md): Chrome's browser with
# Compass's own shell, in Kotlin and Jetpack Compose.

import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")
import("//chrome/android/chrome_public_apk_tmpl.gni")

# What ChromeTabbedActivity calls once its UI is up. chrome_java depends on it
# (patches/chrome-android-BUILD.gn.patch); the implementation is in :java and
# only the Compass app has it, so chrome_public_apk runs without a shell.
android_library("hook_java") {
  sources = [
    "java/src/it/cipi1965/compass/CompassShell.java",
    "java/src/it/cipi1965/compass/CompassShellHook.java",
  ]
  deps = [
    "//base:base_java",
    "//chrome/browser/browser_controls/android:java",
  ]
}

# For //compass/browser/android: the natives of the Java bridges.
generate_jni("jni_headers") {
  sources = [
    "java/src/it/cipi1965/compass/spaces/SpacesBridge.java",
    "java/src/it/cipi1965/compass/sync/SyncBridge.java",
  ]
}

android_library("java") {
  sources = [
    "java/src/it/cipi1965/compass/CompassShellHookImpl.java",
    "java/src/it/cipi1965/compass/extras/CompassIntents.java",
    "java/src/it/cipi1965/compass/extras/NewTabTileService.java",
    "java/src/it/cipi1965/compass/extras/PinShareActivity.java",
    "java/src/it/cipi1965/compass/extras/SearchWidgetProvider.java",
    "java/src/it/cipi1965/compass/shell/CompassBar.java",
    "java/src/it/cipi1965/compass/shell/CompassBarState.kt",
    "java/src/it/cipi1965/compass/shell/CompassBarUi.kt",
    "java/src/it/cipi1965/compass/shell/CommandBar.java",
    "java/src/it/cipi1965/compass/shell/CommandBarState.kt",
    "java/src/it/cipi1965/compass/shell/CommandBarUi.kt",
    "java/src/it/cipi1965/compass/shell/SidebarState.kt",
    "java/src/it/cipi1965/compass/shell/SidebarUi.kt",
    "java/src/it/cipi1965/compass/shell/Spaces.java",
    "java/src/it/cipi1965/compass/shell/SyncScreen.java",
    "java/src/it/cipi1965/compass/shell/SyncScreenState.kt",
    "java/src/it/cipi1965/compass/shell/SyncScreenUi.kt",
    "java/src/it/cipi1965/compass/spaces/SpacesBridge.java",
    "java/src/it/cipi1965/compass/sync/SyncBridge.java",
  ]
  deps = [
    ":hook_java",
    "//base:base_java",
    "//build/android:build_java",
    "//chrome/android:chrome_java",
    "//chrome/browser/browser_controls/android:java",
    "//chrome/browser/tab:java",
    "//chrome/browser/tabmodel:java",
    "//chrome/browser/preferences:java",
    "//chrome/browser/profiles/android:java",
    "//chrome/browser/ui/android/appmenu:java",
    "//chrome/browser/ui/android/layouts:java",
    "//chrome/browser/ui/android/omnibox:java",
    "//components/omnibox/browser:browser_java",
    "//components/prefs/android:java",
    "//components/user_prefs/android:java",
    "//content/public/android:content_java",
    "//third_party/androidx:androidx_activity_activity_compose_java",
    "//third_party/androidx:androidx_activity_activity_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/androidx:androidx_compose_foundation_foundation_java",
    "//third_party/androidx:androidx_compose_foundation_foundation_layout_java",
    "//third_party/androidx:androidx_compose_material3_material3_java",
    "//third_party/androidx:androidx_compose_runtime_runtime_java",
    "//third_party/androidx:androidx_compose_ui_ui_graphics_java",
    "//third_party/androidx:androidx_compose_ui_ui_java",
    "//third_party/androidx:androidx_compose_ui_ui_text_java",
    "//third_party/androidx:androidx_compose_ui_ui_unit_java",
    "//third_party/androidx:androidx_coordinatorlayout_coordinatorlayout_java",
    "//third_party/androidx:androidx_core_core_java",
    "//third_party/androidx:androidx_lifecycle_lifecycle_common_java",
    "//third_party/androidx:androidx_lifecycle_lifecycle_runtime_java",
    "//third_party/androidx:androidx_savedstate_savedstate_java",
    "//third_party/jni_zero:jni_zero_java",
    "//third_party/kotlin_stdlib:kotlin_stdlib_java",
    "//ui/android:ui_no_recycler_view_java",
    "//url:gurl_java",
  ]
  srcjar_deps = [ ":jni_headers" ]
  enable_compose = true
}

# Compass's launcher icon in place of Chromium's (ic_launcher in
# //chrome/android:chrome_base_module_resources): an adaptive icon from
# assets/compass_glyph.svg.
android_resources("icon_resources") {
  sources = [
    "res/drawable/compass_icon_background.xml",
    "res/drawable/compass_icon_foreground.xml",
    "res/drawable/compass_icon_monochrome.xml",
    "res/drawable/ic_launcher.xml",
    "res/drawable/ic_launcher_round.xml",
  ]
  resource_overlay = true
  deps = [ "//chrome/android:chrome_base_module_resources" ]
}

# The extras' resources (the search widget).
android_resources("extras_resources") {
  sources = [
    "res_extras/drawable/compass_widget_background.xml",
    "res_extras/layout/compass_search_widget.xml",
    "res_extras/xml/compass_search_widget.xml",
  ]
  deps = [ ":icon_resources" ]
}

chrome_public_apk_or_module_tmpl("compass_apk") {
  target_type = "android_apk"
  apk_name = "Compass"
  manifest_package = "it.cipi1965.compass"
  jinja_input = "//compass/android/AndroidManifest.xml"
  deps = [
    ":extras_resources",
    ":icon_resources",
    ":java",
  ]
}
