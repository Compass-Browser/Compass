# Compass for Android (docs/design/android.md): Chrome's browser with
# Compass's own shell, in Kotlin and Jetpack Compose.

import("//build/config/android/rules.gni")
import("//extensions/buildflags/buildflags.gni")

# The shell's extensions sheet uses upstream's desktop-Android extensions UI
# classes (docs/design/android.md, "Extensions").
assert(enable_extensions_core,
       "Compass for Android builds with is_desktop_android (config/args/android.gn)")
import("//third_party/jni_zero/jni_zero.gni")
import("//chrome/android/chrome_public_apk_tmpl.gni")

# What ChromeTabbedActivity calls once its UI is up. chrome_java depends on it
# (patches/chrome-android-BUILD.gn.patch); the implementation is in :java and
# only the Compass app has it, so chrome_public_apk runs without a shell.
android_library("hook_java") {
  sources = [
    "java/src/it/cipi1965/compass/CompassShell.java",
    "java/src/it/cipi1965/compass/CompassShellHook.java",
  ]
  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//chrome/browser/browser_controls/android:java",
    "//chrome/browser/tab:java",
    "//chrome/browser/ui/android/native_page:java",
  ]
}

# For //compass/browser/android: the natives of the Java bridges.
generate_jni("jni_headers") {
  sources = [
    "java/src/it/cipi1965/compass/spaces/SpacesBridge.java",
    "java/src/it/cipi1965/compass/sync/SyncBridge.java",
    "java/src/it/cipi1965/compass/claude/ClaudeBridge.java",
    "java/src/it/cipi1965/compass/autofill/PasswordsBridge.java",
