# Compass's launcher icon in place of Chromium's (ic_launcher in
# //chrome/android:chrome_base_module_resources): an adaptive icon from
# assets/compass_glyph.svg.
android_resources("icon_resources") {
  sources = [
    "res/drawable/compass_icon_background.xml",
    "res/drawable/compass_icon_foreground.xml",
    "res/drawable/compass_icon_monochrome.xml",
    "res/drawable/ic_launcher.xml",
    "res/drawable/ic_launcher_round.xml",
  ]
  resource_overlay = true
  deps = [ "//chrome/android:chrome_base_module_resources" ]
}

