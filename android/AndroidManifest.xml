   found in the LICENSE file.

   Chrome's manifest, as Compass, with Compass's extras
   (it.cipi1965.compass.extras): a Quick Settings tile, search, quick
   actions and Today widgets, and a "Pin to Compass" share target; and its passwords in other apps
   (it.cipi1965.compass.autofill). #}

{% block application_label %}Compass{% endblock %}

{% block extra_application_definitions %}
        <service android:name="it.cipi1965.compass.extras.NewTabTileService"
            android:exported="true"
            android:icon="@drawable/compass_icon_monochrome"
            android:label="New tab"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver android:name="it.cipi1965.compass.extras.SearchWidgetProvider"
            android:exported="false"
            android:label="Compass search">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/compass_search_widget" />
        </receiver>
        <receiver android:name="it.cipi1965.compass.extras.QuickActionsWidgetProvider"
            android:exported="false"
            android:label="Compass quick actions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/compass_actions_widget" />
        </receiver>
        <receiver android:name="it.cipi1965.compass.extras.TodayWidgetProvider"
            android:exported="false"
            android:label="Compass Today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/compass_today_widget" />
        </receiver>
        <activity android:name="it.cipi1965.compass.extras.PinShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Pin to Compass"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name="it.cipi1965.compass.extras.PairInviteActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="compass-pair" />
            </intent-filter>
        </activity>
        <service android:name="it.cipi1965.compass.autofill.CompassAutofillService"
            android:exported="true"
            android:label="Compass"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill"
                android:resource="@xml/compass_autofill_service" />
        </service>
        <activity android:name="it.cipi1965.compass.autofill.PasswordPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Compass passwords"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
{% endblock %}
