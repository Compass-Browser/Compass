# Bergamot (Marian) for on-device page translation, built natively in place
# of upstream's CMake (README.md; docs/design/translation.md, "Bergamot").
# `:bergamot` is the engine; //compass/components/translatekit wraps it in
# the TranslateKit ABI.

if (is_mac || is_ios) {
  import("//build/config/apple/mobile_config.gni")
}
if (is_mac) {
  import("//build/config/mac/mac_sdk.gni")
}

_revision = read_file("REVISION", "trim string")
_marian_version = read_file("marian/VERSION", "trim string")
_gen = "$target_gen_dir/gen"

# What CMake would write from the *.in templates.
write_file("$_gen/marian/common/git_revision.h",
           [
             "// Generated by third_party/bergamot/BUILD.gn.",
             "#define GIT_REVISION \"" + string_replace(_revision, "\"", "") +
                 "\"",
           ])
write_file("$_gen/marian/common/project_version.h",
           [
             "// Generated by third_party/bergamot/BUILD.gn.",
             "#pragma once",
             "#define PROJECT_VERSION_FULL \"$_marian_version\"",
             "#define PROJECT_VERSION \"$_marian_version\"",
           ])
write_file("$_gen/marian/common/build_info.cpp",
           [
             "// Generated by third_party/bergamot/BUILD.gn.",
             "#include \"common/build_info.h\"",
             "std::string marian::cmakeBuildOptions() { return \"\"; }",
             "std::string marian::cmakeBuildOptionsAdvanced() { return \"\"; }",
           ])

# Clang builds every intgemm path; the right one is picked at run time.
write_file("$_gen/intgemm/intgemm/intgemm_config.h",
           [
             "// Generated by third_party/bergamot/BUILD.gn.",
             "#pragma once",
             "#define INTGEMM_COMPILER_SUPPORTS_AVX2",
             "#define INTGEMM_COMPILER_SUPPORTS_AVX512BW",
             "#define INTGEMM_COMPILER_SUPPORTS_AVX512VNNI",
           ])

_is_arm = current_cpu == "arm64"
_is_x86 = current_cpu == "x64"
_use_accelerate = is_mac || is_ios

config("bergamot_config") {
  include_dirs = [
    "marian/src",
    "marian/src/3rd_party",
    "marian/src/3rd_party/intgemm",
    "src",
    "shims",
    "ssplit/src/ssplit",
    "$_gen/marian",
    "$_gen/intgemm",
  ]
  defines = [
    "COMPILE_CPU=1",
    "USE_SENTENCEPIECE",
    "USE_PTHREADS",

    # As Firefox's build: no training, faiss, LSH, gzip input.
    "WASM_COMPATIBLE_SOURCE",
  ]
  if (_is_arm) {
    # ruy for the int8 models; simd_utils maps Marian's SSE code to NEON.
    defines += [
      "ARM",
      "FMA",
      "SSE",
    ]
  }
  if (_is_x86) {
    defines += [
      "USE_INTGEMM=1",
      "USE_SSE2",
    ]
  }
  if (_use_accelerate) {
    defines += [ "BLAS_FOUND=1" ]
  } else if (_is_arm) {
    defines += [ "USE_RUY_SGEMM=1" ]
  } else {
    defines += [ "USE_ONNX_SGEMM=1" ]
  }
}

# Third-party code that isn't warning-clean under Chromium's flags.
config("bergamot_warnings") {
  cflags = []
  if (is_clang) {
    cflags += [
      "-Wno-c++11-narrowing",
      "-Wno-c99-designator",
      "-Wno-deprecated-builtins",
      "-Wno-deprecated-copy",
      "-Wno-deprecated-literal-operator",
      "-Wno-deprecated-declarations",
      "-Wno-deprecated-this-capture",
      "-Wno-delete-non-abstract-non-virtual-dtor",
      "-Wno-exit-time-destructors",
      "-Wno-global-constructors",
      "-Wno-extra-semi",
      "-Wno-implicit-fallthrough",
      "-Wno-implicit-int-float-conversion",
      "-Wno-inconsistent-missing-override",
      "-Wno-invalid-offsetof",
      "-Wno-missing-braces",
      "-Wno-missing-field-initializers",
      "-Wno-pessimizing-move",
      "-Wno-range-loop-construct",
      "-Wno-redundant-move",
      "-Wno-reorder-ctor",
      "-Wno-self-assign",
      "-Wno-shadow",
      "-Wno-shorten-64-to-32",
      "-Wno-sign-compare",
      "-Wno-string-concatenation",
      "-Wno-string-plus-int",
      "-Wno-unused-but-set-variable",
      "-Wno-unused-function",
      "-Wno-unused-lambda-capture",
      "-Wno-unused-local-typedef",
      "-Wno-unused-private-field",
      "-Wno-unused-result",
      "-Wno-unused-value",
      "-Wno-unused-variable",
      "-Wno-vla-cxx-extension",
      "-Wno-unreachable-code",
      "-Wno-unreachable-code-return",
      "-Wno-unreachable-code-break",
      "-Wno-ignored-qualifiers",
      "-Wno-macro-redefined",
      "-Wno-mismatched-tags",
      "-Wno-unknown-pragmas",
      "-Wno-unused-parameter",

      # Vendored code doesn't follow Chromium's buffer rules
      # (build/config/unsafe_buffers_paths.txt exempts //third_party, not
      # //compass/third_party).
      "-Wno-unsafe-buffer-usage",
      "-Wno-unsafe-buffer-usage-in-libc-call",
    ]
  }
  if (_is_arm && !is_win) {
    cflags += [ "-flax-vector-conversions" ]
  }
}

# Marian reports errors by throwing; translatekit catches them at the ABI.
# yaml-cpp needs RTTI.
_engine_configs_remove = [
  "//build/config/compiler:chromium_code",
  "//build/config/compiler:no_exceptions",
  "//build/config/compiler:no_rtti",
]
_engine_configs_add = [
  "//build/config/compiler:no_chromium_code",
  "//build/config/compiler:exceptions",
  "//build/config/compiler:rtti",
  ":bergamot_config",
  ":bergamot_warnings",
]

# PCRE2, for ssplit's sentence-splitting rules. No JIT.
copy("pcre2_config_h") {
  sources = [ "pcre2/src/config.h.generic" ]
  outputs = [ "$_gen/pcre2/config.h" ]
}

copy("pcre2_h") {
  sources = [ "pcre2/src/pcre2.h.generic" ]
  outputs = [ "$_gen/pcre2/pcre2.h" ]
}

copy("pcre2_chartables") {
  sources = [ "pcre2/src/pcre2_chartables.c.dist" ]
  outputs = [ "$_gen/pcre2/pcre2_chartables.c" ]
}

config("pcre2_config") {
  include_dirs = [ "$_gen/pcre2" ]
  defines = [ "PCRE2_STATIC" ]
}

source_set("pcre2") {
  visibility = [ ":*" ]
  sources = [
    "$_gen/pcre2/pcre2_chartables.c",
    "pcre2/src/pcre2_auto_possess.c",
    "pcre2/src/pcre2_chkdint.c",
    "pcre2/src/pcre2_compile.c",
    "pcre2/src/pcre2_compile_cgroup.c",
    "pcre2/src/pcre2_compile_class.c",
    "pcre2/src/pcre2_config.c",
    "pcre2/src/pcre2_context.c",
    "pcre2/src/pcre2_convert.c",
    "pcre2/src/pcre2_dfa_match.c",
    "pcre2/src/pcre2_error.c",
    "pcre2/src/pcre2_extuni.c",
    "pcre2/src/pcre2_find_bracket.c",
    "pcre2/src/pcre2_jit_compile.c",
    "pcre2/src/pcre2_maketables.c",
    "pcre2/src/pcre2_match.c",
    "pcre2/src/pcre2_match_data.c",
    "pcre2/src/pcre2_match_next.c",
    "pcre2/src/pcre2_newline.c",
    "pcre2/src/pcre2_ord2utf.c",
    "pcre2/src/pcre2_pattern_info.c",
    "pcre2/src/pcre2_script_run.c",
    "pcre2/src/pcre2_serialize.c",
    "pcre2/src/pcre2_string_utils.c",
    "pcre2/src/pcre2_study.c",
    "pcre2/src/pcre2_substitute.c",
    "pcre2/src/pcre2_substring.c",
    "pcre2/src/pcre2_tables.c",
    "pcre2/src/pcre2_ucd.c",
    "pcre2/src/pcre2_valid_utf.c",
    "pcre2/src/pcre2_xclass.c",
  ]
  defines = [
    "HAVE_CONFIG_H",
    "PCRE2_CODE_UNIT_WIDTH=8",
    "SUPPORT_UNICODE",
    "HAVE_STDINT_H",
    "HAVE_INTTYPES_H",
    "HAVE_STDLIB_H",
    "HAVE_STRING_H",
    "HAVE_LIMITS_H",
    "HAVE_ASSERT_H",
  ]
  include_dirs = [ "pcre2/src" ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    ":bergamot_warnings",
  ]
  public_configs = [ ":pcre2_config" ]
  deps = [
    ":pcre2_chartables",
    ":pcre2_config_h",
    ":pcre2_h",
  ]
}

if (_is_x86) {
  # intgemm: every path in one file, each behind a target attribute.
  source_set("intgemm") {
    visibility = [ ":*" ]
    sources = [ "marian/src/3rd_party/intgemm/intgemm/intgemm.cc" ]
    configs -= _engine_configs_remove
    configs += _engine_configs_add
  }
}

if (_is_x86 && !_use_accelerate) {
  # Marian's float GEMM without a BLAS.
  source_set("onnx_sgemm") {
    visibility = [ ":*" ]
    sources = [ "marian/src/3rd_party/onnxjs/src/wasm-ops/gemm.cpp" ]
    configs -= _engine_configs_remove
    configs += _engine_configs_add
    configs += [ "//third_party/eigen3:eigen_includes" ]
  }
}

