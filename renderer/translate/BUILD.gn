  sources = [
    "page_translator_bindings.cc",
    "page_translator_bindings.h",
  ]
  deps = [
    "//base",
    "//chrome/common",
    "//compass/common/translate:mojom",
    "//content/public/renderer",
    "//gin",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
    "//v8",
  ]
}
